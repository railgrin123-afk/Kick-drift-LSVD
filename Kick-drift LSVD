function F = randpot1d_getFFT(c)
    f = fft(ifftshift(c(:).'));
    F = complex(sqrt(abs(f)),0);
end

function u = randpot1d_four(cf)
    n = numel(cf);
    if n < 4, u = zeros(n,1); return; end
    p = (2*rand(1, floor(n/2)-1) - 1)*pi;
    phase = zeros(1,n);
    lo = 2:(n/2);
    hi = (n/2+2):n;
    if ~isempty(lo), phase(lo) = p; end
    if ~isempty(hi), phase(hi) = fliplr(p); end
    cff = cf(:).' .* exp(1i*phase);
    cff(1) = 0;
    u = sqrt(n)*ifft(cff); u = real(u);
    s = std(u); if s<1e-12, s=1e-12; end
    u = (u/s).'; u = u(:);
end

function Rp = InverseKick_vert(coords, args)
    dp_x = args.dp_x(:); n = numel(dp_x);
    y = coords(:,1); x = coords(:,2);

    x0 = floor(x); i0 = mod(x0, n); i1 = mod(i0+1, n);
    fx = x - x0;
    dpy = dp_x(i0+1) + (dp_x(i1+1)-dp_x(i0+1)).*fx;

    Rp = coords;
    Rp(:,1) = y - dpy;
end

function Rp = InverseFullStep(coords, args)
    dp_x = args.dp_x(:); n = numel(dp_x);
    row0 = args.row0; Tau = args.Tau;

    y1 = coords(:,1);
    x1 = coords(:,2);

    x  = x1 - Tau*(y1 - row0);

    x0 = floor(x); i0 = mod(x0,n); i1 = mod(i0+1,n);
    fx = x - x0;
    dpy = dp_x(i0+1) + (dp_x(i1+1)-dp_x(i0+1)).*fx;

    y  = y1 - dpy;

    Rp = [y, x];
end

function Rp = ForwardFullStep(coords, args)
    dp_x = args.dp_x(:); n = numel(dp_x);
    row0 = args.row0; Tau = args.Tau;

    y = coords(:,1);
    x = coords(:,2);

    x0 = floor(x); i0 = mod(x0,n); i1 = mod(i0+1,n);
    fx = x - x0;
    dpy = dp_x(i0+1) + (dp_x(i1+1)-dp_x(i0+1)).*fx;

    y1 = y + dpy;
    x1 = x + Tau*(y1 - row0);

    Rp = [y1, x1];
end

function out = warp_image(image, map_func, map_args)
    [rows, cols, ch] = size(image);
    img = im2double(image);

    [cc, rr] = meshgrid(0:cols-1, 0:rows-1);
    coords = [rr(:), cc(:)];
    mapped = feval(map_func, coords, map_args);

    ys = mod(mapped(:,1), rows);
    xs = mod(mapped(:,2), cols);

    y0=floor(ys); x0=floor(xs);
    y1=mod(y0+1,rows); x1=mod(x0+1,cols);
    fy=ys-y0; fx=xs-x0;

    y0p=y0+1; y1p=y1+1; x0p=x0+1; x1p=x1+1;
    idx00=sub2ind([rows,cols],y0p,x0p);
    idx01=sub2ind([rows,cols],y0p,x1p);
    idx10=sub2ind([rows,cols],y1p,x0p);
    idx11=sub2ind([rows,cols],y1p,x1p);

    w00=(1-fy).*(1-fx); w01=(1-fy).*fx; w10=fy.*(1-fx); w11=fy.*fx;

    out = zeros(rows,cols,ch);
    for k=1:ch
        P=img(:,:,k);
        v=w00.*P(idx00)+w01.*P(idx01)+w10.*P(idx10)+w11.*P(idx11);
        out(:,:,k)=reshape(v,rows,cols);
    end
end

% ------------------- LOW-STRETCH DOTS (your robust voting version) -------------------
function [xyLow, xyHigh, stats] = Smap_dots_snapshot(dp_x_hist, row0, Tau, P, H, W)

Nwin = min(P.Nwin, numel(dp_x_hist));
T = numel(dp_x_hist);
if T < 1 || Nwin < 1
    xyLow = zeros(0,2); xyHigh = zeros(0,2);
    stats = struct('n_low',0,'n_high',0,'passes',0);
    return;
end

span = max(0, T - Nwin);
V = min(P.VOTE_T0, span+1);
if V <= 1
    t0_list = span;
else
    t0_list = unique(round(linspace(max(0, span-(V-1)), span, V)));
end

pitch_y = P.PITCH_YX(1);
pitch_x = P.PITCH_YX(2);

ys = floor(pitch_y/2) : pitch_y : (H-1);
xs = floor(pitch_x/2) : pitch_x : (W-1);
[Xg, Yg] = meshgrid(xs, ys);
probes = [Yg(:), Xg(:)];              % [y,x] zero-based

OFFS = [0 0; 0 0.5; 0 -0.5; 0.5 0; -0.5 0];

low_votes = zeros(H,W);
high_votes = zeros(H,W);
total_passes = 0;

REQUIRE_4_OF_5 = numel(t0_list) > 1;
agree_needed   = REQUIRE_4_OF_5*4 + (~REQUIRE_4_OF_5)*3;

for t0 = t0_list
    total_passes = total_passes + 1;

    nP = size(probes,1);
    jy = (2*rand(nP,1)-1) * P.JITTER_FR * pitch_y;
    jx = (2*rand(nP,1)-1) * P.JITTER_FR * pitch_x;
    Pj  = probes + [jy jx];
    Pj(:,1) = mod(Pj(:,1), H);
    Pj(:,2) = mod(Pj(:,2), W);

    pass_low  = false(H,W);
    pass_high = false(H,W);

    for j=1:size(Pj,1)
        y0 = Pj(j,1); x0 = Pj(j,2);

        [M0_raw, xyN0w] = kd_dyn_vert('monodromy_with_final', y0, x0, t0, Nwin, dp_x_hist, Tau, H, W, row0, 1e-3, true);
        xN0 = xyN0w(1); yN0 = xyN0w(2);

        [M0, det0_raw] = kd_dyn_vert('symplectify2x2', M0_raw, 5e-3);
        if isempty(M0), continue; end
        if ~isfinite(det0_raw) || abs(det0_raw-1) > P.DET_TOL, continue; end

        S0 = monodromy_to_Smax(M0);

        agree_low = 0;
        agree_high = 0;

        for ii=1:size(OFFS,1)
            dy=OFFS(ii,1); dx=OFFS(ii,2);
            yy = mod(y0 + dy*pitch_y, H);
            xx = mod(x0 + dx*pitch_x, W);

            if dy==0 && dx==0
                Si = S0;
            else
                [M_raw, ~] = kd_dyn_vert('monodromy_with_final', yy, xx, t0, Nwin, dp_x_hist, Tau, H, W, row0, 1e-3, true);
                [M_sym, det_raw] = kd_dyn_vert('symplectify2x2', M_raw, 5e-3);
                if isempty(M_sym) || ~isfinite(det_raw) || abs(det_raw-1) > P.DET_TOL
                    Si = NaN;
                else
                    Si = monodromy_to_Smax(M_sym);
                end
            end

            if isfinite(Si)
                if Si <= P.S_THR, agree_low = agree_low + 1; else, agree_high = agree_high + 1; end
            end
        end

        center_is_low = (S0 <= P.S_THR);

        if P.DEPOSIT_AT_FINAL
            y_dep = yN0; x_dep = xN0;
        else
            y_dep = y0;  x_dep = x0;
        end
        iy = mod(floor(y_dep), H) + 1;
        ix = mod(floor(x_dep), W) + 1;

        if (agree_low >= agree_needed) && (~P.CENTER_MUST_BE_GOOD || center_is_low)
            pass_low(iy, ix) = true;
        end
        if (agree_high >= agree_needed) && (~P.CENTER_MUST_BE_GOOD || ~center_is_low)
            pass_high(iy, ix) = true;
        end
    end

    low_votes  = low_votes  + double(pass_low);
    high_votes = high_votes + double(pass_high);
end

low_density  = low_votes  / max(1,total_passes);
high_density = high_votes / max(1,total_passes);

keep_low  = (low_density  >= P.KEEP_FRAC);
keep_high = (high_density >= P.KEEP_FRAC);

[iyL, ixL] = find(keep_low);
[iyH, ixH] = find(keep_high);

xyLow  = [ixL, iyL];   % [x y]
xyHigh = [ixH, iyH];

stats = struct('n_low',size(xyLow,1), 'n_high',size(xyHigh,1), 'passes',total_passes);
end

% ------------------- S magnitude field vs start (this is the "contour plot") -------------------
function [Sfine, maskFine, Sfine_final, maskFine_final, Rotfine, Rotfine_final, Trfine, Trfine_final] = Sfield_snapshot(dp_x_hist, row0, Tau, H, W, t0, Nwin, P)
% Computes scalar fields S(x0,y0), rotation θ(x0,y0), and trace(M) on a
% coarse grid, smooths them, then interpolates to full resolution.
%
% Returns:
%   Sfine, maskFine             — S values at STARTING locations
%   Sfine_final, maskFine_final — S values remapped to FINAL (current) locations
%   Rotfine, Rotfine_final      — rotation angle (radians) at start/final locations
%   Trfine,  Trfine_final       — trace(M) at start/final locations
%                                 |trace|<2 = elliptic (rotating, stable)
%                                 |trace|>2 = hyperbolic (saddle, stretching)

step = P.FIELD_STEP;
ys = 1:step:H;   % 1-based for plotting
xs = 1:step:W;

Scoarse = nan(numel(ys), numel(xs));
Rotcoarse = nan(numel(ys), numel(xs));
Trcoarse = nan(numel(ys), numel(xs));
maskC   = false(numel(ys), numel(xs));

% Store final positions for each coarse grid point
finalY_coarse = nan(numel(ys), numel(xs));
finalX_coarse = nan(numel(ys), numel(xs));

for iy = 1:numel(ys)
    for ix = 1:numel(xs)
        y0 = double(ys(iy) - 1);  % dynamics uses 0-based
        x0 = double(xs(ix) - 1);

        [M_raw, xyNw] = kd_dyn_vert('monodromy_with_final', y0, x0, t0, Nwin, dp_x_hist, Tau, H, W, row0, 1e-3, true);
        [M_sym, det_raw] = kd_dyn_vert('symplectify2x2', M_raw, 5e-3);

        if isempty(M_sym) || ~isfinite(det_raw) || abs(det_raw-1) > P.DET_TOL
            continue;
        end

        Scoarse(iy,ix) = monodromy_to_Smax(M_sym);
        Rotcoarse(iy,ix) = monodromy_to_rotation(M_sym);
        Trcoarse(iy,ix) = M_sym(1,1) + M_sym(2,2);
        maskC(iy,ix)   = true;

        % Store final (current) positions (0-based -> 1-based for plotting)
        finalX_coarse(iy,ix) = mod(xyNw(1), W) + 1;
        finalY_coarse(iy,ix) = mod(xyNw(2), H) + 1;
    end
end

% ---- START-location S, rotation, and trace fields ----
% Smooth with NaN-aware Gaussian (prevents ugly pixel blocks)
Ssm = smooth2_gaussian_nan(Scoarse, maskC, P.FIELD_SMOOTH_SIG);
Rotsm = smooth2_gaussian_nan(Rotcoarse, maskC, P.FIELD_SMOOTH_SIG);
Trsm = smooth2_gaussian_nan(Trcoarse, maskC, P.FIELD_SMOOTH_SIG);

% Interpolate to full image resolution
[Xc, Yc] = meshgrid(xs, ys);
[Xf, Yf] = meshgrid(1:W, 1:H);

Sfine = interp2(Xc, Yc, Ssm, Xf, Yf, 'linear', NaN);
Rotfine = interp2(Xc, Yc, Rotsm, Xf, Yf, 'linear', NaN);
Trfine = interp2(Xc, Yc, Trsm, Xf, Yf, 'linear', NaN);
maskFine = isfinite(Sfine);

% Clip for display (magnitude still correct, just not blown out visually)
% REMOVED: Sfine(Sfine < 1) = 1;
% REMOVED: Sfine(Sfine > P.S_CLIP_MAX) = P.S_CLIP_MAX;

% ---- FINAL-location fields (scattered interpolation) ----
% Each coarse probe started at (xs(ix), ys(iy)) and ended at
% (finalX, finalY).  We have S, rotation, and trace at each probe.
% Now we want them on a regular grid indexed by FINAL (current) coords.

validC = maskC & isfinite(Scoarse) & isfinite(Rotcoarse) & isfinite(Trcoarse);
Svals  = Scoarse(validC);
Rotvals = Rotcoarse(validC);
Trvals  = Trcoarse(validC);
fxVals = finalX_coarse(validC);   % 1-based x of final position
fyVals = finalY_coarse(validC);   % 1-based y of final position

if numel(Svals) >= 4
    % Use scatteredInterpolant for smooth coverage of the full grid
    F_S_interp = scatteredInterpolant(fxVals(:), fyVals(:), Svals(:), 'natural', 'nearest');
    F_Rot_interp = scatteredInterpolant(fxVals(:), fyVals(:), Rotvals(:), 'natural', 'nearest');
    F_Tr_interp  = scatteredInterpolant(fxVals(:), fyVals(:), Trvals(:),  'natural', 'nearest');

    [Xf, Yf] = meshgrid(1:W, 1:H);
    Sfine_final = F_S_interp(Xf, Yf);
    Rotfine_final = F_Rot_interp(Xf, Yf);
    Trfine_final  = F_Tr_interp(Xf, Yf);

    % Smooth lightly to remove interpolation noise
    maskF_raw = isfinite(Sfine_final);
    Sfine_final = smooth2_gaussian_nan(Sfine_final, maskF_raw, P.FIELD_SMOOTH_SIG);
    Rotfine_final = smooth2_gaussian_nan(Rotfine_final, maskF_raw, P.FIELD_SMOOTH_SIG);
    Trfine_final  = smooth2_gaussian_nan(Trfine_final,  maskF_raw, P.FIELD_SMOOTH_SIG);
    maskFine_final = isfinite(Sfine_final);

    % Clip for display (REMOVED to preserve full data range)
    % REMOVED: Sfine_final(Sfine_final < 1) = 1;
    % REMOVED: Sfine_final(Sfine_final > P.S_CLIP_MAX) = P.S_CLIP_MAX;
else
    Sfine_final = nan(H, W);
    Rotfine_final = nan(H, W);
    Trfine_final  = nan(H, W);
    maskFine_final = false(H, W);
end
end

function Sout = smooth2_gaussian_nan(Sin, mask, sigma_cells)
% NaN-aware Gaussian smoothing using conv2 (no toolboxes required).
if sigma_cells <= 0
    Sout = Sin; return;
end

% build 1D gaussian kernel
rad = max(1, ceil(3*sigma_cells));
x = (-rad:rad);
g = exp(-(x.^2)/(2*sigma_cells^2));
g = g / sum(g);

Sin0 = Sin; Sin0(~mask) = 0;
W0   = double(mask);

% separable convolution
num = conv2(conv2(Sin0, g, 'same'), g', 'same');
den = conv2(conv2(W0,   g, 'same'), g', 'same');

Sout = num ./ max(den, 1e-12);
Sout(den < 0.15) = NaN;  % if we had almost no data support, keep it NaN
end

function Smax = monodromy_to_Smax(M)
[~,Sig,~] = svd(M);
Smax = Sig(1,1);
end

function theta = monodromy_to_rotation(M)
% Extract rotation angle (local angular momentum) from 2x2 symplectic matrix.
% Uses atan2 of off-diagonal vs diagonal trace to get rotation in radians.
% Positive = counterclockwise rotation; negative = clockwise.
theta = atan2(M(2,1) - M(1,2), M(1,1) + M(2,2));
end


% --------- Dynamics / FD monodromy backend (vertical-kick) ---------
function varargout = kd_dyn_vert(func, varargin)
switch lower(func)
    case 'symplectify2x2'
        [varargout{1}, varargout{2}] = symplectify2x2(varargin{:});
    case 'monodromy_with_final'
        [varargout{1}, varargout{2}] = monodromy_with_final_vert(varargin{:});
    otherwise
        error('kd_dyn_vert:unknown', 'Unknown command "%s".', func);
end
end

function [M_sym, det_raw] = symplectify2x2(M, det_tol)
if nargin<2, det_tol=5e-3; end
det_raw = det(M);
if ~isfinite(det_raw) || det_raw <= 0.0
    M_sym = [];
    return;
end
if abs(det_raw - 1.0) <= det_tol
    M_sym = M;
else
    M_sym = M ./ sqrt(det_raw);
end
end

function dpy = interp_kick_x(x, dp_x)
n = numel(dp_x);
x0=floor(x); i0=mod(x0,n); i1=mod(i0+1,n);
fx=x-x0;
dpy = dp_x(i0+1) + (dp_x(i1+1)-dp_x(i0+1))*fx;
end

function [M, xyNw] = monodromy_N_fd_3_central_vert(x0, y0, t0, N, dp_hist, Tau, row0, cols, rows, eps_, symplectify_if, det_tol)
if nargin<10 || isempty(eps_),           eps_ = 1e-3; end
if nargin<11 || isempty(symplectify_if), symplectify_if = true; end
if nargin<12 || isempty(det_tol),        det_tol = 5e-3; end

T = numel(dp_hist);

x = double(x0); y = double(y0);
for k = 0:(floor(N)-1)
    dp = dp_hist{mod(t0 + k, T) + 1};
    Yc = y + interp_kick_x(x, dp);
    Xc = x + Tau*(Yc - row0);
    x = Xc; y = Yc;
end
xN0w = mod(x, cols); yN0w = mod(y, rows);

x = double(x0) + eps_; y = double(y0);
for k = 0:(floor(N)-1)
    dp = dp_hist{mod(t0 + k, T) + 1};
    Yc = y + interp_kick_x(x, dp);
    Xc = x + Tau*(Yc - row0);
    x = Xc; y = Yc;
end
xNxp = x; yNxp = y;

x = double(x0) - eps_; y = double(y0);
for k = 0:(floor(N)-1)
    dp = dp_hist{mod(t0 + k, T) + 1};
    Yc = y + interp_kick_x(x, dp);
    Xc = x + Tau*(Yc - row0);
    x = Xc; y = Yc;
end
xNxm = x; yNxm = y;

x = double(x0); y = double(y0) + eps_;
for k = 0:(floor(N)-1)
    dp = dp_hist{mod(t0 + k, T) + 1};
    Yc = y + interp_kick_x(x, dp);
    Xc = x + Tau*(Yc - row0);
    x = Xc; y = Yc;
end
xNyp = x; yNyp = y;

x = double(x0); y = double(y0) - eps_;
for k = 0:(floor(N)-1)
    dp = dp_hist{mod(t0 + k, T) + 1};
    Yc = y + interp_kick_x(x, dp);
    Xc = x + Tau*(Yc - row0);
    x = Xc; y = Yc;
end
xNym = x; yNym = y;

col1 = [(xNxp - xNxm)/(2*eps_) ; (yNxp - yNxm)/(2*eps_)];
col2 = [(xNyp - xNym)/(2*eps_) ; (yNyp - yNym)/(2*eps_)];
M    = [col1, col2];

if symplectify_if
    detM = det(M);
    if ~isfinite(detM) || detM <= 0.0
        xyNw = [xN0w, yN0w];
        return;
    end
    if abs(detM - 1.0) > det_tol
        M = M ./ sqrt(detM);
    end
end

xyNw = [xN0w, yN0w];
end

function [M, xyNw] = monodromy_with_final_vert(y0, x0, t0, N, dp_hist, Tau, rows, cols, row0, eps_, use_fd)
if nargin<10, eps_=1e-3; end
if nargin<11, use_fd=true; end
if use_fd
    [M, xyNw] = monodromy_N_fd_3_central_vert(x0, y0, t0, N, dp_hist, Tau, row0, cols, rows, eps_, true);
else
    error('This version uses FD monodromy. Set use_fd=true.');
end
end

function [nBlobs, areas] = blob_stats_any(BW, conn)
% Returns number of connected components + their pixel areas.
% Uses bwconncomp if available; otherwise falls back to a no-toolbox BFS.

BW = logical(BW);
if nargin<2, conn = 4; end

if exist('bwconncomp','file') == 2
    CC = bwconncomp(BW, conn);
    nBlobs = CC.NumObjects;
    areas  = cellfun(@numel, CC.PixelIdxList);
else
    [nBlobs, areas] = blob_stats_nontoolbox(BW, conn);
end
end

function [nBlobs, areas] = blob_stats_nontoolbox(BW, conn)
% Simple BFS connected-components (no toolboxes).
[H,W] = size(BW);
vis = false(H,W);
areas = zeros(0,1);
nBlobs = 0;

for r = 1:H
    for c = 1:W
        if ~BW(r,c) || vis(r,c), continue; end
        nBlobs = nBlobs + 1;

        % dynamic stack of linear indices
        stack = zeros(1024,1,'uint32');
        top = 1;
        stack(top) = uint32(r + (c-1)*H);
        vis(r,c) = true;

        cnt = 0;
        while top > 0
            idx = double(stack(top)); top = top - 1;
            cnt = cnt + 1;

            rr = mod(idx-1, H) + 1;
            cc = floor((idx-1)/H) + 1;

            % 4-connected neighbors
            % up
            if rr > 1 && BW(rr-1,cc) && ~vis(rr-1,cc)
                vis(rr-1,cc) = true;
                top = top + 1; if top>numel(stack), stack(end+1024)=0; end
                stack(top) = uint32((rr-1) + (cc-1)*H);
            end
            % down
            if rr < H && BW(rr+1,cc) && ~vis(rr+1,cc)
                vis(rr+1,cc) = true;
                top = top + 1; if top>numel(stack), stack(end+1024)=0; end
                stack(top) = uint32((rr+1) + (cc-1)*H);
            end
            % left
            if cc > 1 && BW(rr,cc-1) && ~vis(rr,cc-1)
                vis(rr,cc-1) = true;
                top = top + 1; if top>numel(stack), stack(end+1024)=0; end
                stack(top) = uint32(rr + (cc-2)*H);
            end
            % right
            if cc < W && BW(rr,cc+1) && ~vis(rr,cc+1)
                vis(rr,cc+1) = true;
                top = top + 1; if top>numel(stack), stack(end+1024)=0; end
                stack(top) = uint32(rr + (cc)*H);
            end

            if conn == 8
                % diagonals
                for dr = [-1 1]
                    for dc = [-1 1]
                        r2 = rr + dr; c2 = cc + dc;
                        if r2>=1 && r2<=H && c2>=1 && c2<=W && BW(r2,c2) && ~vis(r2,c2)
                            vis(r2,c2) = true;
                            top = top + 1; if top>numel(stack), stack(end+1024)=0; end
                            stack(top) = uint32(r2 + (c2-1)*H);
                        end
                    end
                end
            end
        end

        areas(nBlobs,1) = cnt; %#ok<AGROW>
    end
end
end

function h = overlay_mask_rgb(mask, rgb, alpha)
% Overlay a solid RGB color wherever mask==true, with transparency alpha.
mask = logical(mask);
H = size(mask,1); W = size(mask,2);

rgbImg = zeros(H,W,3);
rgbImg(:,:,1) = rgb(1);
rgbImg(:,:,2) = rgb(2);
rgbImg(:,:,3) = rgb(3);

h = image(rgbImg);
set(h, 'AlphaData', alpha * double(mask));
end

%% ---- N-step scalar propagation (used by FD monodromy) ----
function [xo, yo] = propagate_N(xi, yi, t0, N, dp_hist, Tau, row0)
    T  = numel(dp_hist);
    xo = xi; yo = yi;
    for k = 0:(floor(N)-1)
        dp = dp_hist{mod(t0+k, T)+1};
        Yc = yo + interp_kick_x(xo, dp);
        Xc = xo + Tau*(Yc - row0);
        xo = Xc; yo = Yc;
    end
end

%% ---- monodromy via 5-point central-difference FD (standalone) ----
function [M, xyNw] = monodromy_fd_vert(y0, x0, t0, N, dp_hist, Tau, rows, cols, row0, eps_)
    if nargin < 10, eps_ = 1e-3; end
    [xN0,  yN0]  = propagate_N(double(x0),      double(y0),      t0,N,dp_hist,Tau,row0);
    [xNxp, yNxp] = propagate_N(double(x0)+eps_, double(y0),      t0,N,dp_hist,Tau,row0);
    [xNxm, yNxm] = propagate_N(double(x0)-eps_, double(y0),      t0,N,dp_hist,Tau,row0);
    [xNyp, yNyp] = propagate_N(double(x0),      double(y0)+eps_, t0,N,dp_hist,Tau,row0);
    [xNym, yNym] = propagate_N(double(x0),      double(y0)-eps_, t0,N,dp_hist,Tau,row0);
    col1 = [(xNxp-xNxm)/(2*eps_); (yNxp-yNxm)/(2*eps_)];
    col2 = [(xNyp-xNym)/(2*eps_); (yNyp-yNym)/(2*eps_)];
    M    = [col1, col2];
    detM = det(M);
    if isfinite(detM) && detM > 0 && abs(detM-1) > 5e-3
        M = M / sqrt(detM);
    end
    xyNw = [mod(xN0,cols), mod(yN0,rows)];
end

%% ---- S1 field: LARGEST SINGULAR VALUE ONLY (for final blob analysis) ----
function [Sfine, maskFine] = compute_s1_field(dp_x_hist, row0, Tau, H, W, t0, Nwin, P)
    step = P.FIELD_STEP;
    ys   = 1:step:H;
    xs   = 1:step:W;
    Ny   = numel(ys);
    Nx   = numel(xs);
    s1C   = nan(Ny, Nx);
    maskC = false(Ny, Nx);

    for iy = 1:Ny
        for ix = 1:Nx
            y0d = double(ys(iy) - 1);
            x0d = double(xs(ix) - 1);
            [M_raw, ~] = monodromy_fd_vert(y0d, x0d, t0, Nwin, ...
                                           dp_x_hist, Tau, H, W, row0, 1e-3);
            [M_sym, det_raw] = symplectify2x2(M_raw, P.DET_TOL);
            if isempty(M_sym) || ~isfinite(det_raw) || abs(det_raw-1) > P.DET_TOL
                continue;
            end
            sv = svd(M_sym);
            s1C(iy,ix)   = sv(1);
            maskC(iy,ix) = true;
        end
    end

    % NaN-aware separable Gaussian smoothing
    s1S = smooth2_gaussian_nan(s1C, maskC, P.FIELD_SMOOTH_SIG);

    % Interpolate coarse grid -> full image resolution
    [Xc, Yc] = meshgrid(xs, ys);
    [Xf, Yf] = meshgrid(1:W, 1:H);
    Sfine    = interp2(Xc, Yc, s1S, Xf, Yf, 'linear', NaN);
    maskFine = isfinite(Sfine);

    % Clip display range (REMOVED to preserve full data range)
    % REMOVED: Sfine(Sfine < 1)            = 1;
    % REMOVED: Sfine(Sfine > P.S_CLIP_MAX) = P.S_CLIP_MAX;
end

%% ---- full-resolution connected components (cell of linear-index lists) ----
function kd_composite(base_img, Sf, maskF, y2bMask, xyAll, dot_cmap, cmap, P, show_y2b, win)
% Renders the standard kick-drift composite into the CURRENT axes, in the
% same layer order as figure 4000+it:
%   warped image -> translucent S-field -> S=S_THR contour -> transition
%   overlay -> banded dots.
% win = []              renders the S_THR contour over the whole field
% win = [r0 r1 c0 c1]   restricts the contour to that window.  The raster
%   layers are cheap to draw in full and the caller clips them with
%   xlim/ylim, but contour() over the full field is the expensive part, so
%   for insets we only trace it inside the visible window.
imshow(base_img, []);
axis image off;
hold on;

hS = imagesc(Sf);
set(hS, 'AlphaData', P.FIELD_ALPHA * maskF);
colormap(gca, cmap);
apply_log_S_cmap(gca, P.S_CLIP_MAX);

if isempty(win)
    contour(Sf, [P.S_THR P.S_THR], 'w', 'LineWidth', 1.1);
else
    xr = win(3):win(4);  yr = win(1):win(2);
    contour(xr, yr, Sf(yr, xr), [P.S_THR P.S_THR], 'w', 'LineWidth', 1.3);
end

if show_y2b && any(y2bMask(:))
    overlay_mask_rgb(y2bMask, [1 0 1], min(0.60, P.TRANS_ALPHA + 0.10));
end

plot_banded_dots(xyAll, Sf, dot_cmap);
hold off;
end

function [win, ok] = place_window_clear(idx_lin, H, W, winsz, placed)
% Window for the pixel set idx_lin that avoids every window in `placed`
% (each a [r0 r1 c0 c1]).  Tries the centroid first; if that overlaps, it
% re-centres on the member pixel whose window is clear AND which sits
% farthest from the already-placed window centres -- so a big sprawling
% component still gets a useful window instead of being skipped.
% ok = false means no clear placement was found; `win` is then the centroid
% window and the caller may prefer a different candidate.
win = zoom_window_from_idx(idx_lin, H, W, winsz);
ok  = ~any_window_overlap(win, placed);
if ok || isempty(placed), return; end

[ry, rx] = ind2sub([H W], double(idx_lin));

% subsample so huge components stay cheap to scan
n = numel(ry);
stride = max(1, floor(n / 2000));
ry = ry(1:stride:end);  rx = rx(1:stride:end);

% centres of the already-placed windows
pc = zeros(numel(placed), 2);
for i = 1:numel(placed)
    pc(i,:) = [mean(placed{i}(1:2)), mean(placed{i}(3:4))];
end

best = -Inf;  bestwin = win;  found = false;
for i = 1:numel(ry)
    w = zoom_window_from_idx(sub2ind([H W], ry(i), rx(i)), H, W, winsz);
    if any_window_overlap(w, placed), continue; end
    d = min(hypot(ry(i) - pc(:,1), rx(i) - pc(:,2)));
    if d > best
        best = d;  bestwin = w;  found = true;
    end
end
win = bestwin;  ok = found;
end

function tf = any_window_overlap(w, placed)
% True if window w = [r0 r1 c0 c1] intersects any window in `placed`.
tf = false;
for i = 1:numel(placed)
    p = placed{i};
    if ~(w(2) < p(1) || p(2) < w(1) || w(4) < p(3) || p(4) < w(3))
        tf = true;  return;
    end
end
end

function win = zoom_window_from_idx(idx_lin, H, W, winsz)
% Square window of side `winsz` centred on the centroid of the pixel set
% idx_lin, clamped to the image bounds. Clamping SHIFTS the window rather
% than shrinking it, so all three windows stay the same size (and therefore
% the same scale) unless the image itself is smaller than winsz.
% Returns [r0 r1 c0 c1] (inclusive, 1-based).
[ry, rx] = ind2sub([H W], double(idx_lin));   % bfs_CC returns uint32
cy = round(mean(ry));  cx = round(mean(rx));

hh = min(winsz, H);    ww = min(winsz, W);
r0 = cy - floor(hh/2); r0 = max(1, min(r0, H - hh + 1));
c0 = cx - floor(ww/2); c0 = max(1, min(c0, W - ww + 1));

win = [r0, r0 + hh - 1, c0, c0 + ww - 1];
end

function CC = get_CC_full(BW, conn)
    BW = logical(BW);
    if exist('bwconncomp','file') == 2
        C  = bwconncomp(BW, conn);
        CC = C.PixelIdxList;
    else
        CC = bfs_CC(BW, conn);
    end
end

%% ---- BFS connected components (no Image Processing Toolbox) ----
function CC = bfs_CC(BW, conn)
    [H,W] = size(BW);
    vis   = false(H,W);
    CC    = {};
    for r = 1:H
        for c = 1:W
            if ~BW(r,c) || vis(r,c), continue; end
            stack    = zeros(4096,1,'uint32');
            top      = 1;
            stack(1) = uint32(r + (c-1)*H);
            vis(r,c) = true;
            members  = zeros(0,1,'uint32');
            while top > 0
                idx = double(stack(top)); top = top-1;
                members(end+1,1) = uint32(idx); %#ok<AGROW>
                rr = mod(idx-1,H)+1;
                cc = floor((idx-1)/H)+1;
                % 4-connected neighbours
                nbrs4 = [rr-1,cc; rr+1,cc; rr,cc-1; rr,cc+1];
                ok4   = nbrs4(:,1)>=1 & nbrs4(:,1)<=H & ...
                        nbrs4(:,2)>=1 & nbrs4(:,2)<=W;
                nbrs  = nbrs4(ok4,:);
                if conn == 8
                    nbrsd = [rr-1,cc-1; rr-1,cc+1; rr+1,cc-1; rr+1,cc+1];
                    okd   = nbrsd(:,1)>=1 & nbrsd(:,1)<=H & ...
                            nbrsd(:,2)>=1 & nbrsd(:,2)<=W;
                    nbrs  = [nbrs; nbrsd(okd,:)]; %#ok<AGROW>
                end
                for ni = 1:size(nbrs,1)
                    nr=nbrs(ni,1); nc=nbrs(ni,2);
                    if BW(nr,nc) && ~vis(nr,nc)
                        vis(nr,nc) = true;
                        top = top+1;
                        if top > numel(stack), stack(end+4096) = 0; end
                        stack(top) = uint32(nr+(nc-1)*H);
                    end
                end
            end  % BFS while
            CC{end+1} = double(members); %#ok<AGROW>
        end
    end
end

%% ---- discrete perimeter (4-connected boundary pixel count) ----
function perim = compute_perimeter(BW)
    BW   = logical(BW);
    [H,W] = size(BW);
    Pad  = false(H+2, W+2);
    Pad(2:end-1, 2:end-1) = BW;
    % pixel has all 4 neighbours in foreground -> it is interior
    interior = Pad(2:end-1,2:end-1) & ...
               Pad(1:end-2,2:end-1) & ...
               Pad(3:end,  2:end-1) & ...
               Pad(2:end-1,1:end-2) & ...
               Pad(2:end-1,3:end);
    perim = nnz(BW) - nnz(interior);
end

function SVDdata = fullSVD_snapshot(dp_x_hist, row0, Tau, H, W, t0, Nwin, P)
%FULLSVD_SNAPSHOT
% Stores the full SVD of the Nwin-step monodromy M at coarse S-field grid points.
%
% For each starting location:
%     M = U * Sigma * V'
%
% Sigma(1,1) = strongest stretch = current S value
% Sigma(2,2) = weaker singular value
% V(:,1)     = starting direction that becomes most stretched
% U(:,1)     = final direction of that strongest stretch
%
% Important:
% Singular vectors have sign ambiguity: v and -v represent the same line.
% So theta values are stored modulo pi.

step = P.FIELD_STEP;

ys = 1:step:H;
xs = 1:step:W;

Ny = numel(ys);
Nx = numel(xs);

Ufield      = nan(Ny, Nx, 2, 2);
Vfield      = nan(Ny, Nx, 2, 2);
Sigma_field = nan(Ny, Nx, 2);

theta_u1 = nan(Ny, Nx);
theta_v1 = nan(Ny, Nx);

finalX = nan(Ny, Nx);
finalY = nan(Ny, Nx);

mask = false(Ny, Nx);

for iy = 1:Ny
    for ix = 1:Nx

        y0 = double(ys(iy) - 1);   % zero-based dynamics coordinate
        x0 = double(xs(ix) - 1);

        [M_raw, xyNw] = kd_dyn_vert('monodromy_with_final', ...
                                    y0, x0, t0, Nwin, ...
                                    dp_x_hist, Tau, H, W, row0, ...
                                    1e-3, true);

        [M_sym, det_raw] = kd_dyn_vert('symplectify2x2', M_raw, P.DET_TOL);

        if isempty(M_sym) || ~isfinite(det_raw) || abs(det_raw - 1) > P.DET_TOL
            continue;
        end

        [Umat, Sigmat, Vmat] = svd(M_sym);

        Ufield(iy,ix,:,:) = Umat;
        Vfield(iy,ix,:,:) = Vmat;

        Sigma_field(iy,ix,1) = Sigmat(1,1);
        Sigma_field(iy,ix,2) = Sigmat(2,2);

        % Direction angles of strongest-stretch singular vectors.
        % Coordinates are [x; y], because M maps [dx; dy] -> [dx_N; dy_N].
        theta_v1(iy,ix) = mod(atan2(Vmat(2,1), Vmat(1,1)), pi);
        theta_u1(iy,ix) = mod(atan2(Umat(2,1), Umat(1,1)), pi);

        finalX(iy,ix) = mod(xyNw(1), W) + 1;
        finalY(iy,ix) = mod(xyNw(2), H) + 1;

        mask(iy,ix) = true;
    end
end

SVDdata = struct();

SVDdata.xs = xs;
SVDdata.ys = ys;

SVDdata.t0   = t0;
SVDdata.Nwin = Nwin;
SVDdata.step = step;

SVDdata.mask = mask;

SVDdata.U = Ufield;
SVDdata.V = Vfield;
SVDdata.Sigma = Sigma_field;

SVDdata.s1 = Sigma_field(:,:,1);
SVDdata.s2 = Sigma_field(:,:,2);

SVDdata.theta_v1 = theta_v1;
SVDdata.theta_u1 = theta_u1;

SVDdata.finalX = finalX;
SVDdata.finalY = finalY;
end

% ------------------- plot dots colored by their S-band -------------------
function plot_banded_dots(xyAll, Sfine_final, dot_cmap)
% xyAll        - [N x 2] dot positions [x y] (1-based pixel coords)
% Sfine_final  - HxW S-field at current locations
% dot_cmap     - 12x3 RGB table, one row per band

if isempty(xyAll) || isempty(Sfine_final), return; end

[H, W] = size(Sfine_final);
N = size(xyAll, 1);

ix = max(1, min(W, round(xyAll(:,1))));
iy = max(1, min(H, round(xyAll(:,2))));
lin = sub2ind([H W], iy, ix);
dot_S = Sfine_final(lin);

% Only 6 selected ranges get dots; everything else (S>=3.0 and NaN) is skipped.
band = zeros(N, 1);
band(dot_S <  1.5)                        = 1;
band(dot_S >= 1.5 & dot_S <  1.8)         = 2;
band(dot_S >= 1.8 & dot_S <  2.0)         = 3;
band(dot_S >  2.0 & dot_S <= 2.2)         = 4;
band(dot_S >  2.2 & dot_S <  2.5)         = 5;
band(dot_S >= 2.5 & dot_S <= 3.0)         = 6;

for b = 1:6
    sel = (band == b);
    if any(sel)
        plot(xyAll(sel,1), xyAll(sel,2), '.', ...
             'MarkerSize', 10, 'Color', dot_cmap(b,:));
    end
end
end

function apply_log_S_cmap(ax, S_max)
% Apply logarithmic color scale to S-field plots so the full S range
% [1, S_max] is visible without losing low-S detail.  Sets caxis and
% switches the axes to log color scale.  Caller is responsible for any
% colorbar; MATLAB will choose log-spaced default ticks.
if nargin < 2, S_max = 15; end
caxis(ax, [1, S_max]);
set(ax, 'ColorScale', 'log');
end

function cmap = build_diverging_bwr(N)
% Diverging blue->white->red colormap of length N (for signed scalars
% like rotation angle or trace).
if nargin<1, N = 256; end
half = floor(N/2);
% blue -> white
b1 = linspace(0.10, 1.00, half).';
g1 = linspace(0.30, 1.00, half).';
r1 = linspace(0.20, 1.00, half).';
% white -> red
r2 = linspace(1.00, 0.85, N-half).';
g2 = linspace(1.00, 0.10, N-half).';
b2 = linspace(1.00, 0.15, N-half).';
cmap = [r1 g1 b1; r2 g2 b2];
end
