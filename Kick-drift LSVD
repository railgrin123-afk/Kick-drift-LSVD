% ===================== NEW FIGURES: exponential/log decay starting at the actual intersection cycle =====================
% We find where frac_blue and frac_yellow intersect.
% Then we plot starting at that ACTUAL cycle value cStar, without shifting the x-axis.
%
% So if the intersection is at cStar = 2.4, then the x-axis starts at 2.4,
% and the later data points remain at cycles 3,4,5,...

dBY = frac_blue - frac_yellow;
iCross = find(dBY(1:end-1).*dBY(2:end) <= 0, 1, 'first');

if isempty(iCross)
    warning('No blue/yellow intersection found. Using cycle 1 as start.');
    cStar  = 1;
    iStart = 1;
else
    c1 = iCross;
    c2 = iCross + 1;

    d1 = dBY(c1);
    d2 = dBY(c2);

    % linear interpolation for the crossing location
    if abs(d2 - d1) < 1e-12
        cStar = c1;
    else
        cStar = c1 - d1*(c2 - c1)/(d2 - d1);
    end

    % start the real sampled data at the first full cycle after the crossing
    iStart = c2;
end

fprintf('\n');
fprintf('Blue/yellow intersection estimated at cycle c* = %.4f\n', cStar);
fprintf('Using actual cycle axis starting at c* = %.4f\n', cStar);
% The window length is Nw = min(Nwin, it) and the window start is
% t0 = max(0, it - Nw). So for it <= Nwin the cycle index IS the window
% length N, with t0 pinned at 0; beyond that N saturates at Nwin and t0
% starts sliding instead. Those are two different independent variables,
% and the kick sequence is i.i.d. in t0, so the second regime is flat by
% construction. Fitting an exponential across both is meaningless, so the
% fit is capped at Nwin.
iEnd = min(cycles, SParams.Nwin);
if cycles > SParams.Nwin
    warning(['cycles (%d) exceeds Nwin (%d): cycles %d-%d vary the window ' ...
             'START t0 at fixed N=%d, not the window LENGTH, and are flat by ' ...
             'construction. Restricting the decay fit to cycles %d-%d.'], ...
            cycles, SParams.Nwin, SParams.Nwin+1, cycles, SParams.Nwin, iStart, iEnd);
end
if iEnd - iStart < 1
    warning('Fit window is cycles %d-%d: fewer than 2 points.', iStart, iEnd);
end
fprintf('Fitting window lengths N = %d to %d (t_0 pinned at 0 throughout).\n', iStart, iEnd);

%% ------------------------------------------------------------------------
%%  Figure 6500: LOW-STRETCH AREA (area_blue_px) using ACTUAL cycle axis
%% ------------------------------------------------------------------------
xA = (iStart:iEnd)';            % actual cycle numbers (N-varying regime only)
yA = area_blue_px(iStart:iEnd);

goodA = isfinite(xA) & isfinite(yA) & (yA > 0);

if nnz(goodA) >= 2
    pA = polyfit(xA(goodA), log(yA(goodA)), 1);   % log(A) = pA(1)*cycle + pA(2)
    logyA_fit = polyval(pA, xA(goodA));
    yA_fit    = exp(logyA_fit);

    kA   = pA(1);
    A0A  = exp(pA(2));
    tauA = -1 / kA;
else
    pA = [NaN NaN];
    logyA_fit = [];
    yA_fit    = [];
    kA = NaN; A0A = NaN; tauA = NaN;
end

% interpolated value exactly at the intersection cycle
yA_cross = interp1(1:cycles, area_blue_px, cStar, 'linear', 'extrap');

figure(6500); clf;
set(gcf,'Color','w','Position',[120 100 1150 430], ...
    'Name','Low-stretch area decay starting at actual blue/yellow intersection cycle');
tiledlayout(1,2,'TileSpacing','compact','Padding','compact');

% --- left: semilogy plot ---
nexttile;
semilogy(cStar, yA_cross, 'ks', 'MarkerFaceColor','y', 'MarkerSize',8); hold on;
semilogy(xA(goodA), yA(goodA), 'o-', 'LineWidth',1.5);
if nnz(goodA) >= 2
    semilogy(xA(goodA), yA_fit, '--', 'LineWidth',1.8);
    legend('intersection', 'data', ...
           sprintf('exp fit: A = %.3e exp(%.3f N)', A0A, kA), ...
           'Location','best');
else
    legend('intersection', 'data', 'Location','best');
end
grid on;
xlabel('window length  N  (= cycle index while t_0 is pinned at 0)');
ylabel('low-stretch area (pixels)');
title('Low-stretch area decay vs window length N (semilogy)');
xlim([cStar cycles]);

% --- right: linearized log plot ---
nexttile;
plot(cStar, log(yA_cross), 'ks', 'MarkerFaceColor','y', 'MarkerSize',8); hold on;
plot(xA(goodA), log(yA(goodA)), 'o-', 'LineWidth',1.5);
if nnz(goodA) >= 2
    plot(xA(goodA), logyA_fit, '--', 'LineWidth',1.8);
    legend('intersection', 'log(data)', ...
           sprintf('linear fit: log(A) = %.3f c %+.3f', pA(1), pA(2)), ...
           'Location','best');
else
    legend('intersection', 'log(data)', 'Location','best');
end
grid on;
xlabel('window length  N');
ylabel('log(low-stretch area)');
title(sprintf('Linearized decay: log(A) vs N | tau = %.3f in units of N', tauA));
xlim([cStar cycles]);

% Figure 6501 used to repeat this fit on total_low_blob_area_px_fullres.
% That series is sum(cellfun(@numel, CC_low_meas)) * cellArea, and
% get_CC_full applies no size filter, so the components partition blueC
% exactly and the sum is identically nnz(blueC)*cellArea = area_blue_px. It
% was the same fit on the same numbers in a second window. Asserted here so
% that if a size filter is ever added -- a reasonable thing to want, given
% how many components are single cells -- the two stop being interchangeable
% loudly rather than silently.
assert(all(isnan(total_low_blob_area_px_fullres) | ...
           total_low_blob_area_px_fullres == area_blue_px), ...
       ['total_low_blob_area_px_fullres has diverged from area_blue_px; ' ...
        'the blob decomposition no longer partitions blueC.']);

fprintf('Low-stretch area fit: A = %.6e * exp(%.6f * N), tau = %.6f in window length N\n', ...
        A0A, kA, tauA);

%% ========================================================================
%%  E)  FINAL FULL-RESOLUTION BLOB ANALYSIS
%%      Runs once after the last cycle on the finest available S-field.
%%
%%  Per-blob outputs
%%  ----------------
%%  blob_area    : pixel count
%%  blob_frac    : fraction of total valid S-field pixels
%%  blob_cx/cy   : centroid in image (col, row) coordinates (1-based)
%%  blob_xmin/xmax/ymin/ymax : tight bounding box
%%  blob_r_eq    : equivalent radius   r_eq = sqrt(A/pi)
%%  blob_compact : compactness         C    = 4*pi*A / P^2
%%                 (C=1 for a perfect circle; smaller = more irregular)
%%
%%  Written outputs
%%  ---------------
%%  blob_summary.txt - full ranked table including all fields above.
%% ========================================================================
fprintf('\n');
fprintf('=============================================================\n');
fprintf('  FINAL FULL-RESOLUTION BLOB ANALYSIS  (after %d cycles)\n', cycles);
fprintf('=============================================================\n');

%% -- S-field on the final window --
% This used to call Sfield_snapshot again. Its arguments are identical to the
% last in-loop call by construction: there Tcur = cycles, Nw = min(Nwin,
% cycles) and t0 = max(0, cycles - Nw), and here Tcur_fin = numel(dp_x_hist)
% = cycles gives exactly the same three values. Sfield_snapshot is
% deterministic, so it recomputed 57,600 monodromies to reproduce a field the
% loop had already produced. Reuse it.
Tcur_fin = numel(dp_x_hist);
Nw_fin   = min(SParams.Nwin, Tcur_fin);
t0_fin   = max(0, Tcur_fin - Nw_fin);
if SHOW_S_FIELD_FIG && exist('Sfine_final','var') && ~isempty(Sfine_final)
    assert(isequal([Nw_fin, t0_fin], [Nw, t0_recent]), ...
           'Final window differs from the last cycle''s; reuse would be invalid.');
    Sfin    = Sfine_final;
    maskFin = maskFine_final;
    Scfin   = Scoarse;
    maskCfin= maskC;
else
    fprintf('Computing S-field on the final window ...\n');
    [Sfin, maskFin, Scfin, maskCfin] = Sfield_snapshot(dp_x_hist, row0, Tau, rows, cols, ...
                                      t0_fin, Nw_fin, SParams);
end

% Same split as the per-cycle path: the summary is measured on the lattice
% that was actually evaluated, and Sfin is kept only to draw fig 7001.
% Thresholding Sfin here reported a low-stretch fraction ~5x too small,
% because smoothing and linear upsampling both erode the low set inward
% (see Sfield_snapshot for the measurements).
step_fin  = SParams.FIELD_STEP;
cellA_fin = step_fin^2;

valid_fin     = maskCfin & isfinite(Scfin);
low_mask_fin  = valid_fin & (Scfin <= SParams.S_THR);
high_mask_fin = valid_fin & (Scfin >  SParams.S_THR);

% areas reported in full-resolution px^2; fractions are the lattice estimate
tot_valid  = nnz(valid_fin) * cellA_fin;
tot_low    = nnz(low_mask_fin) * cellA_fin;
tot_high   = nnz(high_mask_fin) * cellA_fin;
frac_low_f = nnz(low_mask_fin)  / max(1, nnz(valid_fin));
frac_high_f= nnz(high_mask_fin) / max(1, nnz(valid_fin));

%% -- connected components on the measured lattice --
fprintf('Running connected-component analysis on the measured lattice ...\n');
CC_final = get_CC_full(low_mask_fin, SParams.BLOB_CONN);
nF       = numel(CC_final);
fprintf('  Found %d low-stretch blob(s) at %d px sampling.\n', nF, step_fin);

%% -- compute per-blob statistics --
[H_im, W_im] = size(low_mask_fin);

blob_area    = zeros(nF,1);
blob_frac    = zeros(nF,1);
blob_cx      = zeros(nF,1);
blob_cy      = zeros(nF,1);
blob_xmin    = zeros(nF,1);
blob_xmax    = zeros(nF,1);
blob_ymin    = zeros(nF,1);
blob_ymax    = zeros(nF,1);
blob_r_eq    = zeros(nF,1);
blob_compact = zeros(nF,1);

for k = 1:nF
    idx_lin  = CC_final{k};
    [ry, rx] = ind2sub([H_im, W_im], idx_lin);
    A_cell = numel(idx_lin);            % in lattice cells
    A      = A_cell * cellA_fin;        % in full-resolution px^2

    % lattice index i sits at pixel (i-1)*step + 1
    blob_area(k)  = A;
    blob_frac(k)  = A / max(1, tot_valid);
    blob_cx(k)    = (mean(rx)-1)*step_fin + 1;
    blob_cy(k)    = (mean(ry)-1)*step_fin + 1;
    blob_xmin(k)  = (min(rx)-1)*step_fin + 1;  blob_xmax(k) = (max(rx)-1)*step_fin + 1;
    blob_ymin(k)  = (min(ry)-1)*step_fin + 1;  blob_ymax(k) = (max(ry)-1)*step_fin + 1;
    blob_r_eq(k)  = sqrt(A / pi);

    % perimeter-based compactness  C = 4*pi*A / P^2.
    % Computed in lattice units and left there: under a change of scale
    % A -> A*s^2 and P -> P*s, so C is scale-invariant and needs no conversion.
    %
    % Cropped to the blob's bounding box. This used to allocate a full
    % H_im x W_im logical per blob and run four full-frame comparisons over
    % it. At FIELD_STEP = 1 that is a 3.7 MB allocation plus ~15 MB of traffic
    % for every component, and by cycle 12 there are ~5,700 of them, 60% being
    % a single pixel whose perimeter is 4. compute_perimeter pads with
    % background on all four sides, so the pixels just outside the box read as
    % background either way and the crop is exactly equivalent -- verified
    % over 3,000 random blobs including ones touching the frame edge, zero
    % mismatches. Cost now scales with the blob, not with the frame.
    r0 = min(ry); r1 = max(ry);
    c0 = min(rx); c1 = max(rx);
    BW_blob = false(r1-r0+1, c1-c0+1);
    BW_blob(sub2ind(size(BW_blob), ry-r0+1, rx-c0+1)) = true;
    P = compute_perimeter(BW_blob);
    if P > 0
        blob_compact(k) = 4*pi*A_cell / P^2;
    else
        blob_compact(k) = NaN;
    end
end

%% -- sort blobs by area (largest first) --
[blob_area, si] = sort(blob_area, 'descend');
blob_frac       = blob_frac(si);
blob_cx         = blob_cx(si);
blob_cy         = blob_cy(si);
blob_xmin       = blob_xmin(si);
blob_xmax       = blob_xmax(si);
blob_ymin       = blob_ymin(si);
blob_ymax       = blob_ymax(si);
blob_r_eq       = blob_r_eq(si);
blob_compact    = blob_compact(si);
CC_sorted       = CC_final(si);

%% -- print ranked table to console --
fprintf('\n');
fprintf('  Total valid pixels  : %d\n', tot_valid);
fprintf('  Low-stretch pixels  : %d  (%.2f%%)\n', tot_low,  frac_low_f *100);
fprintf('  Stretched pixels    : %d  (%.2f%%)\n', tot_high, frac_high_f*100);
fprintf('  Number of blobs     : %d\n\n', nF);

fprintf('  %-5s  %-9s  %-7s  %-7s  %-7s  %-6s  %-9s\n', ...
    'Rank','Area(px)','Frac','Cx','Cy','r_eq','Compact');
fprintf('  %s\n', repmat('-',1,60));
nShow = min(nF, TOPN_BLOB_CONSOLE);
for k = 1:nShow
    fprintf('  %-5d  %-9d  %.4f  %-7.1f  %-7.1f  %-6.2f  %.4f\n', ...
            k, blob_area(k), blob_frac(k), ...
            blob_cx(k), blob_cy(k), blob_r_eq(k), blob_compact(k));
end
if nF > nShow
    fprintf('  ... %d smaller blob(s) not shown; full table in blob_summary.txt\n', ...
            nF - nShow);
    fprintf('      (shown blobs hold %.4f of the valid field, all blobs %.4f)\n', ...
            sum(blob_frac(1:nShow)), sum(blob_frac));
end
fprintf('  %s\n', repmat('-',1,60));
% totals stay over ALL blobs, not just the printed ones
fprintf('  Total low-stretch blob area : %d px  (%.4f of valid field)\n', ...
        sum(blob_area), sum(blob_frac));
fprintf('=============================================================\n\n');

%% -- write blob_summary.txt --
fid = fopen('blob_summary.txt','w');
fprintf(fid,'FINAL LOW-STRETCH BLOB SUMMARY\n');
fprintf(fid,'Simulation: cycles=%d | Nwin=%d | S_THR=%.2f\n', ...
        cycles, Nw_fin, SParams.S_THR);
fprintf(fid,'Image size: %d rows x %d cols\n\n', rows, cols);
fprintf(fid,'Global:\n');
fprintf(fid,'  Total valid pixels  : %d\n',         tot_valid);
fprintf(fid,'  Low-stretch pixels  : %d  (%.6f)\n', tot_low,  frac_low_f);
fprintf(fid,'  Stretched pixels    : %d  (%.6f)\n', tot_high, frac_high_f);
fprintf(fid,'  Number of blobs     : %d\n\n',        nF);
hdr = sprintf('%-5s  %-9s  %-10s  %-8s  %-8s  %-6s  %-6s  %-6s  %-6s  %-7s  %-9s\n', ...
    'Rank','Area(px)','Frac','Cx','Cy','Xmin','Xmax','Ymin','Ymax','r_eq','Compact');
fprintf(fid,'%s%s\n', hdr, repmat('-',1,90));
for k = 1:nF
    fprintf(fid,'%-5d  %-9d  %-10.6f  %-8.2f  %-8.2f  %-6d  %-6d  %-6d  %-6d  %-7.2f  %.6f\n', ...
            k, blob_area(k), blob_frac(k), ...
            blob_cx(k), blob_cy(k), ...
            blob_xmin(k), blob_xmax(k), blob_ymin(k), blob_ymax(k), ...
            blob_r_eq(k), blob_compact(k));
end
fprintf(fid,'\nTotal low-stretch blob area: %d px  (%.6f of valid field)\n', ...
        sum(blob_area), sum(blob_frac));
fclose(fid);
fprintf('Blob table written to  blob_summary.txt\n\n');

%% ========================================================================
%%  F)  Final analysis figures
%% ========================================================================

%% -- Fig 7001: Final S-field + S_THR contour + numbered blob overlays --
figure(7001); clf;
set(gcf,'Color','w','Position',[100 60 1100 950], ...
    'Name', sprintf('Final s_1 field + blob map  (cycle %d)', cycles));
hIm = imagesc(Sfin);
set(hIm,'AlphaData', double(maskFin));
axis image off;
colormap(gca, cmap_blue_yellow); colorbar;
apply_log_S_cmap(gca, SParams.S_CLIP_MAX);
title(sprintf(['Final s_1(x_N,y_N)  |  S_{THR}=%.1f  |  Nwin=%d  |  %d blobs  ' ...
               '(%d largest labelled)  [FINAL location]'], ...
              SParams.S_THR, Nw_fin, nF, min(nF, TOPK_BLOB_LABELS)));
hold on;
% draw S=S_THR boundary
contour(Sfin, [SParams.S_THR SParams.S_THR], 'w', 'LineWidth',1.5);
% semi-transparent coloured fill + text label for each blob
cmap_blobs = lines(max(nF,1));
if nF > 0
    % build a single label image: pixel value = blob rank (1..nF)
    if nF < 65535
        label_img_fin = zeros(H_im, W_im, 'uint16');
    else
        label_img_fin = zeros(H_im, W_im, 'uint32');
    end
    for k = 1:nF
        label_img_fin(CC_sorted{k}) = k;
    end
    blob_mask_fin = label_img_fin > 0;
    rgb_overlay_fin = ind2rgb(label_img_fin, [0 0 0; cmap_blobs]);
    % the label image is on the FIELD_STEP lattice while Sfin behind it is at
    % full resolution, so place it explicitly over the pixels it represents
    % rather than letting it default to the top-left W_im x H_im corner.
    hB_fin = image(rgb_overlay_fin, ...
                   'XData', [1, (W_im-1)*step_fin + 1], ...
                   'YData', [1, (H_im-1)*step_fin + 1]);
    set(hB_fin,'AlphaData', 0.35 * double(blob_mask_fin));
    clear rgb_overlay_fin label_img_fin blob_mask_fin;

    % labels on the largest blobs only; all of them keep their patch
    for k = 1:min(nF, TOPK_BLOB_LABELS)
        text(blob_cx(k), blob_cy(k), ...
             sprintf('#%d\n%dpx\nr=%.1f', k, blob_area(k), blob_r_eq(k)), ...
             'Color','w','FontSize',7,'FontWeight','bold', ...
             'HorizontalAlignment','center','VerticalAlignment','middle', ...
             'BackgroundColor',[0 0 0 0.4]);
    end
end
hold off; drawnow;


fprintf('All figures generated.  blob_summary.txt written.\n');

