%  kick_drift_plus_Smap_each_cycle_separate.m
%  ----------------------------------------------------------------------
%  WHAT YOU WANT NOW (FINAL):
%   For EVERY cycle, show:
%     (1) BEFORE
%     (2) AFTER KICK
%     (3) AFTER DRIFT
%     (4) BIG FIGURE: ONLY low-stretch YELLOW DOTS (S <= 2) for that cycle
%     (5) BIG FIGURE: "S magnitude vs where we started"
%         -> heatmap of S(x0,y0) + colorbar + (optional) contour line S=2
%
%  CORE MATH:
%   • NO stable/unstable anymore.
%   • Compute Nwin-step monodromy M (finite difference).
%   • Stretch metric: S = sigma_max(M) = largest singular value.
%   • Criterion: S > 2  -> stretched
%               S <= 2 -> low-stretch (tube/disk survives over the window)
%
%  IMPORTANT DISPLAY CHOICE:
%   • Contour *lines* alone look like squiggles (level sets).
%   • To see magnitude, we plot a filled heatmap (imagesc) + colorbar,
%     and optionally overlay only ONE contour: S = 2.
% ========================================================================

clear; clc; close all; rng(0);

%% ---------- A) make the initial image (dotted grid + 3 bands) ----------
n = 40;
f = figure('Units','inches','Position',[1 1 12 12],'Color','w');
ax = axes('Parent', f);

[Xp,Yp] = meshgrid(0:n+1, 0:n+1);
plot(ax, Xp, Yp, 'ko', 'MarkerSize', 4, 'MarkerFaceColor', 'k', 'LineStyle', 'none');
hold(ax,'on');

axis(ax,'equal'); xlim(ax,[0 n+1]); ylim(ax,[0 n+1]); axis(ax,'off');

rectangle(ax, 'Position', [0, n/2 + 2.5,  n+1, 1], 'FaceColor','r', 'EdgeColor','none');
rectangle(ax, 'Position', [0, n/2 - 0.5,  n+1, 1], 'FaceColor','g', 'EdgeColor','none');
rectangle(ax, 'Position', [0, n/2 - 3.5,  n+1, 1], 'FaceColor','b', 'EdgeColor','none');

set(ax,'Units','normalized','Position',[0 0 1 1],'LooseInset',[0 0 0 0]);
exportgraphics(f, 'init_image.png', 'Resolution', 160);
close(f);

%% ---------- B) Kick–drift simulation + S-map ----------
img0 = im2double(imread('init_image.png'));
if max(img0(:))>1.5, img0 = img0/255; end
if size(img0,3)==1, img0 = cat(3,img0,img0,img0); end
if size(img0,3)==4, img0 = img0(:,:,1:3); end

[rows, cols, ~] = size(img0);
if mod(rows,2), img0 = img0(2:end,:,:); end
if mod(cols,2), img0 = img0(:,2:end,:); end
[rows, cols, ~] = size(img0);

% -------------------- dynamics parameters --------------------
cycles = 10;
row0   = rows/2;
lc     = 0.05;
K0     = 0.025;
Tau0   = 0.5;
Lx=1.0; Lp=1.0;
TIME_DIR = +1;     % +1 pullback forward-time; -1 visually reverse time

K   = K0/Lp * rows;
Tau = (Tau0*Lx*rows)/(cols*Lp);

xgrid = linspace(-0.5, 0.5, cols);
c_x   = exp(-(xgrid.^2)/(lc^2));
cf_x  = randpot1d_getFFT(c_x);

% history
img_hist = {};
dp_x_hist = {};

% -------------------- display toggles --------------------
SHOW_PANELS_EACH_CYCLE = true;
SHOW_LOW_STRETCH_DOTS  = true;

% "S magnitude vs start" plot per cycle
SHOW_S_FIELD_FIG       = true;

% overlay S field on the dot figure (semi-transparent)
OVERLAY_S_FIELD_ON_DOTS = true;

% per-cycle A/B/C zoom-window figure (8500+it) on the S-field
SHOW_ZOOM_WINDOWS = true;

% -------------------- S-map params --------------------
SParams.Nwin      = 10;        % target window length; early cycles auto smaller
SParams.VOTE_T0   = 5;         % number of recent t0 windows to vote over (for dots)
SParams.KEEP_FRAC = 0.50;      % fraction of passes that must agree
SParams.PITCH_YX  = [12 12];   % probe lattice spacing
SParams.JITTER_FR = 0.8;       % jitter as fraction of pitch
SParams.CENTER_MUST_BE_GOOD = true;

SParams.DET_TOL = 5e-3;        % det sanity for FD monodromy
SParams.S_THR   = 2.0;         % your criterion: S <= 2 is low-stretch

% dots deposited at START (because you want S vs where we started)
SParams.DEPOSIT_AT_FINAL = true;

% -------- S-field (magnitude map) settings (this makes the contour plot clean) -----
SParams.FIELD_STEP        = 8;     % coarsening for S-field evaluation (bigger = faster)
SParams.FIELD_SMOOTH_SIG  = 1.0;   % smoothing strength in "grid cells"
SParams.FIELD_ALPHA       = 0.28;  % transparency when overlaying on the image
SParams.S_CLIP_MAX        = 15;    % color scale upper cap for display (logarithmic, so high S compressed)

% Zoom-window (A/B/C) settings
SParams.ZOOM_WIN_PX       = 300;   % zoom window size in pixels (square)
SParams.S_CROSS           = 5.26;  % colormap crossover: above this the cmap renders yellow-side (R>B)

% Contours: to avoid spaghetti, default is ONLY the threshold contour S=2
SParams.SHOW_ONLY_THR_CONTOUR = true;

% Custom colormap: dark cyan -> teal -> yellow
nCmap = 256;
t = linspace(0, 1, nCmap)';
cmap_blue_yellow = [ 0.0*(1-t).^2 + 0.129*2.*t.*(1-t) + 0.993*t.^2, ...
                     0.25*(1-t).^2 + 0.566*2.*t.*(1-t) + 0.906*t.^2, ...
                     0.35*(1-t).^2 + 0.692*2.*t.*(1-t) + 0.144*t.^2 ];

% -------------------- YELLOW -> BLUE transitions (NEW OVERLAY) --------------------
% "orange" means: S was > 2 last cycle, now S <= 2
SHOW_Y2B_ORANGE = true;

SParams.TRANS_ALPHA = 0.45;    % transparency for orange overlay

S_prev_final    = [];
mask_prev_final = [];

y2b_area_px = zeros(cycles,1);
y2b_frac    = zeros(cycles,1);


% -------------------- NEW: area of S-field regions per cycle --------------------
area_blue_px   = nan(cycles,1);   % "blue" = S <= S_THR
area_yellow_px = nan(cycles,1);   % "yellow" = S >  S_THR
area_total_px  = nan(cycles,1);   % total valid pixels used (maskFine)

frac_blue   = nan(cycles,1);
frac_yellow = nan(cycles,1);

cur = img0;

% -------------------- EXTRA ANALYSIS (AREA + BLOBS) --------------------
% Define which is "blue" vs "yellow" in the S-field
% (This is just analysis naming; it does NOT change your colormap.)
SParams.BLUE_IS_LOW  = true;      % blue-region = (S <= S_THR)
SParams.BLOB_CONN    = 4;         % 4-connected blobs (use 8 if you want)
SParams.BLOB_STEP    = 4;         % downsample factor for blob counting (1 = full res)

% per-cycle totals from the FULL Sfine grid (exact totals)
area_blue_px   = nan(cycles,1);
area_yellow_px = nan(cycles,1);
frac_blue      = nan(cycles,1);
frac_yellow    = nan(cycles,1);

% per-cycle blob counts + blob size stats (computed on downsampled grid)
n_blue_blobs   = nan(cycles,1);
n_yellow_blobs = nan(cycles,1);

mean_blue_blob_area_px   = nan(cycles,1);
mean_yellow_blob_area_px = nan(cycles,1);

med_blue_blob_area_px    = nan(cycles,1);
med_yellow_blob_area_px  = nan(cycles,1);

max_blue_blob_area_px    = nan(cycles,1);
max_yellow_blob_area_px  = nan(cycles,1);
% -------------------- ADD-ON: full-res ranked low-stretch blob areas per cycle --------------------
TOPK_LOW_BLOBS = 5;

n_low_blobs_fullres              = nan(cycles,1);
total_low_blob_area_px_fullres   = nan(cycles,1);
largest_low_blob_area_px_fullres = nan(cycles,1);
top3_low_blob_area_px_fullres    = nan(cycles,1);
top5_low_blob_area_px_fullres    = nan(cycles,1);

low_blob_rank_area_px_fullres = nan(cycles, TOPK_LOW_BLOBS);

% -------------------- ADD-ON: store full SVD of monodromy --------------------
STORE_FULL_SVD_EACH_CYCLE = true;
svd_start_hist = cell(cycles,1);


for it = 1:cycles
    % ---- new random kick profile ----
    dp_x = K * randpot1d_four(cf_x);
    dp_x_hist{end+1} = dp_x; %#ok<SAGROW>

    % ---- warp for visualization (pullback) ----
    stage1_img = warp_image(cur, @InverseKick_vert, struct('dp_x', dp_x));

    if TIME_DIR == +1
        stage2_img = warp_image(cur, @InverseFullStep, struct('dp_x',dp_x,'row0',row0,'Tau',Tau));
    else
        stage2_img = warp_image(cur, @ForwardFullStep, struct('dp_x',dp_x,'row0',row0,'Tau',Tau));
    end

    img_hist{end+1} = stage2_img; %#ok<SAGROW>

    % ---- (A) 3-panel BEFORE/KICK/DRIFT ----
    if SHOW_PANELS_EACH_CYCLE
        figA = figure(2000 + it);
        set(figA,'Color','w','Position',[60 60 1500 420], ...
            'Name', sprintf('Cycle %d: before/kick/drift', it));
        tiledlayout(1,3,'TileSpacing','compact','Padding','compact');

        nexttile; imshow(cur, []); axis image off; title(sprintf('cycle %d: BEFORE', it));

        ax2 = nexttile; imshow(stage1_img, []); axis image off; title('AFTER KICK');
        hold(ax2,'on'); plot(ax2, 1:cols, (row0+1) + dp_x(:).', 'LineWidth', 2); hold(ax2,'off');

        nexttile; imshow(stage2_img, []); axis image off; title('AFTER DRIFT');
        drawnow;
    end

    cur = stage2_img;

    % ---- choose the "most recent" window start for the S-field plot ----
    Tcur = numel(dp_x_hist);
    Nw   = min(SParams.Nwin, Tcur);
    t0_recent = max(0, Tcur - Nw);

    % ---- (B) S magnitude vs start (HEATMAP + COLORBAR + optional S=2 contour) ----
    if SHOW_S_FIELD_FIG
        [Sfine, maskFine, Sfine_final, maskFine_final, ~, Rotfine_final, ~, Trfine_final] = Sfield_snapshot(dp_x_hist, row0, Tau, rows, cols, ...
                                            t0_recent, Nw, SParams);
        % -------------------- CURRENT-LOCATION ONLY ANALYSIS --------------------
        y2bMask_final = false(rows, cols);

        if isempty(Sfine_final) || isempty(maskFine_final) || ~any(maskFine_final(:))
            warning('cycle %d: current-location S-field is empty; skipping current-location analysis.', it);

            valid      = false(rows, cols);
            blueMask   = false(rows, cols);
            yellowMask = false(rows, cols);

            y2b_area_px(it) = 0;
            y2b_frac(it)    = 0;

        else
            % Use CURRENT / FINAL location field only
            valid      = maskFine_final & isfinite(Sfine_final);
            blueMask   = valid & (Sfine_final <= SParams.S_THR);   % low stretch at current location
            yellowMask = valid & (Sfine_final >  SParams.S_THR);   % high stretch at current location

            % yellow -> blue transition at CURRENT locations
            if SHOW_Y2B_ORANGE && it > 1 && ~isempty(S_prev_final)
                validBothF = valid & mask_prev_final & isfinite(S_prev_final);

                y2bMask_final = validBothF & ...
                                (S_prev_final >  SParams.S_THR) & ...
                                (Sfine_final   <= SParams.S_THR);

                y2b_area_px(it) = nnz(y2bMask_final);

                denom = nnz(validBothF);
                if denom > 0
                    y2b_frac(it) = y2b_area_px(it) / denom;
                else
                    y2b_frac(it) = 0;
                end
            else
                y2b_area_px(it) = 0;
                y2b_frac(it)    = 0;
            end
        end

        % -------------------- ADD-ON: full-res low-stretch blob areas this cycle --------------------
        % One blob = one connected component of the low-stretch set S <= S_THR.
        % This uses the full-resolution blueMask, not the downsampled blueB.

        CC_low_cycle = get_CC_full(blueMask, SParams.BLOB_CONN);

        if isempty(CC_low_cycle)
            aLow_full = [];
        else
            aLow_full = cellfun(@numel, CC_low_cycle(:));
            aLow_full = sort(aLow_full(:), 'descend');
        end

        n_low_blobs_fullres(it) = numel(aLow_full);

        if ~isempty(aLow_full)
            total_low_blob_area_px_fullres(it)   = sum(aLow_full);
            largest_low_blob_area_px_fullres(it) = aLow_full(1);

            k3 = min(3, numel(aLow_full));
            k5 = min(5, numel(aLow_full));

            top3_low_blob_area_px_fullres(it) = sum(aLow_full(1:k3));
            top5_low_blob_area_px_fullres(it) = sum(aLow_full(1:k5));

            kk = min(TOPK_LOW_BLOBS, numel(aLow_full));
            low_blob_rank_area_px_fullres(it,1:kk) = aLow_full(1:kk);
        else
            total_low_blob_area_px_fullres(it)   = 0;
            largest_low_blob_area_px_fullres(it) = 0;
            top3_low_blob_area_px_fullres(it)    = 0;
            top5_low_blob_area_px_fullres(it)    = 0;
        end

        area_blue_px(it)   = nnz(blueMask);
        area_yellow_px(it) = nnz(yellowMask);

        A = nnz(valid);
        if A > 0
            frac_blue(it)   = area_blue_px(it)   / A;
            frac_yellow(it) = area_yellow_px(it) / A;
        end

        % -------------------- (NEW) BLOB COUNTS (CONNECTED COMPONENTS) --------------------
        stepB = max(1, SParams.BLOB_STEP);

        % downsample for speed (blob counts are usually stable under mild downsampling)
        blueB   = blueMask(1:stepB:end, 1:stepB:end);
        yellowB = yellowMask(1:stepB:end, 1:stepB:end);

        % blob stats (areas are in "downsample pixels" -> convert back to full-res pixels)
        [nB, aB] = blob_stats_any(blueB,   SParams.BLOB_CONN);
        [nY, aY] = blob_stats_any(yellowB, SParams.BLOB_CONN);

        n_blue_blobs(it)   = nB;
        n_yellow_blobs(it) = nY;

        if ~isempty(aB)
            aBpx = aB(:) * stepB^2;
            mean_blue_blob_area_px(it) = mean(aBpx);
            med_blue_blob_area_px(it)  = median(aBpx);
            max_blue_blob_area_px(it)  = max(aBpx);
        end
        if ~isempty(aY)
            aYpx = aY(:) * stepB^2;
            mean_yellow_blob_area_px(it) = mean(aYpx);
            med_yellow_blob_area_px(it)  = median(aYpx);
            max_yellow_blob_area_px(it)  = max(aYpx);
        end

        % optional: print a quick line each cycle
        fprintf('cycle %2d | blue: area=%7d (%.3f) blobs=%4d | yellow: area=%7d (%.3f) blobs=%4d\n', ...
            it, area_blue_px(it), frac_blue(it), n_blue_blobs(it), ...
            area_yellow_px(it), frac_yellow(it), n_yellow_blobs(it));

        % -------------------- CURRENT-LOCATION blue/yellow area --------------------
        area_blue_px(it)   = sum(blueMask(:));
        area_yellow_px(it) = sum(yellowMask(:));
        area_total_px(it)  = sum(valid(:));

        if area_total_px(it) > 0
            frac_blue(it)   = area_blue_px(it)   / area_total_px(it);
            frac_yellow(it) = area_yellow_px(it) / area_total_px(it);
        else
            frac_blue(it)   = NaN;
            frac_yellow(it) = NaN;
        end

        if area_total_px(it) > 0
            frac_blue(it)   = area_blue_px(it)   / area_total_px(it);
            frac_yellow(it) = area_yellow_px(it) / area_total_px(it);
        end

        % optional: print per cycle
        fprintf('cycle %2d | blue(S<=%.2f)=%.0f px (%.3f) | yellow(S>%.2f)=%.0f px (%.3f)\n', ...
            it, SParams.S_THR, area_blue_px(it), frac_blue(it), ...
            SParams.S_THR, area_yellow_px(it), frac_yellow(it));

        figS = figure(5000 + it); clf;
        set(figS,'Color','w','Position',[1000 80 900 900], ...
            'Name', sprintf('Cycle %d: S-field at CURRENT locations (banded regions)', it));

        % ---- build a discrete band label image from Sfine_final ----
        %   1: S<1.0           7: 2.2<S<=2.5
        %   2: 1.0<=S<1.3      8: 2.5<S<=2.7
        %   3: 1.3<=S<1.5      9: 2.7<S<=3.0
        %   4: 1.5<=S<1.8      10: 3.0<S<=3.5
        %   5: 1.8<=S<=2.0     11: 3.5<S<=4.0
        %   6: 2.0<S<=2.2      12: S>4.0
        Sf = Sfine_final;
        Mf = maskFine_final;
        Lband = zeros(size(Sf), 'uint8');
        Lband(Mf & Sf <  1.0)                        = 1;
        Lband(Mf & Sf >= 1.0 & Sf <  1.3)            = 2;
        Lband(Mf & Sf >= 1.3 & Sf <  1.5)            = 3;
        Lband(Mf & Sf >= 1.5 & Sf <  1.8)            = 4;
        Lband(Mf & Sf >= 1.8 & Sf <= 2.0)            = 5;
        Lband(Mf & Sf >  2.0 & Sf <= 2.2)            = 6;
        Lband(Mf & Sf >  2.2 & Sf <= 2.5)            = 7;
        Lband(Mf & Sf >  2.5 & Sf <= 2.7)            = 8;
        Lband(Mf & Sf >  2.7 & Sf <= 3.0)            = 9;
        Lband(Mf & Sf >  3.0 & Sf <= 3.5)            = 10;
        Lband(Mf & Sf >  3.5 & Sf <= 4.0)            = 11;
        Lband(Mf & Sf >  4.0)                         = 12;

        band_cmap = [...
            1.00 0.00 0.00;   % 1: bright red       S<1.0
            1.00 0.45 0.00;   % 2: orange-red       1.0<=S<1.3
            1.00 0.20 0.65;   % 3: hot pink         1.3<=S<1.5
            0.20 1.00 0.30;   % 4: bright green     1.5<=S<1.8
            0.13 0.57 0.69;   % 5: dark teal        1.8<=S<=2.0
            0.99 0.91 0.14;   % 6: yellow           2.0<S<=2.2
            0.00 0.00 0.70;   % 7: dark blue        2.2<S<=2.5
            0.00 0.45 0.00;   % 8: dark green       2.5<S<=2.7
            0.00 0.00 0.00;   % 9: black            2.7<S<=3.0
            0.40 0.00 0.55;   % 10: dark purple     3.0<S<=3.5
            0.80 0.93 0.93;   % 11: eggshell blue    3.5<S<=4.0
            0.72 0.53 0.04];  % 12: deep goldenrod   S>4.0

        % ---- DOT colors (one per band) - chosen to contrast with band bg ----
        %  1: S<1.5            cyan
        %  2: 1.5<=S<1.8       lime green
        %  3: 1.8<=S<2.0       neon orange (brighter)
        %  4: 2.0<S<=2.2       brown
        %  5: 2.2<S<2.5        bright red
        %  6: 2.5<=S<=3.0      teal
        dot_cmap = [...
            0.00 1.00 1.00;   % 1: cyan            (S<1.5)
            0.40 1.00 0.00;   % 2: lime green      (1.5<=S<1.8)
            1.00 0.65 0.00;   % 3: neon orange     (1.8<=S<2.0)
            0.55 0.27 0.07;   % 4: brown           (2.0<S<=2.2)
            1.00 0.00 0.00;   % 5: bright red      (2.2<S<2.5)
            0.00 0.70 0.80];  % 6: teal            (2.5<=S<=3.0)

        hIm = imagesc(double(Lband));
        axis image off;
        set(hIm,'AlphaData', 1.0 * (Lband > 0));   % transparent outside any band
        colormap(figS, band_cmap);
        caxis([1.0, 12.5]);
        cb = colorbar;
        cb.Ticks      = 1:12;
        cb.TickLabels = {'S<1.0','1.0-1.3','1.3-1.5','1.5-1.8','1.8-2.0', ...
                         '2.0-2.2','2.2-2.5','2.5-2.7','2.7-3.0','3.0-3.5', ...
                         '3.5-4.0','S>4.0'};
        title(sprintf('cycle %d: S at CURRENT location (x_N,y_N) - banded regions | Nwin=%d, t0=%d', ...
              it, Nw, t0_recent));

        hold on;
        % ---- white S = 2 boundary line on top ----
        contour(Sfine_final, [SParams.S_THR SParams.S_THR], ...
                'LineWidth', 1.8, 'LineColor', [1 1 1]);

        hold off;
        drawnow;

        % ---- S-field at CURRENT (FINAL) locations: standalone heatmap ----
        if ~isempty(Sfine_final)
            figSF = figure(5500 + it); clf;
            set(figSF,'Color','w','Position',[1050 80 900 900], ...
                'Name', sprintf('Cycle %d: S-field at CURRENT locations', it));

            hImF = imagesc(Sfine_final);
            axis image off;
            set(hImF,'AlphaData', 1.0 * maskFine_final);
            colormap(figSF, cmap_blue_yellow);
            colorbar;
            apply_log_S_cmap(gca, SParams.S_CLIP_MAX);
            title(sprintf('cycle %d: S at CURRENT location (x_N,y_N) | Nwin=%d, t0=%d  [log scale, max=%.1f]', ...
                  it, Nw, t0_recent, SParams.S_CLIP_MAX));

            hold on;
            if SHOW_Y2B_ORANGE && any(y2bMask_final(:))
                overlay_mask_rgb(y2bMask_final, [1 0 1], SParams.TRANS_ALPHA);
            end

            if SParams.SHOW_ONLY_THR_CONTOUR
                contour(Sfine_final, [SParams.S_THR SParams.S_THR], 'w', 'LineWidth', 1.2);
            else
                contour(Sfine_final, [1.2 1.5 2.0 3.0 4.0], 'w', 'LineWidth', 0.8);
            end

            hold off;
            drawnow;
        end

        % ---- 3-PANEL HISTOGRAM of S distribution per cycle ----
        if ~isempty(Sfine_final)
            Svals = Sfine_final(maskFine_final & isfinite(Sfine_final));

            figH = figure(7000 + it); clf;
            set(figH,'Color','w','Position',[80 540 2350 420], ...
                'Name', sprintf('Cycle %d: S-distribution histograms', it));
            tiledlayout(1,5,'TileSpacing','compact','Padding','compact');

            % --- Panel 1: 0 <= S <= 2.0 (low-stretch zone) ---
            nexttile;
            seg1 = Svals(Svals >= 0 & Svals <= 2.0);
            edges1 = 0:0.05:2.0;
            histogram(seg1, edges1, 'FaceColor', [0.20 0.45 0.85], 'EdgeColor','none');
            hold on;
            if ~isempty(seg1)
                xline(mean(seg1), '--', 'Color',[0.0 0.2 0.6], 'LineWidth',1.5, ...
                      'Label', sprintf('mean=%.3f', mean(seg1)), ...
                      'LabelHorizontalAlignment','left');
            end
            xline(SParams.S_THR, '-', 'Color',[0 0 0], 'LineWidth',1.4, ...
                  'Label','S=2.0 threshold','LabelHorizontalAlignment','left');
            xlim([0 2.0]); grid on;
            xlabel('S level'); ylabel('pixel count');
            title(sprintf('Low-stretch (0 <= S <= 2.0)  n=%d', numel(seg1)));

            % --- Panel 2: 2.0 < S <= 6.0 (high-stretch zone) ---
            nexttile;
            seg2 = Svals(Svals > 2.0 & Svals <= 6.0);
            edges2 = 2.0:0.1:6.0;
            histogram(seg2, edges2, 'FaceColor', [0.95 0.55 0.10], 'EdgeColor','none');
            hold on;
            if ~isempty(seg2)
                xline(mean(seg2), '--', 'Color',[0.6 0.25 0.0], 'LineWidth',1.5, ...
                      'Label', sprintf('mean=%.3f', mean(seg2)), ...
                      'LabelHorizontalAlignment','left');
            end
            xlim([2.0 6.0]); grid on;
            xlabel('S level'); ylabel('pixel count');
            title(sprintf('High-stretch (2.0 < S <= 6.0)  n=%d', numel(seg2)));

            % --- Panel 3: S > 6.0 (extreme stretch) - upper limit auto-chosen ---
            nexttile;
            seg3 = Svals(Svals > 6.0);
            if ~isempty(seg3)
                upper3 = min(max(seg3), 100);   % cap at 100 for sanity
                edges3 = 6.0:max(0.25,(upper3-6)/40):upper3;
            else
                upper3 = 30;
                edges3 = 6:1:upper3;
            end
            histogram(seg3, edges3, 'FaceColor', [0.85 0.10 0.10], 'EdgeColor','none');
            hold on;
            if ~isempty(seg3)
                xline(mean(seg3), '--', 'Color',[0.5 0 0], 'LineWidth',1.5, ...
                      'Label', sprintf('mean=%.3f', mean(seg3)), ...
                      'LabelHorizontalAlignment','left');
            end
            xlim([6.0 upper3]); grid on;
            xlabel('S level'); ylabel('pixel count');
            title(sprintf('Extreme (S > 6.0)  n=%d', numel(seg3)));

            % --- Panel 4: 0 <= S <= 2.0  COLOR-CLASSIFIED by rendered cmap color ---
            % Each S<=2 pixel is classified by what color the cmap_blue_yellow
            % colormap actually renders it as (using LOG caxis range):
            %   - if R > B in the rendered RGB -> "yellow-leaning" -> orange bar
            %   - if R <= B                    -> "teal-leaning"   -> blue bar
            nexttile;
            seg4 = Svals(Svals >= 0 & Svals <= 2.0);
            edges4 = 0:0.05:2.0;
            cax_lo = 1.0;  cax_hi = SParams.S_CLIP_MAX;
            % log-scale t (matches 'ColorScale','log' rendering)
            seg4_safe = max(seg4, cax_lo);
            tvals = (log(seg4_safe) - log(cax_lo)) / max(eps, (log(cax_hi) - log(cax_lo)));
            tvals = min(1, max(0, tvals));
            % rendered RGB at each pixel using the same formula as cmap_blue_yellow
            R4 = 0.0 *(1-tvals).^2 + 0.129*2.*tvals.*(1-tvals) + 0.993*tvals.^2;
            B4 = 0.35*(1-tvals).^2 + 0.692*2.*tvals.*(1-tvals) + 0.144*tvals.^2;
            yellow_mask = (R4 > B4);
            seg4_yellow = seg4(yellow_mask);
            seg4_teal   = seg4(~yellow_mask);

            % bin both groups on the same edges, then stack
            counts_teal   = histcounts(seg4_teal,   edges4);
            counts_yellow = histcounts(seg4_yellow, edges4);
            centers4 = 0.5*(edges4(1:end-1)+edges4(2:end));
            hb = bar(centers4, [counts_teal; counts_yellow]', ...
                     'stacked', 'BarWidth', 1.0, 'EdgeColor','none');
            hb(1).FaceColor = [0.20 0.45 0.85];   % teal-side -> blue bar
            hb(2).FaceColor = [0.95 0.55 0.10];   % yellow-side -> orange bar
            hold on;
            xline(SParams.S_THR, '-', 'Color',[0 0 0], 'LineWidth',1.4, ...
                  'Label','S=2.0','LabelHorizontalAlignment','left');
            xlim([0 2.0]); grid on;
            xlabel('S level'); ylabel('pixel count');
            title(sprintf('S<=2 by rendered color  teal=%d  yellow-spill=%d', ...
                          numel(seg4_teal), numel(seg4_yellow)));
            legend({'teal-side (R<=B)','yellow-spill (R>B)'}, ...
                   'Location','northeast','FontSize',8);

            % --- Panel 5: 2.0 < S <= S_CLIP_MAX  COLOR-CLASSIFIED (reverse spillage) ---
            % Check if high-stretch pixels incorrectly render as teal under LOG scale.
            nexttile;
            seg5 = Svals(Svals > 2.0 & Svals <= cax_hi);
            edges5 = 2.0:max(0.1, (cax_hi-2.0)/35):cax_hi;
            seg5_safe = max(seg5, cax_lo);
            tvals5 = (log(seg5_safe) - log(cax_lo)) / max(eps, (log(cax_hi) - log(cax_lo)));
            tvals5 = min(1, max(0, tvals5));
            R5 = 0.0 *(1-tvals5).^2 + 0.129*2.*tvals5.*(1-tvals5) + 0.993*tvals5.^2;
            B5 = 0.35*(1-tvals5).^2 + 0.692*2.*tvals5.*(1-tvals5) + 0.144*tvals5.^2;
            teal_mask5 = (R5 <= B5);
            seg5_teal   = seg5(teal_mask5);
            seg5_yellow = seg5(~teal_mask5);

            counts_teal5   = histcounts(seg5_teal,   edges5);
            counts_yellow5 = histcounts(seg5_yellow, edges5);
            centers5 = 0.5*(edges5(1:end-1)+edges5(2:end));
            hb5 = bar(centers5, [counts_teal5; counts_yellow5]', ...
                      'stacked', 'BarWidth', 1.0, 'EdgeColor','none');
            hb5(1).FaceColor = [0.20 0.45 0.85];   % teal-side -> blue bar
            hb5(2).FaceColor = [0.95 0.55 0.10];   % yellow-side -> orange bar
            hold on;
            xline(SParams.S_THR, '-', 'Color',[0 0 0], 'LineWidth',1.4, ...
                  'Label','S=2.0','LabelHorizontalAlignment','right');
            xlim([2.0 cax_hi]); grid on;
            xlabel('S level'); ylabel('pixel count');
            title(sprintf('2.0<S<=%.1f by rendered color  yellow=%d  blue-spill=%d', ...
                          cax_hi, numel(seg5_yellow), numel(seg5_teal)));
            legend({'blue-spill (R<=B)','yellow-side (R>B)'}, ...
                   'Location','northeast','FontSize',8);

            sgtitle(sprintf('Cycle %d: S-level distributions  (total valid=%d)  log-caxis=[%.2f, %.2f]', ...
                    it, numel(Svals), cax_lo, cax_hi), 'FontWeight','bold');
            drawnow;

            % ---- PER-CYCLE BLOB MAP (mirrors final blob figure 7001) ----
            figBlob = figure(8000 + it); clf;
            set(figBlob,'Color','w','Position',[100 60 1100 950], ...
                'Name', sprintf('Cycle %d: S-field + numbered low-stretch blobs', it));
            hImB = imagesc(Sfine_final);
            set(hImB,'AlphaData', double(maskFine_final));
            axis image off;
            colormap(gca, cmap_blue_yellow); colorbar;
            apply_log_S_cmap(gca, SParams.S_CLIP_MAX);

            nB_cyc = numel(CC_low_cycle);
            title(sprintf('cycle %d: s_1(x_0,y_0)  |  S_{THR}=%.1f  |  Nwin=%d  |  %d blobs', ...
                          it, SParams.S_THR, Nw, nB_cyc));
            hold on;
            % S=S_THR boundary
            contour(Sfine_final, [SParams.S_THR SParams.S_THR], 'w', 'LineWidth', 1.5);

            % sort blobs by area (largest first) and overlay numbered labels
            if nB_cyc > 0
                areas_cyc = cellfun(@numel, CC_low_cycle(:));
                [areas_sorted, sort_idx] = sort(areas_cyc, 'descend');
                cmap_blobs_cyc = lines(max(nB_cyc,1));
                [Hc, Wc] = size(maskFine_final);

                % build a single label image: pixel value = blob rank (1..nB_cyc)
                if nB_cyc < 65535
                    label_img = zeros(Hc, Wc, 'uint16');
                else
                    label_img = zeros(Hc, Wc, 'uint32');
                end
                for k = 1:nB_cyc
                    label_img(CC_low_cycle{sort_idx(k)}) = k;
                end
                blob_mask_all = label_img > 0;
                rgb_overlay = ind2rgb(label_img, [0 0 0; cmap_blobs_cyc]);
                hBk = image(rgb_overlay);
                set(hBk,'AlphaData', 0.35 * double(blob_mask_all));
                clear rgb_overlay label_img blob_mask_all;

                % numbered text labels at each blob centroid
                for k = 1:nB_cyc
                    idx_lin_k = CC_low_cycle{sort_idx(k)};
                    [ry_k, rx_k] = ind2sub([Hc Wc], idx_lin_k);
                    cx_k = mean(rx_k);  cy_k = mean(ry_k);
                    A_k  = areas_sorted(k);
                    r_eq_k = sqrt(A_k / pi);
                    text(cx_k, cy_k, ...
                         sprintf('#%d\n%dpx\nr=%.1f', k, A_k, r_eq_k), ...
                         'Color','w','FontSize',7,'FontWeight','bold', ...
                         'HorizontalAlignment','center','VerticalAlignment','middle', ...
                         'BackgroundColor',[0 0 0 0.4]);
                end
            end
            hold off; drawnow;

            % ---- PER-CYCLE ROTATION + TRACE + CLASSIFICATION FIGURE ----
            % 4 panels at FINAL (current) locations:
            %   Panel 1: S-field        (stretching magnitude)
            %   Panel 2: Rotation θ     (local angular momentum, radians, signed)
            %   Panel 3: Trace(M)       (|tr|<2 = elliptic/rotating, |tr|>2 = hyperbolic/saddle)
            %   Panel 4: Classification (combines S and |trace| into 4 regimes)
            if exist('Rotfine_final','var') && ~isempty(Rotfine_final) && ...
               exist('Trfine_final','var')  && ~isempty(Trfine_final)

                figRot = figure(9000 + it); clf;
                set(figRot,'Color','w','Position',[40 40 1700 1100], ...
                    'Name', sprintf('Cycle %d: Stretching vs Rotation (Local Angular Momentum)', it));

                % --- Panel 1: S-field ---
                subplot(2,2,1);
                hS = imagesc(Sfine_final);
                set(hS,'AlphaData', double(maskFine_final));
                axis image off;
                colormap(gca, cmap_blue_yellow);
                cb1 = colorbar; cb1.Label.String = 'S = max singular value (log scale)';
                apply_log_S_cmap(gca, SParams.S_CLIP_MAX);
                hold on;
                contour(Sfine_final, [SParams.S_THR SParams.S_THR], 'w', 'LineWidth', 1.5);
                hold off;
                title(sprintf('(1) STRETCHING field S(x_N,y_N)  |  white = S=%.1f', SParams.S_THR), ...
                      'FontWeight','bold');

                % --- Panel 2: Rotation angle (signed) ---
                subplot(2,2,2);
                hR = imagesc(Rotfine_final);
                set(hR,'AlphaData', double(maskFine_final));
                axis image off;
                rot_vals_abs = abs(Rotfine_final(maskFine_final));
                rot_vals_abs = rot_vals_abs(isfinite(rot_vals_abs));
                if isempty(rot_vals_abs)
                    rot_lim = pi;
                else
                    rot_lim = max(1e-3, prctile(rot_vals_abs, 98));
                end
                caxis([-rot_lim, rot_lim]);
                cmap_rot = build_diverging_bwr(256);
                colormap(gca, cmap_rot);
                cb2 = colorbar; cb2.Label.String = '\theta (radians)  [- = CW, + = CCW]';
                title('(2) ROTATION angle \theta (local angular momentum)', 'FontWeight','bold');

                % --- Panel 3: Trace(M) ---
                subplot(2,2,3);
                hT = imagesc(Trfine_final);
                set(hT,'AlphaData', double(maskFine_final));
                axis image off;
                tr_vals_abs = abs(Trfine_final(maskFine_final));
                tr_vals_abs = tr_vals_abs(isfinite(tr_vals_abs));
                if isempty(tr_vals_abs)
                    tr_lim = 4;
                else
                    tr_lim = max(2.5, prctile(tr_vals_abs, 98));
                end
                caxis([-tr_lim, tr_lim]);
                colormap(gca, cmap_rot);
                cb3 = colorbar; cb3.Label.String = 'trace(M) = M_{11}+M_{22}';
                hold on;
                % |trace|=2 contour separates elliptic (rotating) from hyperbolic (stretching)
                contour(Trfine_final, [-2 -2], 'k', 'LineWidth', 1.2, 'LineStyle','--');
                contour(Trfine_final, [ 2  2], 'k', 'LineWidth', 1.2, 'LineStyle','--');
                hold off;
                title('(3) TRACE(M)  |  dashed = |tr|=2 (elliptic\leftrightarrowhyperbolic)', ...
                      'FontWeight','bold');

                % --- Panel 4: Combined classification ---
                %   1: low-S + elliptic   = STABLE VORTEX (tornado eye)        cyan
                %   2: low-S + hyperbolic = quiet stretch (frozen shear)        light blue
                %   3: high-S + elliptic  = CHAOTIC VORTEX STRETCHING           magenta
                %   4: high-S + hyperbolic= PURE STRETCH / TURBULENT SHEAR      orange
                subplot(2,2,4);
                low_S      = maskFine_final & (Sfine_final <= SParams.S_THR);
                high_S     = maskFine_final & (Sfine_final >  SParams.S_THR);
                elliptic   = maskFine_final & (abs(Trfine_final) <  2);
                hyperbolic = maskFine_final & (abs(Trfine_final) >= 2);

                Lclass = zeros(size(Sfine_final), 'uint8');
                Lclass(low_S  & elliptic)   = 1;   % stable vortex
                Lclass(low_S  & hyperbolic) = 2;   % quiet stretch
                Lclass(high_S & elliptic)   = 3;   % chaotic vortex stretching
                Lclass(high_S & hyperbolic) = 4;   % pure shear

                class_cmap = [...
                    0.00 0.85 0.95;   % 1: cyan      = stable vortex (tornado eye)
                    0.55 0.75 0.95;   % 2: light blue= quiet stretch
                    1.00 0.20 0.80;   % 3: magenta   = chaotic vortex stretching
                    1.00 0.55 0.00];  % 4: orange    = pure shear / turbulent shear

                hC = imagesc(double(Lclass));
                set(hC,'AlphaData', double(Lclass>0));
                axis image off;
                colormap(gca, class_cmap);
                caxis([0.5, 4.5]);
                cb4 = colorbar;
                cb4.Ticks      = 1:4;
                cb4.TickLabels = {...
                    'STABLE VORTEX  (low-S, elliptic)', ...
                    'quiet stretch  (low-S, hyperbolic)', ...
                    'CHAOTIC VORTEX (high-S, elliptic)', ...
                    'PURE SHEAR     (high-S, hyperbolic)'};
                title(sprintf('(4) CLASSIFICATION  |  S_{THR}=%.1f, |trace|=2 split', SParams.S_THR), ...
                      'FontWeight','bold');

                sgtitle(sprintf(['Cycle %d  |  Nwin=%d, t0=%d   ', ...
                                 '\\bfPanels:\\rm  (1) stretching S   (2) rotation \\theta   (3) trace(M)   (4) regime classification'], ...
                                 it, Nw, t0_recent), 'FontSize', 12);
                drawnow;
            end
        end
    else
        Sfine = []; maskFine = [];
        Sfine_final = []; maskFine_final = [];
    end

    % ---- (C) LOW-STRETCH yellow dots + optional overlay of the S-field ----
    if SHOW_LOW_STRETCH_DOTS
        Pnow = SParams;
        Pnow.Nwin = Nw;

        % dots from your robust voting scheme
        [xyLow, xyHigh, stats] = Smap_dots_snapshot(dp_x_hist, row0, Tau, Pnow, rows, cols);

        % ============ FIGURE: CURRENT-location S-field on cycle-0 frame ============
        figB = figure(3000 + it);
        set(figB,'Color','w','Position',[80 80 900 900], ...
            'Name', sprintf('Cycle %d: CURRENT-location S-field on cycle-0 frame', it));

        imshow(img0, []);
        axis image off;
        hold on;

        % overlay current-location magnitude map on top of the original (cycle-0) frame
        if OVERLAY_S_FIELD_ON_DOTS && ~isempty(Sfine_final)
            h2 = imagesc(Sfine_final);
            set(h2,'AlphaData', SParams.FIELD_ALPHA * maskFine_final);
            colormap(figB, cmap_blue_yellow);
            apply_log_S_cmap(gca, SParams.S_CLIP_MAX);
            % add ONLY the S=2 boundary to avoid squiggle-spam
            contour(Sfine_final, [SParams.S_THR SParams.S_THR], 'w', 'LineWidth', 1.1);
        end

        % ---- ORANGE overlay (yellow->blue transition) ----
        if SHOW_Y2B_ORANGE && any(y2bMask_final(:))
            overlay_mask_rgb(y2bMask_final, [1 0 1], min(0.60, SParams.TRANS_ALPHA + 0.10));
        end

        % BANDED DOTS: each dot colored by its S-band
        plot_banded_dots([xyLow; xyHigh], Sfine_final, dot_cmap);

        title(sprintf(['cycle %d: CURRENT-location S-field on cycle-0 frame (S<=%.2f) | Nwin=%d | ' ...
                       'low=%d, stretched=%d, passes=%d'], ...
              it, Pnow.S_THR, Pnow.Nwin, stats.n_low, stats.n_high, stats.passes));

        hold off;
        drawnow;

        % ============ FIGURE: S-field at CURRENT (FINAL) locations on kick-drift map ============
        if ~isempty(Sfine_final)
            figC = figure(4000 + it);
            set(figC,'Color','w','Position',[100 100 900 900], ...
                'Name', sprintf('Cycle %d: S-field at CURRENT locations (on kick-drift)', it));

            imshow(stage2_img, []);
            axis image off;
            hold on;

            % overlay S-field remapped to final (current) positions
            h3 = imagesc(Sfine_final);
            set(h3,'AlphaData', SParams.FIELD_ALPHA * maskFine_final);
            colormap(figC, cmap_blue_yellow);
            colorbar;
            apply_log_S_cmap(gca, SParams.S_CLIP_MAX);

            % contour at S = S_THR on the final-location field
            contour(Sfine_final, [SParams.S_THR SParams.S_THR], 'w', 'LineWidth', 1.1);

            % ---- ORANGE overlay (yellow->blue transition) ----
            if SHOW_Y2B_ORANGE && any(y2bMask_final(:))
                overlay_mask_rgb(y2bMask_final, [1 0 1], min(0.60, SParams.TRANS_ALPHA + 0.10));
            end

            % BANDED DOTS: each dot colored by its S-band
            plot_banded_dots([xyLow; xyHigh], Sfine_final, dot_cmap);

            title(sprintf(['cycle %d: S-field at CURRENT locations (S<=%.2f) | Nwin=%d | ' ...
                           'low=%d, stretched=%d, passes=%d'], ...
                  it, Pnow.S_THR, Pnow.Nwin, stats.n_low, stats.n_high, stats.passes));

            hold off;
            drawnow;
        end
        % ============ ZOOM WINDOWS A/B/C on the kick-drift composite ============
        % Same rendering as figure 4000+it (warped kick-drift image + translucent
        % S-field + S=S_THR contour + transition overlay + banded dots), with
        % three WINSZ x WINSZ windows chosen from the connected-component
        % analysis:
        %   A = largest low-stretch blob
        %   B = low-stretch blob whose area changed most vs the previous cycle
        %   C = largest component of  S_THR < S < S_CROSS  (high-stretch but
        %       below the colormap yellow crossover)
        if SHOW_ZOOM_WINDOWS && ~isempty(Sfine_final) && exist('CC_low_cycle','var')
            WINSZ = SParams.ZOOM_WIN_PX;
            [Hz, Wz] = size(Sfine_final);

            % Windows are placed in order A -> B -> C, and each one must land
            % clear of the ones already placed. Zooming twice into the same
            % ground wastes a panel, so when a candidate would overlap we try
            % the next candidate, and failing that re-centre the window
            % elsewhere inside the same component (see place_window_clear).
            placedW = {};

            % --- A: largest low-stretch blob (placed first, gets priority) ---
            idxA = []; sortZ_idx = []; winA = [];
            if ~isempty(CC_low_cycle)
                areasZ = cellfun(@numel, CC_low_cycle(:));
                [~, sortZ_idx] = sort(areasZ, 'descend');
                idxA = CC_low_cycle{sortZ_idx(1)};
                winA = zoom_window_from_idx(idxA, Hz, Wz, WINSZ);
                placedW{end+1} = winA;
            end

            % --- B: biggest area change vs previous cycle, clear of A ---
            % low_blob_rank_area_px_fullres stores areas BY RANK, not by blob
            % identity (blobs are not tracked across cycles), so this is the
            % RANK whose area moved most, then that rank's blob this cycle.
            % Rank 1 is excluded: it IS window A, and being the largest blob it
            % almost always has the largest absolute change. Remaining ranks
            % are tried in order of decreasing |change| until one lands clear.
            idxB = []; kB = NaN; dB = NaN; winB = [];
            if numel(sortZ_idx) >= 2 && it > 1
                cur_r = low_blob_rank_area_px_fullres(it,   :);
                prv_r = low_blob_rank_area_px_fullres(it-1, :);
                dR    = abs(cur_r - prv_r);
                dR(1) = NaN;                                         % exclude rank 1 (= A)
                dR(min(numel(dR), numel(sortZ_idx))+1 : end) = NaN;  % ranks with no blob
                dRs = dR;  dRs(~isfinite(dRs)) = -Inf;
                [dvals, rankOrder] = sort(dRs, 'descend');
                for t = 1:numel(rankOrder)
                    if ~isfinite(dvals(t)), break; end
                    kc   = rankOrder(t);
                    cand = CC_low_cycle{sortZ_idx(kc)};
                    [w, okw] = place_window_clear(cand, Hz, Wz, WINSZ, placedW);
                    if okw || isempty(winB)      % first candidate kept as fallback
                        kB = kc;  dB = cur_r(kc) - prv_r(kc);
                        idxB = cand;  winB = w;
                    end
                    if okw, break; end
                end
            end
            if isempty(idxB) && numel(sortZ_idx) >= 2
                kB = 2;  idxB = CC_low_cycle{sortZ_idx(2)};   % fallback: 2nd largest
                winB = place_window_clear(idxB, Hz, Wz, WINSZ, placedW);
            end
            if ~isempty(winB), placedW{end+1} = winB; end

            % --- C: largest mid-stretch component, clear of A and B ---
            midMask = maskFine_final & isfinite(Sfine_final) & ...
                      (Sfine_final >  SParams.S_THR) & ...
                      (Sfine_final <  SParams.S_CROSS);
            CC_mid = get_CC_full(midMask, SParams.BLOB_CONN);
            idxC = []; areaC = 0; winC = [];
            if ~isempty(CC_mid)
                areasMid = cellfun(@numel, CC_mid(:));
                [areasMidS, midOrder] = sort(areasMid, 'descend');
                for t = 1:numel(midOrder)
                    cand = CC_mid{midOrder(t)};
                    [w, okw] = place_window_clear(cand, Hz, Wz, WINSZ, placedW);
                    if okw || isempty(winC)      % largest kept as fallback
                        idxC = cand;  areaC = areasMidS(t);  winC = w;
                    end
                    if okw, break; end
                end
            end

            zIdx = {idxA, idxB, idxC};
            zWin = {winA, winB, winC};
            zLab = {'A','B','C'};
            zCol = {[1 0 1], [0 1 1], [1 0.35 0.05]};

            zTitle = { ...
                sprintf('A: largest low-stretch blob  (%d px)', numel(idxA)), ...
                '', ...
                sprintf('C: largest %.1f<S<%.2f component  (%d px)', ...
                        SParams.S_THR, SParams.S_CROSS, areaC) };
            if isempty(idxB)
                zTitle{2} = 'B: n/a';
            elseif isfinite(dB)
                zTitle{2} = sprintf('B: biggest \\DeltaArea (rank #%d)  %d px  (\\Delta=%+d)', ...
                                    kB, numel(idxB), round(dB));
            else
                zTitle{2} = sprintf('B: rank #%d  %d px  (no prev cycle)', kB, numel(idxB));
            end

            figZ = figure(8500 + it); clf;
            set(figZ,'Color','w','Position',[60 40 1500 1050], ...
                'Name', sprintf('Cycle %d: kick-drift + S-field, zoom windows A/B/C', it));

            % ---- main panel: full kick-drift composite + labelled rectangles ----
            subplot(2,3,[1 2 3]);
            kd_composite(stage2_img, Sfine_final, maskFine_final, y2bMask_final, ...
                         [xyLow; xyHigh], dot_cmap, cmap_blue_yellow, SParams, ...
                         SHOW_Y2B_ORANGE, []);
            axMain = gca;                    % re-acquire: imshow may reuse/replace axes
            climZ  = caxis(axMain);          % reused verbatim by every inset
            colorbar(axMain);

            hold on;
            % draw C, then B, then A so A lands on top if two windows overlap
            for q = [3 2 1]
                if isempty(zWin{q}), continue; end
                r0 = zWin{q}(1); r1 = zWin{q}(2);
                c0 = zWin{q}(3); c1 = zWin{q}(4);
                rectangle('Position', [c0-0.5, r0-0.5, c1-c0+1, r1-r0+1], ...
                          'EdgeColor', zCol{q}, 'LineWidth', 2.5);
                text(c0+6, r0+18+22*(q-1), zLab{q}, 'Color', zCol{q}, ...
                     'FontSize', 18, 'FontWeight','bold', ...
                     'BackgroundColor',[0 0 0 0.45]);
            end
            hold off;
            title(sprintf(['cycle %d: kick-drift + S at CURRENT locations (S<=%.2f) | ' ...
                           'Nwin=%d | low=%d, stretched=%d | windows %dx%d px'], ...
                  it, Pnow.S_THR, Pnow.Nwin, stats.n_low, stats.n_high, WINSZ, WINSZ));

            % ---- insets: identical composite and caxis, just zoomed in ----
