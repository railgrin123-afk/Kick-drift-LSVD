runMetadata.randomSeed = randomSeed;
runMetadata.rngStateBeforeKicks = rng;

% Physical parameters
runMetadata.K0 = K0;
runMetadata.Tau0 = Tau0;
runMetadata.lc = lc;
runMetadata.Lx = Lx;
runMetadata.Lp = Lp;
runMetadata.kappa   = kappa;      % K*Tau, the standard-map parameter
runMetadata.epsilon = epsilon;    % the dimensionless control knob
runMetadata.K = K;
runMetadata.Tau = Tau;

% Geometry
runMetadata.n = n;
runMetadata.rows = rows;
runMetadata.cols = cols;
runMetadata.row0 = row0;
runMetadata.xgrid = xgrid;
