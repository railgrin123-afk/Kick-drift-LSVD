% -------------------- ADDITIONAL PER-CYCLE STORAGE --------------------

% The actual kick-drift background used in the coloured composite.
% uint8 is sufficient because this is visualization data.
cycleData.kickDriftRGB(rows,cols,3,cycles) = uint8(0);

% Yellow-to-blue/magenta transition layer

% Window information used to calculate S during each cycle
cycleData.NwinPerCycle(1,cycles) = uint16(0);
cycleData.t0PerCycle(1,cycles)   = uint16(0);

% Initial, unwarped image used by the visualization
initialClipped = min(max(img0,0),1);
cycleData.initialRGB = uint8(round(255*initialClipped));

% These arrays have variable numbers of rows, so keep them as cells during
% the simulation and write them to the MAT-file after the loop.
xyLow_history   = cell(cycles,1);
xyHigh_history  = cell(cycles,1);
dotStats_history = cell(cycles,1);

% -------------------- HAZARD TRACER + COHERENCE LENGTH STORAGE --------------------
% Tracers are a lattice of INITIAL conditions, each carrying its own running
% monodromy M. One step is applied per cycle, so S_N for the SAME material is
% available at every N without ever re-integrating from the start.
haz_f     = nan(cycles,1);   % fraction of tracers with S <= S_THR
haz_gross = nan(cycles,1);   % P(leaves the low set at N | was in it at N-1)
haz_net   = nan(cycles,1);   % 1 - f(N)/f(N-1), the naive form
haz_reent = nan(cycles,1);   % share of the low set at N that was NOT low at N-1
haz_nprev = nan(cycles,1);   % size of the conditioning population
xi_rad    = nan(cycles,1);   % coherence length of log S, radial, px
xi_x      = nan(cycles,1);
xi_y      = nan(cycles,1);
xi_R2     = nan(cycles,1);   % quality of the exponential description

xi_start  = nan(cycles,1);   % coherence length of the SEED-indexed field
lag_valid = false(cycles,1); % was t0 still pinned at 0 for this cycle?

if LAG.ENABLE
    lag_ys = 0:LAG.STEP:rows-1;
    lag_xs = 0:LAG.STEP:cols-1;
    lag_ny = numel(lag_ys);  lag_nx = numel(lag_xs);
    [tHX, tHY] = meshgrid(lag_xs, lag_ys);
    tr_x = double(tHX(:));            tr_y = double(tHY(:));
    clear tHX tHY
    tr_a = ones(size(tr_x));          tr_b = zeros(size(tr_x));
    tr_c = zeros(size(tr_x));         tr_d = ones(size(tr_x));
    tr_lowPrev = [];
    cycleData.S_start(lag_ny, lag_nx, cycles) = single(0);
    fprintf(['Lagrangian accumulator: %d parcels at %d px seed spacing ' ...
             '(%d x %d), ~%.0f MB state + %.0f MB stored.\n'], ...
            numel(tr_x), LAG.STEP, lag_ny, lag_nx, ...
            6*numel(tr_x)*8/1e6, lag_ny*lag_nx*cycles*4/1e6);
end

for it = 1:cycles
    % ---- new random kick profile ----
    dp_x = K * randpot1d_four(cf_x);
    dp_x_hist{end+1} = dp_x; %#ok<SAGROW>

    % ---- advance the hazard tracers one step with THIS cycle's kick ----
    % Same arithmetic as monodromy_S_vec, but incremental: M <- J*M each cycle
    % rather than rebuilding M from t0 every time. Only valid while the
    % analysis window still starts at t0 = 0, i.e. while it <= Nwin; past that
    % the field's window slides and the tracers no longer describe it, which
    % is why the hazard figure stops at min(cycles, Nwin).
    if LAG.ENABLE
        nk_ = numel(dp_x);
        xf_ = floor(tr_x);
        i0_ = mod(xf_, nk_);
        d0_ = dp_x(i0_+1);
        fp_ = dp_x(mod(i0_+1, nk_)+1) - d0_;

        g_  = 1 + Tau*fp_;
        a2_ = g_.*tr_a + Tau*tr_c;   b2_ = g_.*tr_b + Tau*tr_d;
        tr_c = fp_.*tr_a + tr_c;     tr_d = fp_.*tr_b + tr_d;
        tr_a = a2_;                  tr_b = b2_;

        tr_y = tr_y + d0_ + fp_.*(tr_x - xf_);
        tr_x = tr_x + Tau*(tr_y - row0);
        clear xf_ i0_ d0_ fp_ g_ a2_ b2_

        tt_    = tr_a.^2 + tr_b.^2 + tr_c.^2 + tr_d.^2;
        S_lag_ = (sqrt(tt_+2) + sqrt(max(tt_-2,0))) / 2;
        clear tt_
        lowNow_ = S_lag_ <= SParams.S_THR;

        % The accumulator's M covers kicks 1..it, which is the window
        % Sfield_snapshot uses only while t0 stays pinned at 0. Past that the
        % field's window slides and the accumulator is measuring different
        % kicks. Rather than abort a long run, the affected cycles are marked
        % invalid and everything downstream skips them -- loud in the log and
        % in the data, without destroying the Eulerian output, which stays
        % correct throughout.
        lag_valid(it) = (it <= SParams.Nwin);
        if ~lag_valid(it) && it == SParams.Nwin + 1
            warning(['S_start accumulator is only valid while t0 = 0 ' ...
                     '(cycles 1-%d). Later cycles are recorded as NaN; ' ...
                     'reseed each cycle if you need a sliding window.'], ...
                    SParams.Nwin);
        end

        if lag_valid(it)
            cycleData.S_start(:,:,it) = reshape(single(S_lag_), lag_ny, lag_nx);

            % coherence length of the SEED-indexed field, for comparison with
            % xi_rad (which is measured on the final-position field)
            if XI.ENABLE
                xi_start(it) = coherence_length( ...
                    reshape(S_lag_, lag_ny, lag_nx), ...
                    true(lag_ny, lag_nx), LAG.STEP, XI.MAX_LAG);
            end
        else
            cycleData.S_start(:,:,it) = NaN('single');
        end
        clear S_lag_

        haz_f(it) = nnz(lowNow_) / numel(lowNow_);
        if ~isempty(tr_lowPrev)
            nprev_ = nnz(tr_lowPrev);
            haz_nprev(it) = nprev_;
            haz_gross(it) = nnz(tr_lowPrev & ~lowNow_) / max(nprev_, 1);
            haz_reent(it) = nnz(lowNow_ & ~tr_lowPrev) / max(nnz(lowNow_), 1);
            if haz_f(it-1) > 0
                haz_net(it) = 1 - haz_f(it)/haz_f(it-1);
            end
        end
        tr_lowPrev = lowNow_;
        clear lowNow_
    end

    % ---- warp for visualization (pullback) ----
    stage1_img = warp_image(cur, @InverseKick_vert, struct('dp_x', dp_x));

    % Always the pullback. The monodromy always integrates forward, so the
    % old TIME_DIR==-1 branch reversed the picture while leaving the overlay
    % computed forward -- the two would have contradicted each other.
    stage2_img = warp_image(cur, @InverseFullStep, struct('dp_x',dp_x,'row0',row0,'Tau',Tau));

    % Save the exact kick-drift background used by the S-field figures
    frameClipped = min(max(stage2_img,0),1);

    cycleData.kickDriftRGB(:,:,:,it) = ...
        uint8(round(255*frameClipped));

    % MEMORY: img_hist used to keep every cycle's full RGB frame. At
    % ~1920x1920x3 doubles that is ~88 MB per cycle and only the COUNT was
    % ever read, so we keep a counter instead of the frames.
    n_frames = n_frames + 1;

    % ---- (A) 3-panel BEFORE/KICK/DRIFT ----
    if SHOW_PANELS_EACH_CYCLE
        figA = figure(fignum(2000, it, KEEP_FIGS_PER_CYCLE)); clf;
        set(figA,'Color','w','Position',[60 60 1500 420], ...
            'Name', sprintf('Cycle %d: before/kick/drift', it));
        tiledlayout(1,3,'TileSpacing','compact','Padding','compact');

        nexttile; imshow(cur, []); axis image off; title(sprintf('cycle %d: BEFORE', it));

        ax2 = nexttile; imshow(stage1_img, []); axis image off; title('AFTER KICK');
        hold(ax2,'on'); plot(ax2, 1:cols, (row0+1) + dp_x(:).', 'LineWidth', 2); hold(ax2,'off');

        nexttile; imshow(stage2_img, []); axis image off; title('AFTER DRIFT');
        drawnow;
        save_cycle_figure(figA,    "before_kick_drift", it);
    end

    cur = stage2_img;

    % ---- choose the "most recent" window start for the S-field plot ----
    Tcur = numel(dp_x_hist);
    Nw   = min(SParams.Nwin, Tcur);
    t0_recent = max(0, Tcur - Nw);

    cycleData.NwinPerCycle(1,it) = uint16(Nw);
    cycleData.t0PerCycle(1,it)   = uint16(t0_recent);

    % ---- (B) S magnitude vs start (HEATMAP + COLORBAR + optional S=2 contour) ----
    if SHOW_S_FIELD_FIG
        [Sfine_final, maskFine_final, Scoarse, maskC] = ...
            Sfield_snapshot(dp_x_hist, row0, Tau, rows, cols, ...
                            t0_recent, Nw, SParams);
        cycleData.S(:,:,it)    = Sfine_final;
        cycleData.mask(:,:,it) = maskFine_final;
        % -------------------- CURRENT-LOCATION ONLY ANALYSIS --------------------

        % Two families of mask, and they are not interchangeable:
        %
        %   *C  (validC/blueC/yellowC) live on the FIELD_STEP lattice and hold
        %       the values actually measured. Every NUMBER comes from these.
        %   Mask (valid/blueMask/yellowMask) live at full resolution and come
        %       from the interpolated display copy. Only pictures use these.
        %
        % They used to be the same object: the fine masks were built from the
        % smoothed, upsampled field and then counted. That reported a
        % low-stretch fraction of 0.012 where the truth is 0.059, because both
        % the smoothing and the linear interpolation erode the low set from
        % its boundary inward (Sfield_snapshot has the measurements). Counting
        % on the lattice removes the bias outright rather than reducing it,
        % and costs nothing.
        if isempty(Sfine_final) || isempty(maskFine_final) || ~any(maskFine_final(:))
            warning('cycle %d: current-location S-field is empty; skipping current-location analysis.', it);

            valid      = false(rows, cols);
            blueMask   = false(rows, cols);
            yellowMask = false(rows, cols);
            validC     = false(size(Scoarse));
            blueC      = validC;
            yellowC    = validC;

        else
            % ---- MEASURED, on the lattice that was evaluated ----
            validC  = maskC & isfinite(Scoarse);
            blueC   = validC & (Scoarse <= SParams.S_THR);
            yellowC = validC & (Scoarse >  SParams.S_THR);

            % ---- DISPLAY ONLY, at full resolution ----
            valid      = maskFine_final & isfinite(Sfine_final);
            blueMask   = valid & (Sfine_final <= SParams.S_THR);   % low stretch at current location
            yellowMask = valid & (Sfine_final >  SParams.S_THR);   % high stretch at current location

        end

        % one measured lattice cell stands for this many full-resolution px
        cellArea = SParams.FIELD_STEP^2;

        % ---- cross-check: the two framings must agree on the AREA ----
        % S_start indexes material by seed, blueC indexes it by current
        % position. The map is area preserving, so the low-stretch fraction is
        % the same quantity measured two independent ways -- different orbits,
        % different lattices, one shared invariant. They agree statistically,
        % not exactly, so the tolerance is loose on purpose: measured worst
        % |f_start - f_now| was 0.0062 over 12 cycles x 5 kick realisations,
        % and a genuinely broken sweep would miss by 0.5 or more.
        if LAG.ENABLE && lag_valid(it) && nnz(validC) > 0
            f_start_ = mean(cycleData.S_start(:,:,it) <= SParams.S_THR, 'all');
            f_now_   = nnz(blueC) / nnz(validC);
            assert(abs(f_start_ - f_now_) < 0.02, ...
                   ['cycle %d: S_start and S_now disagree on the low-stretch ' ...
                    'fraction (%.5f vs %.5f). Area preservation says they ' ...
                    'cannot; one of the two sweeps is wrong.'], ...
                   it, f_start_, f_now_);
        end

        % ---- coherence length of log S on the measured lattice ----
        % Lattice lags are converted to pixels inside the helper, so xi is in
        % px whatever FIELD_STEP is.
        if XI.ENABLE && any(validC(:))
            [xi_rad(it), xi_x(it), xi_y(it), xi_R2(it)] = ...
                coherence_length(Scoarse, validC, SParams.FIELD_STEP, XI.MAX_LAG);
        end

        % ---- MAGENTA: material that dropped from S > S_THR to S <= S_THR ----
        % This follows the PARCEL, not the screen pixel. Every pixel of the
        % current frame is the end of an orbit, so stepping it back one kick
        % gives where that same material sat at the end of the previous cycle,
        % and S_prev is read there. Comparing S_prev(i,j) against
        % Sfine_final(i,j) directly -- which is what this used to do -- pairs
        % up different parcels: material moves a median ~245 px in one step at
        % these settings, and the two versions agree on under half the pixels
        % they flag.
        %
        % Note the two fields are measured over windows of different length
        % (N = it-1 and N = it), and S grows with N, so this marks material
        % whose stretching fell below threshold DESPITE a longer measurement
        % window. That is the interesting event, and it is rarer than the old
        % version suggested: ~2.5% of the frame at Nwin=12.
        %
        % The threshold is SParams.S_THR. The previous version tested a
        % hard-coded 4.8 while every label around it said 2.
        y2bMask_final = false(rows, cols);
        if SHOW_Y2B_MAGENTA && it > 1 && ~isempty(S_prev_final) && any(valid(:))
            % smaller blocks than the upsampler uses: this loop keeps ~8
            % full-block temporaries alive at once, not two
            blk = max(1, floor(5e5 / max(cols,1)));
            for r0b = 1:blk:rows
                r1b = min(rows, r0b + blk - 1);
                [Xb, Yb] = meshgrid(1:cols, r0b:r1b);

                % one exact inverse step with THIS cycle's kick (0-based)
                y1b = Yb - 1;  x1b = Xb - 1;
                xpb = x1b - Tau*(y1b - row0);
                x0f = floor(xpb);
                i0b = mod(x0f, cols);  i1b = mod(i0b + 1, cols);
                dpb = dp_x(i0b+1) + (dp_x(i1b+1) - dp_x(i0b+1)) .* (xpb - x0f);
                ypb = y1b - dpb;

                % wrap onto the displayed torus, back to 1-based, then read
                % S_prev on its own regular grid
                xq = min(max(mod(xpb, cols) + 1, 1), cols);
                yq = min(max(mod(ypb, rows) + 1, 1), rows);
                Sp = interp2(double(S_prev_final), xq, yq, 'linear');

                y2bMask_final(r0b:r1b, :) = valid(r0b:r1b, :) & isfinite(Sp) & ...
                                            (Sp > SParams.S_THR) & ...
                                            (Sfine_final(r0b:r1b, :) <= SParams.S_THR);
            end
            clear Xb Yb y1b x1b xpb x0f i0b i1b dpb ypb xq yq Sp
        end
        % This one number stays at display resolution, unavoidably: the parcel
        % that lands on a given pixel came from an arbitrary point of the
        % previous frame, not from a lattice node, so S_prev has to be
        % interpolated somewhere no matter what. Numerator and denominator are
        % both counted on the same fine grid, so the ratio is at least
        % self-consistent, but it inherits the reconstruction error the
        % lattice-based fractions above no longer have -- read it as a trend
        % across cycles rather than as a calibrated area.
        y2b_area_px(it) = nnz(y2bMask_final);
        denom = nnz(valid);
        if denom > 0, y2b_frac(it) = y2b_area_px(it) / denom; else, y2b_frac(it) = 0; end
        cycleData.y2bMask(:,:,it) = y2bMask_final;

        % -------------------- low-stretch blob areas this cycle --------------------
        % One blob = one connected component of the low-stretch set S <= S_THR,
        % taken on the MEASURED lattice and converted to full-resolution px^2.
        %
        % These used to be components of the full-resolution blueMask, i.e. of
        % the interpolated picture. Structure finer than FIELD_STEP in that
        % image is reconstruction: the upsampler cannot invent detail between
        % two samples, so a component a few px across was an artefact of
        % drawing rather than a measured island.
        %
        % What a blob count can and cannot tell you here: measured against the
        % 1 px truth, the S<=2 set breaks into 348 components whose MEDIAN area
        % is 1 px, so the raw count is dominated by isolated pixels where the
        % field just dips under the threshold. The area is not -- the 27
        % components of >=64 px hold 94% of the low-stretch area and the 13 of
        % >=256 px hold 82%. Treat total/largest/top-k AREA as the physical
        % quantity and the bare COUNT as resolution- and threshold-sensitive.
        CC_low_meas = get_CC_full(blueC, SParams.BLOB_CONN);

        if isempty(CC_low_meas)
            aLow_full = [];
        else
            aLow_full = cellfun(@numel, CC_low_meas(:)) * cellArea;
            aLow_full = sort(aLow_full(:), 'descend');
            blob_area_history{it} = aLow_full;
        end

        n_low_blobs_fullres(it) = numel(aLow_full);

        if ~isempty(aLow_full)
            total_low_blob_area_px_fullres(it)   = sum(aLow_full);
            largest_low_blob_area_px_fullres(it) = aLow_full(1);

            k3 = min(3, numel(aLow_full));
            k5 = min(5, numel(aLow_full));

            top3_low_blob_area_px_fullres(it) = sum(aLow_full(1:k3));
            top5_low_blob_area_px_fullres(it) = sum(aLow_full(1:k5));

            kk = min(TOPK_LOW_BLOBS, numel(aLow_full));
            low_blob_rank_area_px_fullres(it,1:kk) = aLow_full(1:kk);
        else
            total_low_blob_area_px_fullres(it)   = 0;
            largest_low_blob_area_px_fullres(it) = 0;
            top3_low_blob_area_px_fullres(it)    = 0;
            top5_low_blob_area_px_fullres(it)    = 0;
        end

        % -------------------- CURRENT-LOCATION blue/yellow area --------------------
        % Counted on the measured lattice, reported in full-resolution px^2 so
        % the absolute areas keep the units every downstream plot expects.
        % The FRACTION is the lattice estimate directly: the share of sampled
        % points with S <= S_THR is an unbiased estimator of the area fraction
        % of {S <= S_THR}, at any FIELD_STEP (measured bias <= 4e-4 against 1 px
        % truth for steps 2-16, in every case well under its own sampling
        % noise). Counting the upsampled picture instead returned 0.012 where
        % the truth is 0.059.
        area_blue_px(it)   = nnz(blueC)   * cellArea;
        area_yellow_px(it) = nnz(yellowC) * cellArea;
        area_total_px(it)  = nnz(validC)  * cellArea;

        if nnz(validC) > 0
            frac_blue(it)   = nnz(blueC)   / nnz(validC);
            frac_yellow(it) = nnz(yellowC) / nnz(validC);
        else
            frac_blue(it)   = NaN;
            frac_yellow(it) = NaN;
        end

        % -------------------- BLOB COUNTS (CONNECTED COMPONENTS) --------------------
        % Taken on the measured lattice. SParams.BLOB_STEP used to downsample
        % blueMask again here; that is now redundant, because blueC already IS
        % the sampled grid, and stacking a second decimation on top of it only
        % threw away resolution the monodromies had already paid for.
        [nB, aB] = blob_stats_any(blueC,   SParams.BLOB_CONN);
        [nY, aY] = blob_stats_any(yellowC, SParams.BLOB_CONN);

        n_blue_blobs(it)   = nB;
        n_yellow_blobs(it) = nY;

        if ~isempty(aB)
            aBpx = aB(:) * cellArea;
            mean_blue_blob_area_px(it) = mean(aBpx);
            med_blue_blob_area_px(it)  = median(aBpx);
            max_blue_blob_area_px(it)  = max(aBpx);
        end
        if ~isempty(aY)
            aYpx = aY(:) * cellArea;
            mean_yellow_blob_area_px(it) = mean(aYpx);
            med_yellow_blob_area_px(it)  = median(aYpx);
            max_yellow_blob_area_px(it)  = max(aYpx);
        end

        fprintf(['cycle %2d | blue(S<=%.2f): area=%7d (%.3f) blobs=%4d' ...
                 ' | yellow: area=%7d (%.3f) blobs=%4d\n'], ...
            it, SParams.S_THR, area_blue_px(it), frac_blue(it), n_blue_blobs(it), ...
            area_yellow_px(it), frac_yellow(it), n_yellow_blobs(it));

        figS = figure(fignum(5000, it, KEEP_FIGS_PER_CYCLE)); clf;
        set(figS,'Color','w','Position',[1000 80 900 900], ...
            'Name', sprintf('Cycle %d: S-field at CURRENT locations (banded regions)', it));

        % ---- build a discrete band label image from Sfine_final ----
        %   1: S<1.0           7: 2.2<S<=2.5
        %   2: 1.0<=S<1.3      8: 2.5<S<=2.7
        %   3: 1.3<=S<1.5      9: 2.7<S<=3.0
        %   4: 1.5<=S<1.8      10: 3.0<S<=3.5
        %   5: 1.8<=S<=2.0     11: 3.5<S<=4.0
        %   6: 2.0<S<=2.2      12: S>4.0
        Sf = Sfine_final;
        Mf = maskFine_final;
        Lband = zeros(size(Sf), 'uint8');
        Lband(Mf & Sf <  1.0)                        = 1;
        Lband(Mf & Sf >= 1.0 & Sf <  1.3)            = 2;
        Lband(Mf & Sf >= 1.3 & Sf <  1.5)            = 3;
        Lband(Mf & Sf >= 1.5 & Sf <  1.8)            = 4;
        Lband(Mf & Sf >= 1.8 & Sf <= 2.0)            = 5;
        Lband(Mf & Sf >  2.0 & Sf <= 2.2)            = 6;
        Lband(Mf & Sf >  2.2 & Sf <= 2.5)            = 7;
        Lband(Mf & Sf >  2.5 & Sf <= 2.7)            = 8;
        Lband(Mf & Sf >  2.7 & Sf <= 3.0)            = 9;
        Lband(Mf & Sf >  3.0 & Sf <= 3.5)            = 10;
        Lband(Mf & Sf >  3.5 & Sf <= 4.0)            = 11;
        Lband(Mf & Sf >  4.0)                         = 12;

        band_cmap = [...
            1.00 0.00 0.00;   % 1: bright red       S<1.0
            1.00 0.45 0.00;   % 2: orange-red       1.0<=S<1.3
            1.00 0.20 0.65;   % 3: hot pink         1.3<=S<1.5
            0.20 1.00 0.30;   % 4: bright green     1.5<=S<1.8
            0.13 0.57 0.69;   % 5: dark teal        1.8<=S<=2.0
            0.99 0.91 0.14;   % 6: yellow           2.0<S<=2.2
            0.00 0.00 0.70;   % 7: dark blue        2.2<S<=2.5
            0.00 0.45 0.00;   % 8: dark green       2.5<S<=2.7
            0.00 0.00 0.00;   % 9: black            2.7<S<=3.0
            0.40 0.00 0.55;   % 10: dark purple     3.0<S<=3.5
            0.80 0.93 0.93;   % 11: eggshell blue    3.5<S<=4.0
            0.72 0.53 0.04];  % 12: deep goldenrod   S>4.0

        % The colour definitions are constant, so save them only once.
        if it == 1
            visualization = struct();

            visualization.SColorMap = cmap_blue_yellow;
            visualization.BandColorMap = band_cmap;
            visualization.DotColorMap = dot_cmap;

            visualization.SColorScale = "log";
            visualization.SColorLimits = [1 SParams.S_CLIP_MAX];
            visualization.SAlpha = SParams.FIELD_ALPHA;

            visualization.ContourLevel = SParams.S_THR;
            visualization.ContourColor = [1 1 1];
            visualization.ContourLineWidth = 1.1;

            visualization.TransitionColor = [1 0 1];
            visualization.TransitionAlpha = ...
                min(0.60, SParams.TRANS_ALPHA + 0.10);

            visualization.DotMarkerSize = 10;

            visualization.BandEdges = [ ...
                -Inf 1.0 1.3 1.5 1.8 2.0 ...
                2.2 2.5 2.7 3.0 3.5 4.0 Inf];

            visualization.OVERLAY_S_FIELD_ON_DOTS = ...
                OVERLAY_S_FIELD_ON_DOTS;

            cycleData.visualization = visualization;
        end

        hIm = imagesc(double(Lband));
        axis image off;
        set(hIm,'AlphaData', 1.0 * (Lband > 0));   % transparent outside any band
        colormap(figS, band_cmap);
        caxis([1.0, 12.5]);
        cb = colorbar;
        cb.Ticks      = 1:12;
        cb.TickLabels = {'S<1.0','1.0-1.3','1.3-1.5','1.5-1.8','1.8-2.0', ...
                         '2.0-2.2','2.2-2.5','2.5-2.7','2.7-3.0','3.0-3.5', ...
                         '3.5-4.0','S>4.0'};
        title(sprintf('cycle %d: S at CURRENT location (x_N,y_N) - banded regions | Nwin=%d, t0=%d', ...
              it, Nw, t0_recent));

        hold on;
        % ---- white S = 2 boundary line on top ----
        contour(Sfine_final, [SParams.S_THR SParams.S_THR], ...
                'LineWidth', 1.8, 'LineColor', [1 1 1]);

        hold off;
        drawnow;
        save_cycle_figure(figS,    "banded_S_field", it);

        % ---- S-field at CURRENT (FINAL) locations: standalone heatmap ----
        if ~isempty(Sfine_final)
            figSF = figure(fignum(5500, it, KEEP_FIGS_PER_CYCLE)); clf;
            set(figSF,'Color','w','Position',[1050 80 900 900], ...
                'Name', sprintf('Cycle %d: S-field at CURRENT locations', it));

            hImF = imagesc(Sfine_final);
            axis image off;
            set(hImF,'AlphaData', 1.0 * maskFine_final);
            colormap(figSF, cmap_blue_yellow);
            colorbar;
            apply_log_S_cmap(gca, SParams.S_CLIP_MAX);
            title(sprintf('cycle %d: S at CURRENT location (x_N,y_N) | Nwin=%d, t0=%d  [log scale, max=%.1f]', ...
                  it, Nw, t0_recent, SParams.S_CLIP_MAX));

            hold on;

            if SParams.SHOW_ONLY_THR_CONTOUR
                contour(Sfine_final, [SParams.S_THR SParams.S_THR], 'w', 'LineWidth', 1.2);
            else
                contour(Sfine_final, [1.2 1.5 2.0 3.0 4.0], 'w', 'LineWidth', 0.8);
            end

            % MAGENTA overlay: S > S_THR last cycle, S <= S_THR now
            if SHOW_Y2B_MAGENTA && any(y2bMask_final(:))
                overlay_mask_rgb(y2bMask_final, [1 0 1], ...
                                 min(0.60, SParams.TRANS_ALPHA + 0.10));
            end

            hold off;
            drawnow;
            save_cycle_figure(figSF,   "continuous_S_field", it);
        end

        % ---- 3-PANEL HISTOGRAM of S distribution per cycle ----
        if ~isempty(Sfine_final)
            Svals = Sfine_final(maskFine_final & isfinite(Sfine_final));

            figH = figure(fignum(7000, it, KEEP_FIGS_PER_CYCLE)); clf;
            set(figH,'Color','w','Position',[80 540 2350 420], ...
                'Name', sprintf('Cycle %d: S-distribution histograms', it));
            tiledlayout(1,5,'TileSpacing','compact','Padding','compact');

            % --- Panel 1: 0 <= S <= 2.0 (low-stretch zone) ---
            nexttile;
            seg1 = Svals(Svals >= 0 & Svals <= 2.0);
            edges1 = 0:0.05:2.0;
            histogram(seg1, edges1, 'FaceColor', [0.20 0.45 0.85], 'EdgeColor','none');
            hold on;
            if ~isempty(seg1)
                xline(mean(seg1), '--', 'Color',[0.0 0.2 0.6], 'LineWidth',1.5, ...
                      'Label', sprintf('mean=%.3f', mean(seg1)), ...
                      'LabelHorizontalAlignment','left');
            end
            xline(SParams.S_THR, '-', 'Color',[0 0 0], 'LineWidth',1.4, ...
                  'Label','S=2.0 threshold','LabelHorizontalAlignment','left');
            xlim([0 2.0]); grid on;
            xlabel('S level'); ylabel('pixel count');
            title(sprintf('Low-stretch (0 <= S <= 2.0)  n=%d', numel(seg1)));

            % --- Panel 2: 2.0 < S <= 6.0 (high-stretch zone) ---
            nexttile;
            seg2 = Svals(Svals > 2.0 & Svals <= 6.0);
            edges2 = 2.0:0.1:6.0;
            histogram(seg2, edges2, 'FaceColor', [0.95 0.55 0.10], 'EdgeColor','none');
            hold on;
            if ~isempty(seg2)
                xline(mean(seg2), '--', 'Color',[0.6 0.25 0.0], 'LineWidth',1.5, ...
                      'Label', sprintf('mean=%.3f', mean(seg2)), ...
                      'LabelHorizontalAlignment','left');
            end
            xlim([2.0 6.0]); grid on;
            xlabel('S level'); ylabel('pixel count');
            title(sprintf('High-stretch (2.0 < S <= 6.0)  n=%d', numel(seg2)));

            % --- Panel 3: S > 6.0 (extreme stretch) - upper limit auto-chosen ---
            nexttile;
            seg3 = Svals(Svals > 6.0);
            if ~isempty(seg3)
                upper3 = min(max(seg3), 100);   % cap at 100 for sanity
                edges3 = 6.0:max(0.25,(upper3-6)/40):upper3;
            else
                upper3 = 30;
                edges3 = 6:1:upper3;
            end
            histogram(seg3, edges3, 'FaceColor', [0.85 0.10 0.10], 'EdgeColor','none');
            hold on;
            if ~isempty(seg3)
                xline(mean(seg3), '--', 'Color',[0.5 0 0], 'LineWidth',1.5, ...
                      'Label', sprintf('mean=%.3f', mean(seg3)), ...
                      'LabelHorizontalAlignment','left');
            end
            xlim([6.0 upper3]); grid on;
            xlabel('S level'); ylabel('pixel count');
            title(sprintf('Extreme (S > 6.0)  n=%d', numel(seg3)));

            % --- Panel 4: 0 <= S <= 2.0  COLOR-CLASSIFIED by rendered cmap color ---
            % Each S<=2 pixel is classified by what color the cmap_blue_yellow
            % colormap actually renders it as (using LOG caxis range):
            %   - if R > B in the rendered RGB -> "yellow-leaning" -> orange bar
            %   - if R <= B                    -> "teal-leaning"   -> blue bar
            nexttile;
            seg4 = Svals(Svals >= 0 & Svals <= 2.0);
            edges4 = 0:0.05:2.0;
            cax_lo = 1.0;  cax_hi = SParams.S_CLIP_MAX;
            % log-scale t (matches 'ColorScale','log' rendering)
            seg4_safe = max(seg4, cax_lo);
            tvals = (log(seg4_safe) - log(cax_lo)) / max(eps, (log(cax_hi) - log(cax_lo)));
            tvals = min(1, max(0, tvals));
            % rendered RGB at each pixel using the same formula as cmap_blue_yellow
            R4 = 0.0 *(1-tvals).^2 + 0.129*2.*tvals.*(1-tvals) + 0.993*tvals.^2;
            B4 = 0.35*(1-tvals).^2 + 0.692*2.*tvals.*(1-tvals) + 0.144*tvals.^2;
            yellow_mask = (R4 > B4);
            seg4_yellow = seg4(yellow_mask);
            seg4_teal   = seg4(~yellow_mask);

            % bin both groups on the same edges, then stack
            counts_teal   = histcounts(seg4_teal,   edges4);
            counts_yellow = histcounts(seg4_yellow, edges4);
            centers4 = 0.5*(edges4(1:end-1)+edges4(2:end));
            hb = bar(centers4, [counts_teal; counts_yellow]', ...
                     'stacked', 'BarWidth', 1.0, 'EdgeColor','none');
            hb(1).FaceColor = [0.20 0.45 0.85];   % teal-side -> blue bar
            hb(2).FaceColor = [0.95 0.55 0.10];   % yellow-side -> orange bar
            hold on;
            xline(SParams.S_THR, '-', 'Color',[0 0 0], 'LineWidth',1.4, ...
                  'Label','S=2.0','LabelHorizontalAlignment','left');
            xlim([0 2.0]); grid on;
            xlabel('S level'); ylabel('pixel count');
            title(sprintf('S<=2 by rendered color  teal=%d  yellow-spill=%d', ...
                          numel(seg4_teal), numel(seg4_yellow)));
            legend({'teal-side (R<=B)','yellow-spill (R>B)'}, ...
                   'Location','northeast','FontSize',8);

            % --- Panel 5: 2.0 < S <= S_CLIP_MAX  COLOR-CLASSIFIED (reverse spillage) ---
            % Check if high-stretch pixels incorrectly render as teal under LOG scale.
            nexttile;
            seg5 = Svals(Svals > 2.0 & Svals <= cax_hi);
            edges5 = 2.0:max(0.1, (cax_hi-2.0)/35):cax_hi;
            seg5_safe = max(seg5, cax_lo);
            tvals5 = (log(seg5_safe) - log(cax_lo)) / max(eps, (log(cax_hi) - log(cax_lo)));
            tvals5 = min(1, max(0, tvals5));
            R5 = 0.0 *(1-tvals5).^2 + 0.129*2.*tvals5.*(1-tvals5) + 0.993*tvals5.^2;
            B5 = 0.35*(1-tvals5).^2 + 0.692*2.*tvals5.*(1-tvals5) + 0.144*tvals5.^2;
            teal_mask5 = (R5 <= B5);
            seg5_teal   = seg5(teal_mask5);
            seg5_yellow = seg5(~teal_mask5);

            counts_teal5   = histcounts(seg5_teal,   edges5);
            counts_yellow5 = histcounts(seg5_yellow, edges5);
            centers5 = 0.5*(edges5(1:end-1)+edges5(2:end));
            hb5 = bar(centers5, [counts_teal5; counts_yellow5]', ...
                      'stacked', 'BarWidth', 1.0, 'EdgeColor','none');
            hb5(1).FaceColor = [0.20 0.45 0.85];   % teal-side -> blue bar
            hb5(2).FaceColor = [0.95 0.55 0.10];   % yellow-side -> orange bar
            hold on;
            xline(SParams.S_THR, '-', 'Color',[0 0 0], 'LineWidth',1.4, ...
                  'Label','S=2.0','LabelHorizontalAlignment','right');
            xlim([2.0 cax_hi]); grid on;
            xlabel('S level'); ylabel('pixel count');
            title(sprintf('2.0<S<=%.1f by rendered color  yellow=%d  blue-spill=%d', ...
                          cax_hi, numel(seg5_yellow), numel(seg5_teal)));
            legend({'blue-spill (R<=B)','yellow-side (R>B)'}, ...
                   'Location','northeast','FontSize',8);

            sgtitle(sprintf('Cycle %d: S-level distributions  (total valid=%d)  log-caxis=[%.2f, %.2f]', ...
                    it, numel(Svals), cax_lo, cax_hi), 'FontWeight','bold');
            drawnow;
            save_cycle_figure(figH,    "S_histograms", it);

            % ---- PER-CYCLE BLOB MAP (mirrors final blob figure 7001) ----
            figBlob = figure(fignum(8000, it, KEEP_FIGS_PER_CYCLE)); clf;
            set(figBlob,'Color','w','Position',[100 60 1100 950], ...
                'Name', sprintf('Cycle %d: S-field + numbered low-stretch blobs', it));
            hImB = imagesc(Sfine_final);
            set(hImB,'AlphaData', double(maskFine_final));
            axis image off;
            colormap(gca, cmap_blue_yellow); colorbar;
            apply_log_S_cmap(gca, SParams.S_CLIP_MAX);

            % Everything about the blobs here -- the count in the title, the
            % coloured patches, the numbering and the quoted areas -- comes
            % from CC_low_meas, the components of the MEASURED lattice. Only
            % the S heatmap and the S_THR contour behind them are display
            % resolution.
            %
            % These were briefly two different sets: the title quoted the
            % measured count while the overlay numbered the components of the
            % full-resolution display mask, so the figure showed "N blobs" over
            % several hundred numbered labels, with A_k in raw display pixels
            % and never converted through cellArea. Same defect as counting the
            % picture in the first place, just moved into the annotation.
            nB_cyc = numel(CC_low_meas);
            title(sprintf(['cycle %d: s_1(x_N,y_N)  |  S_{THR}=%.1f  |  Nwin=%d  |  ' ...
                           '%d blobs measured at %d px  (%.3f of frame)  |  ' ...
                           '%d largest labelled'], ...
                          it, SParams.S_THR, Nw, n_low_blobs_fullres(it), ...
                          SParams.FIELD_STEP, frac_blue(it), ...
                          min(n_low_blobs_fullres(it), TOPK_BLOB_LABELS)));
            hold on;
            % S=S_THR boundary
            contour(Sfine_final, [SParams.S_THR SParams.S_THR], 'w', 'LineWidth', 1.5);

            % sort blobs by area (largest first) and overlay numbered labels
            if nB_cyc > 0
                step_c = SParams.FIELD_STEP;
                areas_cyc = cellfun(@numel, CC_low_meas(:));      % lattice cells
                [areas_sorted, sort_idx] = sort(areas_cyc, 'descend');
                cmap_blobs_cyc = lines(max(nB_cyc,1));
                [Hc, Wc] = size(blueC);                           % lattice dims

                % build a single label image: cell value = blob rank (1..nB_cyc)
                if nB_cyc < 65535
                    label_img = zeros(Hc, Wc, 'uint16');
                else
                    label_img = zeros(Hc, Wc, 'uint32');
                end
                for k = 1:nB_cyc
                    label_img(CC_low_meas{sort_idx(k)}) = k;
                end
                blob_mask_all = label_img > 0;
                rgb_overlay = ind2rgb(label_img, [0 0 0; cmap_blobs_cyc]);
                % lattice image over a full-resolution axis: place it on the
                % pixels it represents, as fig 7001 does
                hBk = image(rgb_overlay, ...
                            'XData', [1, (Wc-1)*step_c + 1], ...
                            'YData', [1, (Hc-1)*step_c + 1]);
                set(hBk,'AlphaData', 0.35 * double(blob_mask_all));
                clear rgb_overlay label_img blob_mask_all;

                % numbered text labels on the largest blobs only. Every
                % component still gets its coloured patch above -- that is one
                % image call -- but a text object per component means ~5,700
                % three-line labels with background boxes stacked on top of
                % each other at FIELD_STEP = 1, most of them reading "1px".
                nLab = min(nB_cyc, TOPK_BLOB_LABELS);
                for k = 1:nLab
                    idx_lin_k = CC_low_meas{sort_idx(k)};
                    [ry_k, rx_k] = ind2sub([Hc Wc], idx_lin_k);
                    cx_k = (mean(rx_k)-1)*step_c + 1;   % lattice -> pixel
                    cy_k = (mean(ry_k)-1)*step_c + 1;
                    A_k  = areas_sorted(k) * cellArea;  % cells -> px^2
                    r_eq_k = sqrt(A_k / pi);
                    text(cx_k, cy_k, ...
                         sprintf('#%d\n%dpx\nr=%.1f', k, A_k, r_eq_k), ...
                         'Color','w','FontSize',7,'FontWeight','bold', ...
                         'HorizontalAlignment','center','VerticalAlignment','middle', ...
                         'BackgroundColor',[0 0 0 0.4]);
                end
            end
            hold off; drawnow;
            save_cycle_figure(figBlob, "blob_map", it);

        end
    else
        Sfine_final = []; maskFine_final = [];
    end

    % ---- (C) LOW-STRETCH yellow dots + optional overlay of the S-field ----
    if SHOW_LOW_STRETCH_DOTS
        Pnow = SParams;
        Pnow.Nwin = Nw;

        % dots from your robust voting scheme
        [xyLow, xyHigh, sLow, sHigh, stats] = Smap_dots_snapshot(dp_x_hist, row0, Tau, Pnow, rows, cols);

        % Save the numerical dot information used by the overlay
        xyLow_history{it}  = single(xyLow);
        xyHigh_history{it} = single(xyHigh);
        dotStats_history{it} = stats;

        % ============ FIGURE: S-field at CURRENT (FINAL) locations on kick-drift map ============
        if ~isempty(Sfine_final)
            figC = figure(fignum(4000, it, KEEP_FIGS_PER_CYCLE)); clf;
            set(figC,'Color','w','Position',[100 100 900 900], ...
                'Name', sprintf('Cycle %d: S-field at CURRENT locations (on kick-drift)', it));

            imshow(stage2_img, []);
            axis image off;
            hold on;

            % overlay S-field remapped to final (current) positions
            h3 = imagesc(Sfine_final);
            set(h3,'AlphaData', SParams.FIELD_ALPHA * maskFine_final);
            colormap(figC, cmap_blue_yellow);
            colorbar;
            apply_log_S_cmap(gca, SParams.S_CLIP_MAX);

            % contour at S = S_THR on the final-location field
            contour(Sfine_final, [SParams.S_THR SParams.S_THR], 'w', 'LineWidth', 1.1);

            % MAGENTA overlay: S > S_THR last cycle, S <= S_THR now
            if SHOW_Y2B_MAGENTA && any(y2bMask_final(:))
                overlay_mask_rgb(y2bMask_final, [1 0 1], ...
                                 min(0.60, SParams.TRANS_ALPHA + 0.10));
            end

            % BANDED DOTS: each dot colored by its S-band
            if SHOW_DOTS_ON_S_FIELD
                plot_banded_dots([xyLow; xyHigh], [sLow; sHigh], dot_cmap);
            end

            % the probe counts belong in the title only when the probes are
            % actually on the picture
            ttl4000 = sprintf(['cycle %d: S-field at CURRENT locations ' ...
                               '(S_{THR}=%.2f) | Nwin=%d'], ...
                              it, Pnow.S_THR, Pnow.Nwin);
            if SHOW_DOTS_ON_S_FIELD
                ttl4000 = sprintf('%s | probes: low=%d, stretched=%d of %d', ...
                                  ttl4000, stats.n_low, stats.n_high, stats.n_probes);
            end
            title(ttl4000);

            hold off;
            drawnow;
            save_cycle_figure(figC,    "S_on_kick_drift", it);
        end

        % store for next cycle comparison
        S_prev_final    = Sfine_final;
        mask_prev_final = maskFine_final;

        % MEMORY: drop this cycle's heavy temporaries before the next
        % iteration allocates its own.
        %
        % CC_low_cycle used to be built here too -- a second get_CC_full over
        % the full-resolution blueMask, holding one index list per component
        % at 1920x1920. Once the figure labels the measured components it has
        % no reader, so the pass is gone rather than merely freed; CC_low_meas
        % does the same job on the lattice at 1/FIELD_STEP^2 the size.
        clear blueMask yellowMask

    end

    % ============ FIGURE: ZOOM PROBE GRIDS ============
    % One figure per window, gated only by ZOOM.ENABLE: the probes are
    % measured directly at their own positions, so this needs neither the
    % dot pipeline nor the S-field lattice and stays exact whatever
    % FIELD_STEP is set to.
    if ZOOM.ENABLE && ~isempty(ZOOM.WINDOWS)
        for wIdx = 1:size(ZOOM.WINDOWS, 1)
            [nKeptZ, figZ, nTotZ, spZ] = zoom_probe_figure( ...
                fignum(9000 + 100*wIdx, it, KEEP_FIGS_PER_CYCLE), ...
                sprintf('Cycle %d: zoom probe grid %d', it, wIdx), ...
                stage2_img, ZOOM.WINDOWS(wIdx,:), ZOOM, ...
                dp_x_hist, row0, Tau, rows, cols, t0_recent, Nw, ...
                dot_cmap, dot_band_labels, ...
                sprintf('cycle %d zoom %d', it, wIdx));

            save_cycle_figure(figZ, sprintf("zoom_probes_w%d", wIdx), it);
            fprintf('  zoom %d: %d of %d probes in band (spacing %d px)\n', ...
                    wIdx, nKeptZ, nTotZ, spZ);
        end
    end
end

