% ===================== NEW FIGURES: exponential/log decay starting at the actual intersection cycle =====================
% We find where frac_blue and frac_yellow intersect.
% Then we plot starting at that ACTUAL cycle value cStar, without shifting the x-axis.
%
% So if the intersection is at cStar = 2.4, then the x-axis starts at 2.4,
% and the later data points remain at cycles 3,4,5,...

dBY = frac_blue - frac_yellow;
iCross = find(dBY(1:end-1).*dBY(2:end) <= 0, 1, 'first');

if isempty(iCross)
    warning('No blue/yellow intersection found. Using cycle 1 as start.');
    cStar  = 1;
    iStart = 1;
else
    c1 = iCross;
    c2 = iCross + 1;

    d1 = dBY(c1);
    d2 = dBY(c2);

    % linear interpolation for the crossing location
    if abs(d2 - d1) < 1e-12
        cStar = c1;
    else
        cStar = c1 - d1*(c2 - c1)/(d2 - d1);
    end

    % start the real sampled data at the first full cycle after the crossing
    iStart = c2;
end

fprintf('\n');
fprintf('Blue/yellow intersection estimated at cycle c* = %.4f\n', cStar);
fprintf('Using actual cycle axis starting at c* = %.4f\n', cStar);
% The window length is Nw = min(Nwin, it) and the window start is
% t0 = max(0, it - Nw). So for it <= Nwin the cycle index IS the window
% length N, with t0 pinned at 0; beyond that N saturates at Nwin and t0
% starts sliding instead. Those are two different independent variables,
% and the kick sequence is i.i.d. in t0, so the second regime is flat by
% construction. Fitting an exponential across both is meaningless, so the
% fit is capped at Nwin.
iEnd = min(cycles, SParams.Nwin);
if cycles > SParams.Nwin
    warning(['cycles (%d) exceeds Nwin (%d): cycles %d-%d vary the window ' ...
             'START t0 at fixed N=%d, not the window LENGTH, and are flat by ' ...
             'construction. Restricting the decay fit to cycles %d-%d.'], ...
            cycles, SParams.Nwin, SParams.Nwin+1, cycles, SParams.Nwin, iStart, iEnd);
end
if iEnd - iStart < 1
    warning('Fit window is cycles %d-%d: fewer than 2 points.', iStart, iEnd);
end
fprintf('Fitting window lengths N = %d to %d (t_0 pinned at 0 throughout).\n', iStart, iEnd);

%% ------------------------------------------------------------------------
%%  Figure 6500: LOW-STRETCH AREA (area_blue_px) using ACTUAL cycle axis
%% ------------------------------------------------------------------------
xA = (iStart:iEnd)';            % actual cycle numbers (N-varying regime only)
yA = area_blue_px(iStart:iEnd);

goodA = isfinite(xA) & isfinite(yA) & (yA > 0);

% ---- uncertainty on each area point ----
% The low-stretch set is spatially correlated, so pixels are nowhere near
% independent samples. Treating them as independent understates the error by
% a factor of ~31 here: measured across 12 kick realisations the scatter in
% the area fraction was 0.0129, while a per-pixel binomial predicts 0.00042.
%
% The correct count is the number of independent CORRELATION PATCHES. For a
% field with correlation C(r) = exp(-r/xi) the integral correlation area is
%     A_c = \int C(|r|) d^2r = 2*pi*xi^2,
% so n_eff = A_valid / (2*pi*xi^2) and sigma_p = sqrt(p(1-p)/n_eff). Checked
% against the same 12 realisations: predicted 0.0172 against a measured
% 0.0129, i.e. conservative by ~30% rather than wrong by 30x. xi comes from
% this cycle's own measured correlation, so the bars widen as the field
% filaments and the patches shrink.
sigLogA = nan(cycles,1);
for iq = 1:cycles
    if isfinite(xi_rad(iq)) && xi_rad(iq) > 0 && isfinite(frac_blue(iq)) ...
            && frac_blue(iq) > 0 && frac_blue(iq) < 1 && area_total_px(iq) > 0
        n_eff      = area_total_px(iq) / (2*pi*xi_rad(iq)^2);
        sig_p      = sqrt(frac_blue(iq)*(1-frac_blue(iq)) / max(n_eff,1));
        sigLogA(iq) = sig_p / frac_blue(iq);       % d(log A) = dp/p
    end
end
eA = sigLogA(iStart:iEnd);
eA(~isfinite(eA) | eA <= 0) = NaN;
% points with no usable sigma still get fitted, at the median weight
eA(isnan(eA)) = median(eA(~isnan(eA)));
if all(isnan(eA)), eA(:) = 1; end

if nnz(goodA) >= 2
    wA = 1 ./ eA(goodA).^2;
    [kA, bA, skA, sbA, R2A] = wls_line(xA(goodA), log(yA(goodA)), wA);
    pA = [kA bA];
    logyA_fit = kA*xA(goodA) + bA;
    yA_fit    = exp(logyA_fit);

    A0A  = exp(bA);
    tauA = -1 / kA;
    stauA = skA / kA^2;                 % d(-1/k) = dk/k^2
else
    pA = [NaN NaN];
    logyA_fit = [];
    yA_fit    = [];
    kA = NaN; bA = NaN; A0A = NaN; tauA = NaN;
    skA = NaN; sbA = NaN; R2A = NaN; stauA = NaN;
end

fprintf(['Low-stretch area fit: slope k = %.4f +- %.4f per cycle | ' ...
         'tau = %.3f +- %.3f cycles | R^2 = %.4f\n'], ...
        kA, skA, tauA, stauA, R2A);

% interpolated value exactly at the intersection cycle
yA_cross = interp1(1:cycles, area_blue_px, cStar, 'linear', 'extrap');

figure(6500); clf;
set(gcf,'Color','w','Position',[120 100 1150 430], ...
    'Name','Low-stretch area decay starting at actual blue/yellow intersection cycle');
tiledlayout(1,2,'TileSpacing','compact','Padding','compact');

% --- left: semilogy plot ---
nexttile;
semilogy(cStar, yA_cross, 'ks', 'MarkerFaceColor','y', 'MarkerSize',8); hold on;
semilogy(xA(goodA), yA(goodA), 'o-', 'LineWidth',1.5);
if nnz(goodA) >= 2
    semilogy(xA(goodA), yA_fit, '--', 'LineWidth',1.8);
    legend('intersection', 'data', ...
           sprintf('exp fit: A = %.3e exp(%.3f N)', A0A, kA), ...
           'Location','best');
else
    legend('intersection', 'data', 'Location','best');
end
grid on;
xlabel('window length  N  (= cycle index while t_0 is pinned at 0)');
ylabel('low-stretch area (pixels)');
title('Low-stretch area decay vs window length N (semilogy)');
xlim([cStar cycles]);

% --- right: linearized log plot, with error bars and the fitted slope ---
nexttile;
plot(cStar, log(yA_cross), 'ks', 'MarkerFaceColor','y', 'MarkerSize',8); hold on;
errorbar(xA(goodA), log(yA(goodA)), eA(goodA), 'o', ...
         'LineWidth',1.3, 'MarkerFaceColor','auto', 'CapSize',5);
if nnz(goodA) >= 2
    plot(xA(goodA), logyA_fit, '--', 'LineWidth',1.8);
    % +-1 sigma band on the fitted LINE (slope and intercept errors, no
    % covariance term -- this is a visual guide, the quoted numbers are exact)
    xb = linspace(min(xA(goodA)), max(xA(goodA)), 50)';
    sb_line = sqrt((skA*xb).^2 + sbA^2);
    plot(xb, kA*xb + bA + sb_line, ':', 'Color',[0.6 0.6 0.6], 'LineWidth',1.0);
    plot(xb, kA*xb + bA - sb_line, ':', 'Color',[0.6 0.6 0.6], 'LineWidth',1.0);
    legend('intersection', 'log(data) \pm 1\sigma', ...
           sprintf('WLS fit: slope = %.4f \\pm %.4f', kA, skA), ...
           '\pm1\sigma on fit', 'Location','best');
else
    legend('intersection', 'log(data)', 'Location','best');
end
grid on;
xlabel('window length  N');
ylabel('log(low-stretch area)');
title({sprintf('Linearised decay: log A = %.4f N %+.3f   (R^2 = %.4f)', ...
               kA, bA, R2A), ...
       sprintf(['slope %.4f \\pm %.4f per cycle   |   tau = %.2f \\pm %.2f cycles' ...
                '   |   half-life %.2f'], ...
               kA, skA, tauA, stauA, log(2)*abs(tauA))}, 'FontSize', 10);
xlim([cStar cycles]);

% Figure 6501 used to repeat this fit on total_low_blob_area_px_fullres.
% That series is sum(cellfun(@numel, CC_low_meas)) * cellArea, and
% get_CC_full applies no size filter, so the components partition blueC
% exactly and the sum is identically nnz(blueC)*cellArea = area_blue_px. It
% was the same fit on the same numbers in a second window. Asserted here so
% that if a size filter is ever added -- a reasonable thing to want, given
% how many components are single cells -- the two stop being interchangeable
% loudly rather than silently.
assert(all(isnan(total_low_blob_area_px_fullres) | ...
           total_low_blob_area_px_fullres == area_blue_px), ...
       ['total_low_blob_area_px_fullres has diverged from area_blue_px; ' ...
        'the blob decomposition no longer partitions blueC.']);

fprintf('Low-stretch area fit: A = %.6e * exp(%.6f * N)\n', A0A, kA);

%% ------------------------------------------------------------------------
%%  Figure 6800: DISTRIBUTION OF LOW-STRETCH BLOB AREAS ACROSS CYCLES
%% ------------------------------------------------------------------------
% The total area vs cycle (fig 6100) says how much low-stretch material there
% is. This says how it is DIVIDED, which is a different story and the one that
% shows fragmentation. Measured on this system the blob-area distribution
% spans 3 to 5.5 decades, so the bins are logarithmic -- on linear bins the
% whole distribution is one bar.
%
% Both weightings are shown because they disagree about what matters:
%   by COUNT, the distribution is dominated by single-cell specks,
%   by AREA,   it is dominated by the few largest blobs.
% At N=2 the single biggest blob holds 52% of all low-stretch area and nothing
% is in blobs under 4 px; by N=12 the biggest holds 2.6% and 11% of the area
% has broken into sub-4 px fragments. That migration IS the fragmentation.
haveB = find(~cellfun(@isempty, blob_area_history(:)'));
if ~isempty(haveB)
    allA = vertcat(blob_area_history{haveB});
    aMin = max(1, min(allA));
    aMax = max(max(allA), aMin*10);   % keep the log edges strictly increasing
    nBin = 28;
    edges = logspace(log10(aMin), log10(aMax*1.0001), nBin+1);
    ctrs  = sqrt(edges(1:end-1).*edges(2:end));

    Hcnt = zeros(numel(haveB), nBin);   % blobs per bin
    Har  = zeros(numel(haveB), nBin);   % share of that cycle's area per bin
    for q = 1:numel(haveB)
        a = blob_area_history{haveB(q)};
        Hcnt(q,:) = histcounts(a, edges);
        bi = discretize(a, edges);
        bi(~isfinite(bi)) = nBin;            % clamp the top edge, never NaN
        bi = min(max(bi,1), nBin);
        wsum = accumarray(bi, a, [nBin 1])';
        if sum(wsum) > 0, Har(q,:) = wsum / sum(wsum); end
    end

    figure(6800); clf;
    set(gcf,'Color','w','Position',[80 80 1500 470], ...
        'Name','Distribution of low-stretch blob areas across cycles');
    tiledlayout(1,3,'TileSpacing','compact','Padding','compact');
    cmapC = parula(max(numel(haveB),2));

    nexttile;
    for q = 1:numel(haveB)
        stairs(edges(1:end-1), Hcnt(q,:), 'LineWidth',1.4, 'Color',cmapC(q,:));
        hold on;
    end
    set(gca,'XScale','log','YScale','log'); grid on;
    xlabel('blob area (px^2)'); ylabel('number of blobs');
    title('By COUNT: dominated by specks');
    cb1 = colorbar; cb1.Label.String = 'cycle';
    if haveB(end) > haveB(1), caxis([haveB(1) haveB(end)]); end

    nexttile;
    for q = 1:numel(haveB)
        stairs(edges(1:end-1), Har(q,:), 'LineWidth',1.4, 'Color',cmapC(q,:));
        hold on;
    end
    set(gca,'XScale','log'); grid on;
    xlabel('blob area (px^2)'); ylabel('share of that cycle''s low-stretch area');
    title('By AREA: dominated by the few largest');
    cb2 = colorbar; cb2.Label.String = 'cycle';
    if haveB(end) > haveB(1), caxis([haveB(1) haveB(end)]); end

    nexttile;
    imagesc(1:nBin, haveB, log10(max(Hcnt,0.1)));
    set(gca,'YDir','normal'); colormap(gca, parula); cb3 = colorbar;
    cb3.Label.String = 'log_{10} blobs per bin';
    xt = round(linspace(1,nBin,6));
    set(gca,'XTick',xt,'XTickLabel',compose('%.0f', ctrs(xt)));
    xlabel('blob area (px^2)'); ylabel('cycle');
    title('Fragmentation map: cycle vs area');

    fprintf('\nLow-stretch blob-area distribution:\n');
    fprintf('  %-6s %-8s %-9s %-9s %-11s %-11s %s\n', ...
            'cycle','nblobs','median','p90','max','top1 %area','%area <4px');
    for q = 1:numel(haveB)
        a = blob_area_history{haveB(q)};
        tot = sum(a);
        fprintf('  %-6d %-8d %-9.0f %-9.0f %-11.0f %-10.1f%% %.1f%%\n', ...
                haveB(q), numel(a), median(a), pct_nt(a,90), max(a), ...
                100*max(a)/tot, 100*sum(a(a < 4))/tot);
    end
end

