%% ------------------------------------------------------------------------
%%  Figure 6700: HAZARD RATE h(N)
%% ------------------------------------------------------------------------
% The shape is the physics, not the value:
%   flat      -> memoryless. Every survivor faces the same risk each step,
%                regardless of how long it has already lasted.
%   declining -> heterogeneity. The fragile are removed early and a hardier
%                subpopulation is left behind. This is persistent structure.
%   rising    -> wear-out. Damage accumulates and survivors get more fragile.
%
% TWO curves are plotted because they do not agree, and only one is a hazard.
% h_gross follows the SAME MATERIAL (the tracer lattice) and is the genuine
% conditional dropout P(leaves by N | present at N-1). h_net = 1 - f(N)/f(N-1)
% is the net change in set size, which is what the area series alone can see;
% it equals the hazard only if the low-stretch set is nested in N, and it is
% not -- material re-enters, so the set is refilled and the net decline
% understates the gross dropout.
if LAG.ENABLE && any(isfinite(haz_gross))
    iEndH = min(cycles, SParams.Nwin);
    if cycles > SParams.Nwin
        fprintf(['Hazard: showing cycles 1-%d only; past Nwin the analysis ' ...
                 'window slides off t_0 = 0 and the tracers stop describing ' ...
                 'the field.\n'], iEndH);
    end
    Nh = (2:iEndH)';
    hg = haz_gross(Nh);  hn = haz_net(Nh);
    rr = haz_reent(Nh);  np = haz_nprev(Nh);

    % binomial error on the gross hazard, using independent correlation
    % patches rather than tracers (same n_eff argument as the area fit)
    ehg = nan(size(hg));
    for q = 1:numel(Nh)
        iq = Nh(q);
        if isfinite(xi_rad(iq)) && xi_rad(iq) > 0 && isfinite(np(q)) && np(q) > 0
            n_eff_h = (np(q)*LAG.STEP^2) / (2*pi*xi_rad(iq)^2);
            ehg(q)  = sqrt(max(hg(q)*(1-hg(q)),0) / max(n_eff_h,1));
        end
    end

    figure(6700); clf;
    set(gcf,'Color','w','Position',[120 100 1150 430], ...
        'Name','Hazard rate h(N): flat = memoryless, declining = structure');
    tiledlayout(1,2,'TileSpacing','compact','Padding','compact');

    nexttile;
    errorbar(Nh, hg, ehg, 'o-', 'LineWidth',1.8, 'CapSize',5); hold on;
    plot(Nh, hn, 's--', 'LineWidth',1.3);
    okh = isfinite(hg) & isfinite(ehg) & ehg > 0;
    if nnz(okh) >= 2
        wh    = 1./ehg(okh).^2;
        hbar  = sum(wh.*hg(okh))/sum(wh);            % best flat hazard
        [kh, ~, skh] = wls_line(Nh(okh), hg(okh), wh);
        yline(hbar, 'k:', sprintf('flat h = %.3f', hbar), 'LineWidth',1.4);
        verdict = 'memoryless (flat)';
        if kh - 2*skh > 0
            verdict = 'RISING: wear-out';
        elseif kh + 2*skh < 0
            verdict = 'DECLINING: heterogeneity';
        end
        title({sprintf('Hazard h(N) = P(out at N | in at N-1)   [%s]', verdict), ...
               sprintf('trend %.4f \\pm %.4f per cycle   (flat within %.1f\\sigma)', ...
                       kh, skh, abs(kh)/max(skh,eps))}, 'FontSize', 10);
        fprintf(['\nHazard: gross h = %.4f (flat estimate), trend %.4f +- %.4f ' ...
                 'per cycle -> %s\n'], hbar, kh, skh, verdict);
    else
        title('Hazard h(N)');
    end
    grid on;
    xlabel('window length  N');
    ylabel('per-step conditional dropout');
    legend('h_{gross}: same material \pm1\sigma', ...
           'h_{net} = 1 - f(N)/f(N-1)', 'Location','best');
    ylim([0 1]);

    nexttile;
    plot(Nh, 100*rr, 'o-', 'LineWidth',1.6); hold on;
    grid on;
    xlabel('window length  N');
    ylabel('re-entrants  (% of the low set at N)');
    title({'Why the two curves differ: material RE-ENTERS the low set', ...
           'nested survival would sit at 0% -- h_{net} is not a hazard'}, ...
          'FontSize', 9);

    % The tracers index material by INITIAL condition while the field indexes
    % it by FINAL position. The map is area preserving, so the two must report
    % the same low-stretch fraction; printing both is a live check that the
    % tracer lattice really is describing the same population as the field.
    fprintf('\n  %-5s %-11s %-11s %-13s %-9s %-9s %s\n', ...
            'N','h_gross','h_net','re-entrants','f_tracer','f_field','n_prev');
    for q = 1:numel(Nh)
        fprintf('  %-5d %-11.4f %-11.4f %-12.1f%% %-9.5f %-9.5f %d\n', ...
                Nh(q), hg(q), hn(q), 100*rr(q), ...
                haz_f(Nh(q)), frac_blue(Nh(q)), np(q));
    end
end

%% ========================================================================
%%  E)  FINAL FULL-RESOLUTION BLOB ANALYSIS
%%      Runs once after the last cycle on the finest available S-field.
%%
%%  Per-blob outputs
%%  ----------------
%%  blob_area    : pixel count
%%  blob_frac    : fraction of total valid S-field pixels
%%  blob_cx/cy   : centroid in image (col, row) coordinates (1-based)
%%  blob_xmin/xmax/ymin/ymax : tight bounding box
%%  blob_r_eq    : equivalent radius   r_eq = sqrt(A/pi)
%%  blob_compact : compactness         C    = 4*pi*A / P^2
%%                 (C=1 for a perfect circle; smaller = more irregular)
%%
%%  Written outputs
%%  ---------------
%%  blob_summary.txt - full ranked table including all fields above.
%% ========================================================================
fprintf('\n');
fprintf('=============================================================\n');
fprintf('  FINAL FULL-RESOLUTION BLOB ANALYSIS  (after %d cycles)\n', cycles);
fprintf('=============================================================\n');

%% -- S-field on the final window --
% This used to call Sfield_snapshot again. Its arguments are identical to the
% last in-loop call by construction: there Tcur = cycles, Nw = min(Nwin,
% cycles) and t0 = max(0, cycles - Nw), and here Tcur_fin = numel(dp_x_hist)
% = cycles gives exactly the same three values. Sfield_snapshot is
% deterministic, so it recomputed 57,600 monodromies to reproduce a field the
% loop had already produced. Reuse it.
Tcur_fin = numel(dp_x_hist);
Nw_fin   = min(SParams.Nwin, Tcur_fin);
t0_fin   = max(0, Tcur_fin - Nw_fin);
if SHOW_S_FIELD_FIG && exist('Sfine_final','var') && ~isempty(Sfine_final)
    assert(isequal([Nw_fin, t0_fin], [Nw, t0_recent]), ...
           'Final window differs from the last cycle''s; reuse would be invalid.');
    Sfin    = Sfine_final;
    maskFin = maskFine_final;
    Scfin   = Scoarse;
    maskCfin= maskC;
else
    fprintf('Computing S-field on the final window ...\n');
    [Sfin, maskFin, Scfin, maskCfin] = Sfield_snapshot(dp_x_hist, row0, Tau, rows, cols, ...
                                      t0_fin, Nw_fin, SParams);
end

% Same split as the per-cycle path: the summary is measured on the lattice
% that was actually evaluated, and Sfin is kept only to draw fig 7001.
% Thresholding Sfin here reported a low-stretch fraction ~5x too small,
% because smoothing and linear upsampling both erode the low set inward
% (see Sfield_snapshot for the measurements).
step_fin  = SParams.FIELD_STEP;
cellA_fin = step_fin^2;

valid_fin     = maskCfin & isfinite(Scfin);
low_mask_fin  = valid_fin & (Scfin <= SParams.S_THR);
high_mask_fin = valid_fin & (Scfin >  SParams.S_THR);

% areas reported in full-resolution px^2; fractions are the lattice estimate
tot_valid  = nnz(valid_fin) * cellA_fin;
tot_low    = nnz(low_mask_fin) * cellA_fin;
tot_high   = nnz(high_mask_fin) * cellA_fin;
frac_low_f = nnz(low_mask_fin)  / max(1, nnz(valid_fin));
frac_high_f= nnz(high_mask_fin) / max(1, nnz(valid_fin));

%% -- connected components on the measured lattice --
fprintf('Running connected-component analysis on the measured lattice ...\n');
CC_final = get_CC_full(low_mask_fin, SParams.BLOB_CONN);
nF       = numel(CC_final);
fprintf('  Found %d low-stretch blob(s) at %d px sampling.\n', nF, step_fin);

%% -- compute per-blob statistics --
[H_im, W_im] = size(low_mask_fin);

blob_area    = zeros(nF,1);
blob_frac    = zeros(nF,1);
blob_cx      = zeros(nF,1);
blob_cy      = zeros(nF,1);
blob_xmin    = zeros(nF,1);
blob_xmax    = zeros(nF,1);
blob_ymin    = zeros(nF,1);
blob_ymax    = zeros(nF,1);
blob_r_eq    = zeros(nF,1);
blob_compact = zeros(nF,1);

for k = 1:nF
    idx_lin  = CC_final{k};
    [ry, rx] = ind2sub([H_im, W_im], idx_lin);
    A_cell = numel(idx_lin);            % in lattice cells
    A      = A_cell * cellA_fin;        % in full-resolution px^2

    % lattice index i sits at pixel (i-1)*step + 1
    blob_area(k)  = A;
    blob_frac(k)  = A / max(1, tot_valid);
    blob_cx(k)    = (mean(rx)-1)*step_fin + 1;
    blob_cy(k)    = (mean(ry)-1)*step_fin + 1;
    blob_xmin(k)  = (min(rx)-1)*step_fin + 1;  blob_xmax(k) = (max(rx)-1)*step_fin + 1;
    blob_ymin(k)  = (min(ry)-1)*step_fin + 1;  blob_ymax(k) = (max(ry)-1)*step_fin + 1;
    blob_r_eq(k)  = sqrt(A / pi);

    % perimeter-based compactness  C = 4*pi*A / P^2.
    % Computed in lattice units and left there: under a change of scale
    % A -> A*s^2 and P -> P*s, so C is scale-invariant and needs no conversion.
    %
    % Cropped to the blob's bounding box. This used to allocate a full
    % H_im x W_im logical per blob and run four full-frame comparisons over
    % it. At FIELD_STEP = 1 that is a 3.7 MB allocation plus ~15 MB of traffic
    % for every component, and by cycle 12 there are ~5,700 of them, 60% being
    % a single pixel whose perimeter is 4. compute_perimeter pads with
    % background on all four sides, so the pixels just outside the box read as
    % background either way and the crop is exactly equivalent -- verified
    % over 3,000 random blobs including ones touching the frame edge, zero
    % mismatches. Cost now scales with the blob, not with the frame.
    r0 = min(ry); r1 = max(ry);
    c0 = min(rx); c1 = max(rx);
    BW_blob = false(r1-r0+1, c1-c0+1);
    BW_blob(sub2ind(size(BW_blob), ry-r0+1, rx-c0+1)) = true;
    P = compute_perimeter(BW_blob);
    if P > 0
        blob_compact(k) = 4*pi*A_cell / P^2;
    else
        blob_compact(k) = NaN;
    end
end

%% -- sort blobs by area (largest first) --
[blob_area, si] = sort(blob_area, 'descend');
blob_frac       = blob_frac(si);
