%  kick_drift_plus_Smap_each_cycle_separate.m
%  ----------------------------------------------------------------------
%  WHAT YOU WANT NOW (FINAL):
%   For EVERY cycle, show:
%     (1) BEFORE
%     (2) AFTER KICK
%     (3) AFTER DRIFT
%     (4) BIG FIGURE: ONLY low-stretch YELLOW DOTS (S <= 2) for that cycle
%     (5) BIG FIGURE: "S magnitude vs where we started"
%         -> heatmap of S(x0,y0) + colorbar + (optional) contour line S=2
%
%  CORE MATH:
%   • NO stable/unstable anymore.
%   • Compute Nwin-step monodromy M (exact, chain rule).
%   • Stretch metric: S = sigma_max(M) = largest singular value.
%   • Criterion: S > 2  -> stretched
%               S <= 2 -> low-stretch (tube/disk survives over the window)
%
%  IMPORTANT DISPLAY CHOICE:
%   • Contour *lines* alone look like squiggles (level sets).
%   • To see magnitude, we plot a filled heatmap (imagesc) + colorbar,
%     and optionally overlay only ONE contour: S = 2.
% ========================================================================

clear;
clc;
close all;

randomSeed = 0;
rng(randomSeed,'twister');

%% ---------- A) make the initial image (dotted grid + 3 bands) ----------
n = 40;
f = figure('Units','inches','Position',[1 1 12 12],'Color','w');
ax = axes('Parent', f);

[Xp,Yp] = meshgrid(0:n+1, 0:n+1);
plot(ax, Xp, Yp, 'ko', 'MarkerSize', 4, 'MarkerFaceColor', 'k', 'LineStyle', 'none');
hold(ax,'on');

axis(ax,'equal'); xlim(ax,[0 n+1]); ylim(ax,[0 n+1]); axis(ax,'off');

rectangle(ax, 'Position', [0, n/2 + 2.5,  n+1, 1], 'FaceColor','r', 'EdgeColor','none');
rectangle(ax, 'Position', [0, n/2 - 0.5,  n+1, 1], 'FaceColor','g', 'EdgeColor','none');
rectangle(ax, 'Position', [0, n/2 - 3.5,  n+1, 1], 'FaceColor','b', 'EdgeColor','none');

set(ax,'Units','normalized','Position',[0 0 1 1],'LooseInset',[0 0 0 0]);
exportgraphics(f, 'init_image.png', 'Resolution', 160);
close(f);

%% ---------- B) Kick–drift simulation + S-map ----------
img0 = im2double(imread('init_image.png'));
if max(img0(:))>1.5, img0 = img0/255; end
if size(img0,3)==1, img0 = cat(3,img0,img0,img0); end
if size(img0,3)==4, img0 = img0(:,:,1:3); end

[rows, cols, ~] = size(img0);
if mod(rows,2), img0 = img0(2:end,:,:); end
if mod(cols,2), img0 = img0(:,2:end,:); end
[rows, cols, ~] = size(img0);

% -------------------- dynamics parameters --------------------
cycles = 12;
row0   = rows/2;
lc     = 0.05;
K0     = 0.025;
Tau0   = 0.5;
Lx=1.0; Lp=1.0;

% ---- physical <-> pixel conversion ----
% The image is a picture of phase space: row y carries momentum p, column x
% carries position X, with
%     y = row0 + p*rows/Lp        X = x*Lx/cols
% Substituting those into the physical map
%     kick   p' = p + K0*u(X)
%     drift  X' = X + Tau0*p'
% gives the pixel map used by ForwardFullStep:
%     K   = K0*rows/Lp                 (momentum -> rows)
%     Tau = Tau0*Lp*cols/(Lx*rows)     (momentum -> columns, per drift step)
%
% Tau previously read (Tau0*Lx*rows)/(cols*Lp) -- both the Lx/Lp and the
% rows/cols ratios inverted. Because K*Tau is the ONLY combination the
% dynamics depends on (put eta = Tau*(y-row0) and the map becomes the
% standard map  eta' = eta + K*Tau*u(x),  x' = x + eta'), that error made
% the physics scale as rows^2/(cols*Lp^2) when it must not depend on rows or
% Lp at all -- those are display and normalisation choices. The corrected
% form gives K*Tau = K0*Tau0*cols/Lx, with rows and Lp cancelling exactly.
%
% At the settings this script ships with (square 1920x1920 image, Lx=Lp=1)
% both forms evaluate to Tau=0.5, so this changes no existing result; it is
% a trap that springs the moment the image is non-square or Lx/Lp move off 1.
K   = K0/Lp * rows;
Tau = (Tau0*Lp*cols)/(Lx*rows);

% The dynamics depends on exactly two dimensionless numbers. Neither may
% contain rows, cols, Lp or the export resolution; if a result moves when
% those change, something is still mis-converted.
kappa   = K0*Tau0*cols/Lx;    % = K*Tau, the standard-map parameter
epsilon = K0*Tau0/(Lx*lc);    % shear injected per kick / drift's own shear
assert(abs(K*Tau - kappa) < 1e-9*max(1,kappa), ...
       'K*Tau (%.6g) disagrees with kappa (%.6g): unit conversion is inconsistent.', ...
       K*Tau, kappa);
fprintf('Dynamics: kappa = K*Tau = %.4f | epsilon = K0*Tau0/(Lx*lc) = %.4f\n', ...
        kappa, epsilon);
% Pure drift alone (u=0) has M_N = [[1, N*Tau],[0,1]] and sigma_max =
% (b+sqrt(b^2+4))/2 with b = N*Tau, which reaches 2 at b = 1.5 exactly. With
% Tau=0.5 that is cycle 3, so with S_THR=2 nothing can stay "low-stretch"
% past cycle 3 unless the kick partially cancels the drift shear -- worth
% remembering when reading the decay fit, whose window starts there.
fprintf('Pure-drift sigma_max reaches %.2f at N = %.2f cycles (b = N*Tau = 1.5).\n', ...
        2.0, 1.5/Tau);

xgrid = linspace(-0.5, 0.5, cols);
c_x   = exp(-(xgrid.^2)/(lc^2));
cf_x  = randpot1d_getFFT(c_x);

% history
n_frames = 0;   % frame counter (frames themselves are not retained)
dp_x_hist = {};

% -------------------- display toggles --------------------
SHOW_PANELS_EACH_CYCLE = true;
SHOW_LOW_STRETCH_DOTS  = true;

% "S magnitude vs start" plot per cycle
SHOW_S_FIELD_FIG       = true;

% overlay S field on the dot figure (semi-transparent)
OVERLAY_S_FIELD_ON_DOTS = true;

% magenta overlay: material that dropped from S > S_THR to S <= S_THR
% Banded probe dots scattered over the whole-frame S-field composite
% (fig 4000). Off: at these densities they cover the S-field they are drawn
% on without adding anything it does not already show, and the zoom probe
% grids give the same measurement over a region you choose, on a regular
% lattice, at a spacing you choose. The probes are still computed and still
% saved to cycleData; this only stops them being painted over fig 4000.
SHOW_DOTS_ON_S_FIELD = false;

SHOW_Y2B_MAGENTA = true;
SParams.TRANS_ALPHA = 0.45;    % transparency for the magenta overlay

% MEMORY: with KEEP_FIGS_PER_CYCLE=false every cycle REUSES one window per
% figure kind, so the session holds ~6 figures instead of 6*cycles. Each
% figure retains its image CData (~1920x1920 RGB is tens of MB), so keeping
% one per cycle is what exhausts memory on longer runs. Set true only for
% short runs where you want every cycle side by side.
KEEP_FIGS_PER_CYCLE = false;

% -------------------- S-map params --------------------
SParams.Nwin      = 12;        % target window length; early cycles auto smaller
SParams.PITCH_YX  = [12 12];   % probe lattice spacing
SParams.JITTER_FR = 0.8;       % jitter as fraction of pitch

% No longer read. The monodromy is built as a product of per-step Jacobians
% whose determinants are identically 1, so det M = 1 by construction and the
% probe guard tests isfinite(M) instead. Recomputing det from the stored M
% would only measure float64 cancellation: median |det-1| is ~1e-15 at N=12,
% but on the most-stretched points at N=40 it reaches 1.6e-2 -- past this
% tolerance -- while S there is exact to 0.0000%, so the test would discard
% good measurements for a rounding artefact.
%
% Under the old finite-difference monodromy it rejected 0.7% of probes at
% N=12, 17.6% at N=25 and 39.5% at N=40, all of it cancellation and none of
% it a property of the dynamics.
SParams.DET_TOL = 5e-3;        % UNUSED (see above); kept so saved metadata stays comparable
SParams.S_THR   = 2.0;         % your criterion: S <= 2 is low-stretch

% dots deposited at START (because you want S vs where we started)
SParams.DEPOSIT_AT_FINAL = true;

% -------- S-field (magnitude map) settings (this makes the contour plot clean) -----
% FIELD_STEP sets the lattice S is measured on; cost scales as step^-2.
% 1 measures every pixel, so nothing about the S-field is reconstructed: the
% measured field and the displayed field become the same object, blobs are
% resolved exactly, and there is no sampling error left to argue about. It is
% affordable now only because the sweep is vectorised and the monodromy is
% closed form; under the old scalar loop with an svd per point this setting
% was ~3.7M function calls per cycle.
%
% Above 1, step is a PRECISION knob and not an accuracy one -- the lattice
% fraction is unbiased at every step tested (see Sfield_snapshot). Over 40
% kick realisations the per-run scatter about that run's own 1 px truth was
%     step 2: 0.0002    step 8: 0.0015    step 32: 0.0110
%     step 4: 0.0005    step 16: 0.0042
% against a fraction of ~0.056, i.e. +-0.9% relative at step 4, +-2.7% at
% step 8, +-20% at step 32. Raise it to 2 or 4 if a run is tight on time; the
% headline number barely moves, and only the smallest components are lost.
SParams.FIELD_STEP        = 1;     % 1 = measure every pixel, no reconstruction
% Smoothing is a DISPLAY choice and is applied in log S, to the display copy
% only -- never to the values that get thresholded or counted. 0 disables it.
% It was 1.0 and was applied, in linear S, to the field that everything was
% measured from, which alone deleted 83% of the low-stretch cells.
SParams.FIELD_SMOOTH_SIG  = 0;     % display-only smoothing, in "grid cells", on log S
SParams.FIELD_ALPHA       = 0.28;  % transparency when overlaying on the image
SParams.S_CLIP_MAX        = 15;    % color scale upper cap for display (logarithmic, so high S compressed)

% Contours: to avoid spaghetti, default is ONLY the threshold contour S=2
SParams.SHOW_ONLY_THR_CONTOUR = true;

% -------------------- ZOOM PROBE GRIDS --------------------
% A fixed lattice of probe points over a chosen window. Each probe measures S
% exactly at its own position and is drawn in its S band's colour; probes whose
% S falls in no band (S > 3.0, or a rejected monodromy) are not drawn at all.
%
% The lattice is REGULAR, with no jitter. Smap_dots_snapshot deliberately
% jitters its probes by JITTER_FR of the pitch, which is right for an unbiased
% estimate over the whole frame -- an unjittered lattice can beat against
% structure in S -- but wrong for reading a specific region, where you want the
% same points every cycle so two cycles can be compared dot for dot.
ZOOM.ENABLE = true;

% One row per window: [row0 col0 height width], 1-based pixel coordinates of
% the displayed frame. height/width ARE the zoom resolution, so 400 400 is a
% 400x400 px region.
%
% A window is always shown as a plain rectangle of the frame. If it will not
% fit, the size is capped at the frame and the origin is pulled back until the
% whole extent is inside, with a warning naming the window actually used --
% [1 1 rows cols] is the whole frame, and anything larger resolves to it.
% Windows used to wrap on the torus instead, which pasted the far side of the
% frame onto the near side: [761 761 1980 1980] on a 1920x1920 frame put rows
% 1921-2740 back at rows 1-820, so the bottom of the picture appeared sliced
% off and stacked above the top.
% An optional 5th column sets that window's own probe spacing; without it
% every window uses ZOOM.SPACING. A whole-frame view and a 400x400 view want
% very different densities, so the defaults differ here.
ZOOM.WINDOWS = [   1    1 rows cols  8 ; ...   % whole frame, uncropped
                 761  761  2100  2100  1];

% Default probe spacing in pixels for windows that do not set their own:
% 1 = every pixel in the window, 2 = every other, 4, 8, ...
% Cost is (height*width)/spacing^2 monodromies per window per cycle. 400x400
% at spacing 1 is 160,000, about 4% of one full-frame S-field sweep; the whole
% frame at spacing 8 is 57,600. Spacing does not bias WHICH probes survive --
% measured 9.7%, 9.8%, 9.7%, 9.7% of probes in band at spacing 1, 2, 4, 8 --
% it only sets how densely the surviving structure is sampled.
ZOOM.SPACING = 2;

% Dot size in points. Large windows need a smaller marker: at whole-frame
% extent with fine spacing the dots will otherwise cover the picture they sit
% on, which is the failure mode that made the scattered dots on fig 4000 not
% worth keeping.
ZOOM.MARKER     = 12;
ZOOM.SHOW_IMAGE = true;    % draw the kick-drift frame behind the dots

% -------------------- HAZARD TRACER --------------------
% A lattice of fixed INITIAL conditions carrying its own running monodromy,
% advanced one step per cycle. It exists to answer a question the area series
% cannot: of the material that was low-stretch at N-1, how much leaves by N?
%
% The naive hazard h(N) = 1 - f(N)/f(N-1) is only that conditional rate if
% {S_N <= S_THR} is NESTED in N. It is not. sigma_max(M_N) is not monotone in
% N for a symplectic map -- rotation can undo stretching -- and measured on
% this system, material RE-ENTERS the low-stretch set at a rate rising from
% 2% of it at N=2 to 26% at N=12. The two disagree badly, and in the
% direction that matters:
%
%   N     f(N)    1 - f/f_prev    true P(out|in)    re-entrants
%   2   0.5929       0.361            0.375            2.2%
%   6   0.1899       0.192            0.342           18.6%
%   9   0.0988       0.132            0.345           24.6%
%  12   0.0519       0.187            0.398           26.0%
%
% The naive curve falls from 0.36 to ~0.19 and reads as a DECLINING hazard,
% which would be evidence of a hardy subpopulation. The true conditional
% dropout is flat at ~0.38, which is memoryless. Net decline is smaller than
% gross dropout because re-entrants keep refilling the set, so the naive
% formula answers the annealed-vs-quenched question backwards. Both are
% plotted; the gross rate is the one carrying the physics.
%
% Cost is one map step per cycle over the lattice -- the running monodromy
% means it never re-integrates history -- so this is negligible next to the
% S-field sweep.
% This lattice is the LAGRANGIAN field. It is seeded once on a regular grid of
% initial conditions and accumulated forward, so S is indexed by SEED position
% and the same array element means the same parcel at every cycle. Stored as
% cycleData.S_start and overlaid on img0.
%
% It does NOT replace Sfield_snapshot, and neither can be derived from the
% other. The Lagrangian sweep does carry each parcel's final position, so the
% Eulerian field is in principle "that data re-addressed" -- but those final
% positions are a scattered filamentary cloud, and resampling a scattered
% cloud onto a regular grid means interpolating, which is exactly the pipeline
% that was deleting 85% of the low-stretch set. Getting a regular grid of
% CURRENT positions without interpolating requires starting on that grid and
% integrating backward. So: both, always.
%
%   S_start   seed position    overlay img0         same-parcel statistics
%   S_now     final position   overlay stage2_img   where the material is now
%
% What actually needs S_start is narrower than it looks. Measured on a 960^2
% seed lattice over 12 cycles and 5 kick realisations, the two framings agree
% on the low-stretch AREA FRACTION to within 0.0062 worst case -- they must,
% since the map is area preserving -- and their coherence lengths converge
% (74.1 vs 65.2 px at N=1, 17.0 vs 17.7 px at N=12). So the survival curve and
% xi do not need it. What genuinely does is the HAZARD, which asks whether the
% SAME parcel left the low-stretch set, a question no Eulerian field can
% answer because a fixed pixel holds different material each cycle.
%
% Memory: 6 state arrays plus one stored field per cycle. At STEP = 2 that is
% ~44 MB of state and ~44 MB of storage for 12 cycles. STEP = 1 is exact but
% costs 177 MB + 177 MB, which this script has historically not had spare.
LAG.ENABLE = true;
LAG.STEP   = 2;    % seed lattice spacing in px (2 -> 960x960 parcels)

% -------------------- COHERENCE LENGTH --------------------
% xi(N): the separation at which the spatial autocorrelation of log S falls to
% 1/e. Measured radially and along each axis, so the anisotropy is visible --
% that is the filamentation signal area alone cannot show. On this system xi
% falls from ~45 px at N=1 to ~17 px at N=12 while the field goes from
% elongated along y (xi_x/xi_y = 0.49) to near isotropic (1.07).
%
% The correlation is close to exponential over the first 1/e of decay
% (measured R^2 0.80-0.999, typically >0.96), so the fitted decay constant is
% reported alongside the crossing; the crossing is the headline because it
% needs no fit. R^2 is reported so a cycle where the exponential is a poor
% description is visible rather than silent.
XI.ENABLE   = true;
XI.MAX_LAG  = 128;   % largest separation examined, px

% ---- DOT colours, one per S band (see dot_band_index for the bands) ----
% Hoisted out of the per-cycle loop: these are constants, and the zoom probe
% figures need them too.
dot_cmap = [...
    0.00 1.00 1.00;   % 1: cyan            (S < 1.5)
    0.40 1.00 0.00;   % 2: lime green      (1.5 <= S < 1.8)
    1.00 0.65 0.00;   % 3: neon orange     (1.8 <= S <= 2.0)
    0.55 0.27 0.07;   % 4: brown           (2.0 <  S <= 2.2)
    1.00 0.00 0.00;   % 5: bright red      (2.2 <  S <  2.5)
    0.00 0.70 0.80];  % 6: teal            (2.5 <= S <= 3.0)
dot_band_labels = {'S < 1.5','1.5 - 1.8','1.8 - 2.0', ...
                   '2.0 - 2.2','2.2 - 2.5','2.5 - 3.0'};

% Custom colormap: dark cyan -> teal -> yellow
nCmap = 256;
t = linspace(0, 1, nCmap)';
cmap_blue_yellow = [ 0.0*(1-t).^2 + 0.129*2.*t.*(1-t) + 0.993*t.^2, ...
                     0.25*(1-t).^2 + 0.566*2.*t.*(1-t) + 0.906*t.^2, ...
                     0.35*(1-t).^2 + 0.692*2.*t.*(1-t) + 0.144*t.^2 ];


y2b_area_px = zeros(cycles,1);
y2b_frac    = zeros(cycles,1);

S_prev_final    = [];
mask_prev_final = [];



cur = img0;

% -------------------- EXTRA ANALYSIS (AREA + BLOBS) --------------------
% Define which is "blue" vs "yellow" in the S-field
% (This is just analysis naming; it does NOT change your colormap.)
SParams.BLUE_IS_LOW  = true;      % blue-region = (S <= S_THR)
SParams.BLOB_CONN    = 4;         % 4-connected blobs (use 8 if you want)
% BLOB_STEP is no longer used. Blob counting now runs on the FIELD_STEP
% lattice, which is already the sampled grid; decimating that a second time
% only discarded resolution the monodromies had been paid for.
SParams.BLOB_STEP    = 4;         % UNUSED (see above); kept so saved metadata stays comparable

% per-cycle totals from the FULL Sfine grid (exact totals)
area_blue_px   = nan(cycles,1);
area_yellow_px = nan(cycles,1);
frac_blue      = nan(cycles,1);
frac_yellow    = nan(cycles,1);

% per-cycle blob counts + blob size stats (computed on downsampled grid)
n_blue_blobs   = nan(cycles,1);
n_yellow_blobs = nan(cycles,1);

mean_blue_blob_area_px   = nan(cycles,1);
mean_yellow_blob_area_px = nan(cycles,1);

med_blue_blob_area_px    = nan(cycles,1);
med_yellow_blob_area_px  = nan(cycles,1);

max_blue_blob_area_px    = nan(cycles,1);
max_yellow_blob_area_px  = nan(cycles,1);
% -------------------- ranked low-stretch blob areas per cycle --------------------
% The "_fullres" suffix is about UNITS, not sampling: every *_area_px_* below
% is in full-resolution px^2. The components themselves are found on the
% FIELD_STEP lattice, because that is where S was actually measured -- so
% n_low_blobs_fullres is a count of components resolved at FIELD_STEP, and
% components smaller than one lattice cell are not in it. Areas are robust to
% that (the components >= 64 px hold ~94% of the low-stretch area); the bare
% count is not, so read it as bookkeeping rather than as physics.
TOPK_LOW_BLOBS = 5;

% How many blobs get a text label on the blob figures, and how many rows the
% console table prints. Both figures used to label every component and the
% table printed every row. At FIELD_STEP = 1 that is ~5,700 three-line text
% objects with background boxes per figure, drawn on top of each other and
% mostly reading "#5213 / 1px / r=0.6", plus ~5,700 lines of console fprintf
% per run. Blobs are ranked by area, so the first few carry essentially all
% of it (the 13 largest hold 82%); the rest are threshold specks.
% blob_summary.txt still gets every row -- only the screen is capped.
TOPK_BLOB_LABELS  = 20;    % text labels drawn on figs 7001 and 8000
TOPN_BLOB_CONSOLE = 50;    % rows printed to the console table

n_low_blobs_fullres              = nan(cycles,1);
total_low_blob_area_px_fullres   = nan(cycles,1);
largest_low_blob_area_px_fullres = nan(cycles,1);
top3_low_blob_area_px_fullres    = nan(cycles,1);
top5_low_blob_area_px_fullres    = nan(cycles,1);

low_blob_rank_area_px_fullres = nan(cycles, TOPK_LOW_BLOBS);

% Every blob's area, per cycle, for the distribution figure. Only aggregate
% statistics were kept before, which cannot show a distribution spanning 3-5
% decades. Cheap: a few thousand doubles per cycle.
blob_area_history = cell(cycles,1);

% -------------------- ADD-ON: store full SVD of monodromy --------------------

cycleData = matfile("full_cycle_data.mat", "Writable", true);

% Preallocate directly on disk
cycleData.S(rows,cols,cycles) = single(0);
cycleData.mask(rows,cols,cycles) = false;
cycleData.y2bMask(rows,cols,cycles) = false;

%simulation_data
runMetadata = struct();

