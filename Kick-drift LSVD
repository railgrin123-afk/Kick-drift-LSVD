% ===================== NEW FIGURES: exponential/log decay starting at the actual intersection cycle =====================
% We find where frac_blue and frac_yellow intersect.
% Then we plot starting at that ACTUAL cycle value cStar, without shifting the x-axis.
%
% So if the intersection is at cStar = 2.4, then the x-axis starts at 2.4,
% and the later data points remain at cycles 3,4,5,...

dBY = frac_blue - frac_yellow;
iCross = find(dBY(1:end-1).*dBY(2:end) <= 0, 1, 'first');

if isempty(iCross)
    warning('No blue/yellow intersection found. Using cycle 1 as start.');
    cStar  = 1;
    iStart = 1;
else
    c1 = iCross;
    c2 = iCross + 1;

    d1 = dBY(c1);
    d2 = dBY(c2);

    % linear interpolation for the crossing location
    if abs(d2 - d1) < 1e-12
        cStar = c1;
    else
        cStar = c1 - d1*(c2 - c1)/(d2 - d1);
    end

    % start the real sampled data at the first full cycle after the crossing
    iStart = c2;
end

