function F = randpot1d_getFFT(c)
    f = fft(ifftshift(c(:).'));
    F = complex(sqrt(abs(f)),0);
end

function u = randpot1d_four(cf)
    n = numel(cf);
    if n < 4, u = zeros(n,1); return; end
    p = (2*rand(1, floor(n/2)-1) - 1)*pi;
    phase = zeros(1,n);
    lo = 2:(n/2);
    hi = (n/2+2):n;
    % Hermitian symmetry: mode k and its conjugate partner n-k must carry
    % OPPOSITE phases. Using +fliplr(p) here gave them the SAME phase, which
    % is even symmetry -- every mode collapsed to a zero-offset cosine, so
    % dp_x came out exactly mirror-symmetric about x=0 and x=n/2 with the
    % realized correlation C(x-x')+C(x+x') instead of the stationary C(x-x').
    if ~isempty(lo), phase(lo) =  p; end
    if ~isempty(hi), phase(hi) = -fliplr(p); end
    cff = cf(:).' .* exp(1i*phase);
    cff(1) = 0;
    u = sqrt(n)*ifft(cff); u = real(u);
    s = std(u); if s<1e-12, s=1e-12; end
    u = (u/s).'; u = u(:);
end

function Rp = InverseKick_vert(coords, args)
    dp_x = args.dp_x(:); n = numel(dp_x);
    y = coords(:,1); x = coords(:,2);

    x0 = floor(x); i0 = mod(x0, n); i1 = mod(i0+1, n);
    fx = x - x0;
    dpy = dp_x(i0+1) + (dp_x(i1+1)-dp_x(i0+1)).*fx;

    Rp = coords;
    Rp(:,1) = y - dpy;
end

function Rp = InverseFullStep(coords, args)
    dp_x = args.dp_x(:); n = numel(dp_x);
    row0 = args.row0; Tau = args.Tau;

    y1 = coords(:,1);
    x1 = coords(:,2);

    x  = x1 - Tau*(y1 - row0);

    x0 = floor(x); i0 = mod(x0,n); i1 = mod(i0+1,n);
    fx = x - x0;
    dpy = dp_x(i0+1) + (dp_x(i1+1)-dp_x(i0+1)).*fx;

    y  = y1 - dpy;

    Rp = [y, x];
end

function Rp = ForwardFullStep(coords, args)
    dp_x = args.dp_x(:); n = numel(dp_x);
    row0 = args.row0; Tau = args.Tau;

    y = coords(:,1);
    x = coords(:,2);

    x0 = floor(x); i0 = mod(x0,n); i1 = mod(i0+1,n);
    fx = x - x0;
    dpy = dp_x(i0+1) + (dp_x(i1+1)-dp_x(i0+1)).*fx;

    y1 = y + dpy;
    x1 = x + Tau*(y1 - row0);

    Rp = [y1, x1];
end

function out = warp_image(image, map_func, map_args)
    [rows, cols, ch] = size(image);
    img = im2double(image);

    [cc, rr] = meshgrid(0:cols-1, 0:rows-1);
    coords = [rr(:), cc(:)];
    mapped = feval(map_func, coords, map_args);

    ys = mod(mapped(:,1), rows);
    xs = mod(mapped(:,2), cols);

    y0=floor(ys); x0=floor(xs);
    y1=mod(y0+1,rows); x1=mod(x0+1,cols);
    fy=ys-y0; fx=xs-x0;

    y0p=y0+1; y1p=y1+1; x0p=x0+1; x1p=x1+1;
    idx00=sub2ind([rows,cols],y0p,x0p);
    idx01=sub2ind([rows,cols],y0p,x1p);
    idx10=sub2ind([rows,cols],y1p,x0p);
    idx11=sub2ind([rows,cols],y1p,x1p);

    w00=(1-fy).*(1-fx); w01=(1-fy).*fx; w10=fy.*(1-fx); w11=fy.*fx;

    out = zeros(rows,cols,ch);
    for k=1:ch
        P=img(:,:,k);
        v=w00.*P(idx00)+w01.*P(idx01)+w10.*P(idx10)+w11.*P(idx11);
        out(:,:,k)=reshape(v,rows,cols);
    end
end

% ------------------- LOW-STRETCH DOTS (your robust voting version) -------------------
function [xyLow, xyHigh, sLow, sHigh, stats] = Smap_dots_snapshot(dp_x_hist, row0, Tau, P, H, W)
% Sparse markers at the final positions of a jittered probe lattice, each
% carrying the S measured at that probe. One monodromy per probe, one pass,
% and the probes are emitted as a list rather than rasterised into H x W
% accumulators.
%
% The t0 vote is gone. It ran the whole probe sweep once per t0 in
% t0_list = linspace(span-(V-1), span, V) with V = min(VOTE_T0, span+1) and
% span = T - Nwin, accumulated low_votes/high_votes/S_sum/S_cnt over H x W,
% and kept pixels whose vote density reached KEEP_FRAC. Three problems:
%
%   * It could not average anything at the shipped settings. While
%     cycles <= Nwin, span = 0, so V = 1 -- a single pass, and the vote
%     reduced to "keep what one pass found".
%   * The moment cycles exceeds Nwin it switches on, and the cost of this
%     overlay jumps with it: span reaches VOTE_T0-1 by cycle Nwin+4, so the
%     probe sweep runs 5 times instead of once. Nothing warned about the step.
%   * Even when it did run, neighbouring t0 windows share Nwin-1 of their
%     kicks, so it averaged five samples that are ~92% the same measurement.
%     The axis that would actually reduce variance is independent kick
%     realisations, not adjacent start times.
%
% Rasterising also cost 4 H x W double accumulators (~118 MB at 1920x1920)
% and merged probes landing in the same pixel, which discarded ~0.3% of them
% and did so preferentially where stretching piles material onto filaments.
% Emitting the list keeps every probe and its sub-pixel position.

Nwin = min(P.Nwin, numel(dp_x_hist));
T    = numel(dp_x_hist);
if T < 1 || Nwin < 1
    xyLow = zeros(0,2); xyHigh = zeros(0,2);
    sLow  = zeros(0,1); sHigh  = zeros(0,1);
    stats = struct('n_low',0,'n_high',0,'n_probes',0,'n_rejected',0);
    return;
end

t0 = max(0, T - Nwin);          % most recent window

pitch_y = P.PITCH_YX(1);
pitch_x = P.PITCH_YX(2);
ys = floor(pitch_y/2) : pitch_y : (H-1);
xs = floor(pitch_x/2) : pitch_x : (W-1);
[Xg, Yg] = meshgrid(xs, ys);
nP = numel(Xg);

jy = (2*rand(nP,1)-1) * P.JITTER_FR * pitch_y;
jx = (2*rand(nP,1)-1) * P.JITTER_FR * pitch_x;
py = mod(Yg(:) + jy, H);
px = mod(Xg(:) + jx, W);

% One vectorised sweep instead of nP scalar monodromy calls.
% exact monodromy: det is 1 by construction, so the only real failure mode
% is overflow. See Sfield_snapshot for why the determinant is not tested.
[sAll, xN, yN] = monodromy_S_vec(py, px, t0, Nwin, dp_x_hist, Tau, row0);

if P.DEPOSIT_AT_FINAL
    x_dep = xN;      y_dep = yN;
else
    x_dep = px;      y_dep = py;
end
xyAll = [mod(x_dep, W) + 1, mod(y_dep, H) + 1];
xyAll(~isfinite(sAll), :) = NaN;

ok     = isfinite(sAll);
isLow  = ok & (sAll <= P.S_THR);
isHigh = ok & (sAll >  P.S_THR);

xyLow  = xyAll(isLow, :);   sLow  = sAll(isLow);
xyHigh = xyAll(isHigh,:);   sHigh = sAll(isHigh);

stats = struct('n_low', nnz(isLow), 'n_high', nnz(isHigh), ...
               'n_probes', nP, 'n_rejected', nnz(~ok));
end

function [Sfine_final, maskFine_final, Scoarse, maskC] = Sfield_snapshot(dp_x_hist, row0, Tau, H, W, t0, Nwin, P)
% Stretching field S on a regular grid of FINAL (current) positions.
%
% Each grid point is integrated BACKWARD Nwin steps to its initial
% condition, then the forward monodromy is run along that orbit. S therefore
% lands exactly on the regular grid with no scattered interpolation at all.
%
% This replaces a forward remap: a regular grid was placed at the START,
% pushed forward, and S rebuilt at final positions with
% scatteredInterpolant(...,'natural','nearest'). Measured against exact
% backward integration at Nwin=12 on this system, that pipeline
%   * misclassified 43% of the true low-stretch set at the S<=2 threshold
%     (low-stretch fraction 0.034 against a true 0.055), and reported 387
%     blobs where there are 892; median error 21% of S;
%   * had to bridge huge gaps exactly where S is largest: the map is
%     area-preserving with median sigma_max ~10 at Nwin=12, so an 8 px cell
%     arrives as roughly 78 px x 0.8 px and the samples are filamentary.
%     The map also folds, so Delaunay neighbours at final time can come from
%     unrelated initial conditions and interpolating between them invents
%     values;
%   * triangulated mod-wrapped coordinates, so it saw no periodicity and
%     grew skinny triangles inward from all four edges.
%
% The mask is now real. scatteredInterpolant with 'nearest' extrapolation
% never returns NaN, so the old maskFine_final was true on all H*W pixels and
% the DET_TOL check had no effect downstream: rejected probes were silently
% filled in by their neighbours, and tot_valid was just rows*cols. Here a
% rejected probe stays NaN and stays masked.
%
% Cost is unchanged -- one monodromy per grid point either way; the backward
% pass is N cheap scalar steps against the monodromy's single trajectory.
% InverseFullStep is an exact closed-form inverse (round trip measured at
% 2.5e-10 px over 12 steps), so the recovered initial condition is exact.
%
% Scoarse/maskC are returned so statistics can be taken on the probe grid
% that was actually evaluated. Sfine_final is upsampled for DISPLAY only;
% anything finer than FIELD_STEP in it is reconstruction, not measurement.

step = P.FIELD_STEP;
ys = 1:step:H;          % these are FINAL positions now, not start positions
xs = 1:step:W;
ny = numel(ys); nx = numel(xs);

Scoarse = nan(ny, nx);
maskC   = false(ny, nx);
T       = numel(dp_x_hist);
Nw      = floor(Nwin);

% ---- blocked vectorised sweep over the lattice ----
% This was a scalar for iy / for ix with a monodromy function call per point.
% At FIELD_STEP = 1 that is 3.69M calls per cycle, each running its own
% interpreted Nwin-step loop; the call and loop overhead, not the arithmetic,
% is what made a fine lattice impractical.
%
% Blocked rather than fully vectorised on purpose. One array per quantity over
% the whole 1920x1920 lattice is 29.5 MB, and the sweep needs x, y, the four
% monodromy entries and ~7 per-step temporaries live at once -- ~400 MB before
% MATLAB's own expression temporaries, on a script that has already had to be
% rescued from out-of-memory failures. A block of 5e5 points holds the working
% set near 60 MB and still amortises the interpreter completely: the speedup
% is set by vector length, and 5e5 is far past the point where that saturates.
nTot = ny*nx;
blk  = min(nTot, 5e5);

for p0 = 1:blk:nTot
    idx = (p0 : min(nTot, p0+blk-1)).';

    % column-major lattice index -> 0-based pixel coordinates.
    % ys(iy) = 1 + (iy-1)*step, so the 0-based coordinate is (iy-1)*step.
    iy = mod(idx-1, ny);
    ix = (idx-1 - iy) / ny;
    y  = iy * step;
    x  = ix * step;

    % ---- exact backward integration to the initial condition ----
    % undoing  Yc = y + dp(x);  Xc = x + Tau*(Yc - row0)
    for k = Nw-1 : -1 : 0
        dp = dp_x_hist{mod(t0 + k, T) + 1};
        n  = numel(dp);
        x  = x - Tau*(y - row0);
        xf = floor(x);
        i0 = mod(xf, n);
        d0 = dp(i0+1);
        y  = y - (d0 + (dp(mod(i0+1, n)+1) - d0) .* (x - xf));
    end

    % ---- forward monodromy along that orbit ----
    % The guard tests FINITENESS, not the determinant. det M = 1 holds by
    % construction, so re-deriving it from the stored M only measures
    % float64 cancellation -- the same defect the exact Jacobian removed.
    % At N=40 that residual reaches 1.6e-2 on the most-stretched points,
    % past DET_TOL, while S there is still exact to 0.0000%; testing it
    % would throw away good measurements for a rounding artefact.
    % Overflow is the one real failure mode and isfinite catches it.
    Sblk = monodromy_S_vec(y, x, t0, Nwin, dp_x_hist, Tau, row0);

    ok = isfinite(Sblk);
    Scoarse(idx(ok)) = Sblk(ok);
    maskC(idx)       = ok;            % rejected points stay NaN -- a real mask
end

% Scoarse and maskC stay RAW from here on: they are the values actually
% measured, and they are what every NUMBER must be computed from. Smoothing
% and upsampling below build a picture, and a picture must not be counted.
%
% Why this matters -- both operations bias the low-stretch set one way only.
% S is log-normal here (measured on this system at N=12: mean log S = 2.45,
% sd 1.21, skew(S) = 7.3, arithmetic/geometric mean ratio 2.35). Gaussian
% smoothing takes an ARITHMETIC mean, and for a log-normal that overestimates
% the typical value by exp(sigma^2/2). The error is not symmetric at the
% threshold: a low island sits at S ~ 1.8 inside a chaotic sea at S ~ 10-100,
% so averaging over the boundary is dominated by the large neighbour and eats
% the island inward, while a chaotic cell next to an island barely moves
% because the island's values are small. Measured on the coarse grid at
% sigma = 1 cell: 83.1% of low cells were pushed ABOVE the threshold, and
% 0.0% of high cells were pulled below it -- pure erosion of the low set.
%
% Linear interpolation in the upsample has the same defect for the same
% reason. Between a sample at S = 1.8 and its neighbour at S = 50, a straight
% line crosses S = 2 after 0.4% of the cell, so the reconstructed island is a
% sliver around each low sample.
%
% Together, thresholding the smoothed+upsampled field reported a low-stretch
% fraction of 0.012 against a true 0.059 -- it deleted 85% of the real
% low-stretch pixels while inventing almost none (1.9% of what it flagged),
% which is exactly the "regions that should be low-stretch shown as
% high-stretch" complaint. Median |dS|/S was 52% over the frame and 147% on
% the true low-stretch set.
%
% Sampling itself is NOT the problem. The fraction of lattice points with
% S <= thr is an unbiased estimator of the area fraction of {S <= thr} for a
% statistically homogeneous field: coarsening adds variance, never bias.
% Measured bias against the 1 px truth over 40 kick realisations, as
% mean +- standard error of the mean:
%     step  2: -0.00003 +- 0.00003    step 16: -0.00038 +- 0.00066
%     step  4: -0.00008 +- 0.00008    step 32: +0.00084 +- 0.00175
%     step  8: -0.00016 +- 0.00024
% |t| < 1 at every step, so none of them is distinguishable from zero -- step
% 32 included, where a single run can land 0.011 away and look like a
% breakdown while the ensemble mean sits at +0.0008. Coarsening costs
% precision, not accuracy. So the
% headline area fraction is correct at ANY FIELD_STEP once it is taken from
% Scoarse; step size buys precision and blob morphology, not accuracy.

% ---- smooth + upsample to full resolution, for DISPLAY ONLY ----
% Regular grid to regular grid: ordinary separable interpolation, no
% triangulation and no seam. NaNs propagate, so the mask survives.
%
% Both the smoothing and the interpolation happen in LOG S, whose geometric
% mean is the unbiased centre for a log-normal, so the contour drawn on the
% picture stays nearer the measured one instead of retreating inside it. It
% also matches the rendering: apply_log_S_cmap puts this on a log colour
% scale, so interpolating the log is what makes the COLOUR interpolate
% linearly between samples. log is safe here -- for a 2x2 with det = 1,
% sigma1*sigma2 = 1 and sigma1 >= sigma2, so S = sigma_max >= 1 exactly.
%
% This narrows the gap but does not close it (measured: thresholding the
% reconstruction recovers 62% of the true low-stretch fraction at step 8 with
% linear interpolation, 69% with log). The remainder is real sub-cell
% structure that no interpolator can recover, which is the whole reason the
% numbers come from Scoarse and not from here.
if ~any(maskC(:))
    Sfine_final    = nan(H, W, 'single');
    maskFine_final = false(H, W);

elseif step == 1 && P.FIELD_SMOOTH_SIG <= 0
    % At FIELD_STEP = 1 the lattice IS the full grid, so there is nothing to
    % reconstruct: interpolating would resample a grid onto itself, and the
    % measured field and the displayed field are the same object. Skip it --
    % it saves a 3.7M-point interp2 and the log/exp round trip per cycle.
    Sfine_final    = single(Scoarse);
    maskFine_final = maskC;

else
    Ldisp = log(Scoarse);
    if P.FIELD_SMOOTH_SIG > 0
        Ldisp = smooth2_gaussian_nan(Ldisp, maskC, P.FIELD_SMOOTH_SIG);
    end

    Sfine_final = zeros(H, W, 'single');
    xrow = min(max(1:W, xs(1)), xs(end));      % clamp: no NaN strip at the far edge
    blk  = max(1, floor(2e6 / max(W,1)));
    for r0b = 1:blk:H
        r1b  = min(H, r0b + blk - 1);
        yrow = min(max(r0b:r1b, ys(1)), ys(end));
        [Xb, Yb] = meshgrid(xrow, yrow);
        Sfine_final(r0b:r1b, :) = single(exp(interp2(xs, ys, Ldisp, Xb, Yb, 'linear')));
    end
    maskFine_final = isfinite(Sfine_final);
end
end

function Sout = smooth2_gaussian_nan(Sin, mask, sigma_cells)
% NaN-aware Gaussian smoothing using conv2 (no toolboxes required).
if sigma_cells <= 0
    Sout = Sin; return;
end

% build 1D gaussian kernel
rad = max(1, ceil(3*sigma_cells));
x = (-rad:rad);
g = exp(-(x.^2)/(2*sigma_cells^2));
g = g / sum(g);

Sin0 = Sin; Sin0(~mask) = 0;
W0   = double(mask);

% separable convolution
num = conv2(conv2(Sin0, g, 'same'), g', 'same');
den = conv2(conv2(W0,   g, 'same'), g', 'same');

Sout = num ./ max(den, 1e-12);
Sout(den < 0.15) = NaN;  % if we had almost no data support, keep it NaN
end

% monodromy_to_Smax (one svd() per point) and monodromy_to_rotation are gone.
% The svd is now the closed form inside monodromy_S_vec; monodromy_to_rotation
% had no callers.

% --------- Dynamics / monodromy backend (vertical-kick) ---------

function dpy = interp_kick_x(x, dp_x)
n = numel(dp_x);
x0=floor(x); i0=mod(x0,n); i1=mod(i0+1,n);
fx=x-x0;
dpy = dp_x(i0+1) + (dp_x(i1+1)-dp_x(i0+1))*fx;
end

function [S, xN, yN] = monodromy_S_vec(y0, x0, t0, N, dp_hist, Tau, row0)
% Exact monodromy by the chain rule, vectorised over a column of initial
% conditions, returning sigma_max and the final positions. Replaces a
% 5-trajectory central difference (base, +-eps in x, +-eps in y).
%
% One step of the map is
%     Yc = y + f(x)
%     Xc = x + Tau*(Yc - row0)
% so with fp = f'(x), in the (x,y) ordering the FD version used,
%     J = [[1 + Tau*fp, Tau],
%          [       fp,    1 ]]
% and det J = (1 + Tau*fp)*1 - Tau*fp = 1 IDENTICALLY -- for every step, every
% fp, every Tau. So det M = 1 to machine precision and the symplectic
% structure is exact by construction rather than repaired afterwards.
%
% Why the finite difference had to go. M has entries of order sigma, and
% det = M11*M22 - M12*M21 must come out to 1, so two numbers of size sigma^2
% cancel to unity: the determinant loses ~2*log10(sigma) digits that the
% entries never had to lose. Measured against this routine over 20,000 random
% points (reference computed in 80-bit):
%
%   N    median|det-1|   det<=0 rejected   rescaled by symplectify   median S
%   12       7.7e-10           0.7%                6.4%                 9.9
%   25       1.5e-02          17.6%               34.6%                85.6
%   40       1.7e+02          39.5%               48.2%               804.7
%
% The entries themselves stay good far longer than the determinant does --
% sigma_max is a norm, a SUM of squares of the large entries, so it does not
% cancel. Raw FD reproduced S to 0.00% median even at N=25. The damage came
% from the repair: symplectify2x2 (since removed) divided M by sqrt(det)
% whenever |det-1| > DET_TOL, and when det is 174 because of cancellation that
% divides S by 13. With the rescaling applied, as the pipeline applies it, the error
% in S against exact was
%       N=12  median 0.00%, 99th pct 40%
%       N=25  median 0.00%, 90th pct 89%
%       N=40  median 85%
% so the cure was doing the damage, driven by a determinant that was measuring
% floating-point cancellation rather than anything about the dynamics.
%
% On the derivative. f is interp_kick_x, a LINEAR interpolant of dp_x, so its
% exact derivative is the divided difference dp(i1) - dp(i0), constant across
% each cell. That is deliberately NOT the spectral derivative of the
% underlying smooth field: M must be the Jacobian of the map the trajectory
% is actually advanced by, or it stops describing how neighbouring
% trajectories of THIS system separate. The two differ by a median 0.84% in S
% at N=12, 1.8% at N=25 and 2.9% at N=40 -- small, but a bias with no upside,
% and using it would also mean carrying a second history array that could
% fall out of step with dp_x_hist. The divided difference needs no new state
% at all.

T = numel(dp_hist);
x = double(x0(:)); y = double(y0(:));

a = ones(size(x));  b = zeros(size(x));      % M = [a b ; c d], the identity
c = zeros(size(x)); d = ones(size(x));

for k = 0:(floor(N)-1)
    dp = dp_hist{mod(t0 + k, T) + 1};
    n  = numel(dp);

    % value and exact slope of interp_kick_x at x, from one cell lookup
    xf = floor(x);
    i0 = mod(xf, n);
    d0 = dp(i0+1);
    fp = dp(mod(i0+1, n)+1) - d0;

    % M <- J*M
    g  = 1 + Tau*fp;
    a2 = g.*a + Tau*c;   b2 = g.*b + Tau*d;
    c  = fp.*a + c;      d  = fp.*b + d;
    a  = a2;             b  = b2;

    % advance the trajectory with the same kick value
    y = y + d0 + fp.*(x - xf);
    x = x + Tau*(y - row0);
end

% sigma_max in closed form, replacing one svd() call per point.
%
% For a 2x2 with det = 1: sigma1*sigma2 = 1 and sigma1^2 + sigma2^2 = t, the
% squared Frobenius norm, so (sigma1 +- sigma2)^2 = t +- 2 and
%     sigma_max = (sqrt(t+2) + sqrt(t-2))/2.
% t >= 2 always, by AM-GM on sigma1^2 + sigma2^2 >= 2*sigma1*sigma2, so the
% max() only absorbs rounding at sigma_max = 1 exactly.
%
% Not (t + sqrt(t^2-4))/2: that is the larger root of z^2 - t z + 1, which is
% sigma_max SQUARED, and returning it would square the whole field -- an S_THR
% of 2 would silently become sqrt(2) on the true sigma scale. Verified against
% svd over 200,000 random symplectic matrices: this form is exact to 1.4e-16
% median, the squared one is off by a median factor of sigma. This version
% also never forms t^2, which overflows for very large sigma.
t  = a.*a + b.*b + c.*c + d.*d;
S  = (sqrt(t + 2) + sqrt(max(t - 2, 0))) / 2;

xN = x;
yN = y;
end

function [nBlobs, areas] = blob_stats_any(BW, conn)
% Returns number of connected components + their pixel areas.
% Uses bwconncomp if available; otherwise falls back to a no-toolbox BFS.

BW = logical(BW);
if nargin<2, conn = 4; end

if exist('bwconncomp','file') == 2
    CC = bwconncomp(BW, conn);
    nBlobs = CC.NumObjects;
    areas  = cellfun(@numel, CC.PixelIdxList);
else
    [nBlobs, areas] = blob_stats_nontoolbox(BW, conn);
end
end

function [nBlobs, areas] = blob_stats_nontoolbox(BW, conn)
% Simple BFS connected-components (no toolboxes).
[H,W] = size(BW);
vis = false(H,W);
areas = zeros(0,1);
nBlobs = 0;

for r = 1:H
    for c = 1:W
        if ~BW(r,c) || vis(r,c), continue; end
        nBlobs = nBlobs + 1;

        % dynamic stack of linear indices
        stack = zeros(1024,1,'uint32');
        top = 1;
        stack(top) = uint32(r + (c-1)*H);
        vis(r,c) = true;

        cnt = 0;
        while top > 0
            idx = double(stack(top)); top = top - 1;
            cnt = cnt + 1;

            rr = mod(idx-1, H) + 1;
            cc = floor((idx-1)/H) + 1;

            % 4-connected neighbors
            % up
            if rr > 1 && BW(rr-1,cc) && ~vis(rr-1,cc)
                vis(rr-1,cc) = true;
                top = top + 1; if top>numel(stack), stack(end+1024)=0; end
                stack(top) = uint32((rr-1) + (cc-1)*H);
            end
            % down
            if rr < H && BW(rr+1,cc) && ~vis(rr+1,cc)
                vis(rr+1,cc) = true;
                top = top + 1; if top>numel(stack), stack(end+1024)=0; end
                stack(top) = uint32((rr+1) + (cc-1)*H);
            end
            % left
            if cc > 1 && BW(rr,cc-1) && ~vis(rr,cc-1)
                vis(rr,cc-1) = true;
                top = top + 1; if top>numel(stack), stack(end+1024)=0; end
                stack(top) = uint32(rr + (cc-2)*H);
            end
            % right
            if cc < W && BW(rr,cc+1) && ~vis(rr,cc+1)
                vis(rr,cc+1) = true;
                top = top + 1; if top>numel(stack), stack(end+1024)=0; end
                stack(top) = uint32(rr + (cc)*H);
            end

            if conn == 8
                % diagonals
                for dr = [-1 1]
                    for dc = [-1 1]
                        r2 = rr + dr; c2 = cc + dc;
                        if r2>=1 && r2<=H && c2>=1 && c2<=W && BW(r2,c2) && ~vis(r2,c2)
                            vis(r2,c2) = true;
                            top = top + 1; if top>numel(stack), stack(end+1024)=0; end
                            stack(top) = uint32(r2 + (c2-1)*H);
                        end
                    end
                end
            end
        end

        areas(nBlobs,1) = cnt; %#ok<AGROW>
    end
end
end

function h = overlay_mask_rgb(mask, rgb, alpha)
% Overlay a solid RGB colour wherever mask==true, with transparency alpha.
%
% MEMORY: the colour plane is uint8 rather than double. It only ever holds
% one constant colour, but as a double HxWx3 it cost ~88 MB per call at
% 1920x1920.
mask = logical(mask);
H = size(mask,1); W = size(mask,2);

rgb8   = uint8(round(255 * rgb(:)));
rgbImg = repmat(reshape(rgb8, 1, 1, 3), H, W);

h = image(rgbImg);
set(h, 'AlphaData', alpha * double(mask));
end

function n = fignum(base, it, keep_per_cycle)
% Figure number for a per-cycle figure: one reused window per figure kind,
% or a separate window per cycle when keep_per_cycle is true.
if keep_per_cycle
    n = base + it;
else
    n = base;
end
end

%% ---- full-resolution connected components (cell of linear-index lists) ----
function CC = get_CC_full(BW, conn)
    BW = logical(BW);
    if exist('bwconncomp','file') == 2
        C  = bwconncomp(BW, conn);
        CC = C.PixelIdxList;
    else
        CC = bfs_CC(BW, conn);
    end
end

%% ---- BFS connected components (no Image Processing Toolbox) ----
function CC = bfs_CC(BW, conn)
    [H,W] = size(BW);
    vis   = false(H,W);
    CC    = {};
    for r = 1:H
        for c = 1:W
            if ~BW(r,c) || vis(r,c), continue; end
            stack    = zeros(4096,1,'uint32');
            top      = 1;
            stack(1) = uint32(r + (c-1)*H);
            vis(r,c) = true;
            members  = zeros(0,1,'uint32');
            while top > 0
                idx = double(stack(top)); top = top-1;
                members(end+1,1) = uint32(idx); %#ok<AGROW>
                rr = mod(idx-1,H)+1;
                cc = floor((idx-1)/H)+1;
                % 4-connected neighbours
                nbrs4 = [rr-1,cc; rr+1,cc; rr,cc-1; rr,cc+1];
                ok4   = nbrs4(:,1)>=1 & nbrs4(:,1)<=H & ...
                        nbrs4(:,2)>=1 & nbrs4(:,2)<=W;
                nbrs  = nbrs4(ok4,:);
                if conn == 8
                    nbrsd = [rr-1,cc-1; rr-1,cc+1; rr+1,cc-1; rr+1,cc+1];
                    okd   = nbrsd(:,1)>=1 & nbrsd(:,1)<=H & ...
                            nbrsd(:,2)>=1 & nbrsd(:,2)<=W;
                    nbrs  = [nbrs; nbrsd(okd,:)]; %#ok<AGROW>
                end
                for ni = 1:size(nbrs,1)
                    nr=nbrs(ni,1); nc=nbrs(ni,2);
                    if BW(nr,nc) && ~vis(nr,nc)
                        vis(nr,nc) = true;
                        top = top+1;
                        if top > numel(stack), stack(end+4096) = 0; end
                        stack(top) = uint32(nr+(nc-1)*H);
                    end
                end
            end  % BFS while
            CC{end+1} = double(members); %#ok<AGROW>
        end
    end
end

%% ---- discrete perimeter (4-connected boundary pixel count) ----
function perim = compute_perimeter(BW)
% Boundary LENGTH via crack-following: each foreground pixel contributes one
% unit of length per 4-neighbour that is background.
%
% This previously counted boundary PIXELS (nnz(BW) - nnz(interior)), which is
% a count, not a length, and made the compactness C = 4*pi*A/P^2 exceed 1 --
% impossible for any region by the isoperimetric inequality. A single pixel
% gave P=1 and hence C=4*pi=12.57; 2px gave 6.28, 3px 4.19, 4px 3.14, which
% is what produced the horizontal bands in the old compactness scatter.
% Counting exposed edges instead gives P=4 for one pixel (C=0.785, the
% correct value for a square) and keeps C <= 1 throughout.
%
% Crack length overestimates the perimeter of a curved boundary by up to
% ~4/pi, so C is biased low for near-circular blobs (a digital disk scores
% ~0.62 rather than 1). The bias is systematic, so C stays usable for
% RANKING shapes but should not be read as an absolute circularity.
    BW   = logical(BW);
    [H,W] = size(BW);
    Pad  = false(H+2, W+2);
    Pad(2:end-1, 2:end-1) = BW;
    C = Pad(2:end-1,2:end-1);
    exposed = (C & ~Pad(1:end-2,2:end-1)) + ...   % up
              (C & ~Pad(3:end,  2:end-1)) + ...   % down
              (C & ~Pad(2:end-1,1:end-2)) + ...   % left
              (C & ~Pad(2:end-1,3:end));          % right
    perim = sum(exposed(:));
end

function plot_banded_dots(xyAll, sAll, dot_cmap)
% xyAll    - [N x 2] dot positions [x y] (1-based pixel coords)
% sAll     - [N x 1] the S value MEASURED at each dot
% dot_cmap - 12x3 RGB table, one row per band
%
% sAll used to be the interpolated S-field, and each dot's colour was looked
% up from it at the dot's position. That discarded the value actually
% measured at the probe -- a dot measured low-stretch could land on an
% interpolated cell above the threshold and be drawn in a high band or
% dropped. Colours now come from the measurement.

if isempty(xyAll) || isempty(sAll), return; end

N = size(xyAll, 1);
dot_S = sAll(:);

% Only 6 selected ranges get dots; everything else (S>=3.0 and NaN) is skipped.
band = zeros(N, 1);
band(dot_S <  1.5)                        = 1;
band(dot_S >= 1.5 & dot_S <  1.8)         = 2;
band(dot_S >= 1.8 & dot_S <  2.0)         = 3;
band(dot_S >  2.0 & dot_S <= 2.2)         = 4;
band(dot_S >  2.2 & dot_S <  2.5)         = 5;
band(dot_S >= 2.5 & dot_S <= 3.0)         = 6;

for b = 1:6
    sel = (band == b);
    if any(sel)
        plot(xyAll(sel,1), xyAll(sel,2), '.', ...
             'MarkerSize', 10, 'Color', dot_cmap(b,:));
    end
end
end

function apply_log_S_cmap(ax, S_max)
% Apply logarithmic color scale to S-field plots so the full S range
% [1, S_max] is visible without losing low-S detail.  Sets caxis and
% switches the axes to log color scale.  Caller is responsible for any
% colorbar; MATLAB will choose log-spaced default ticks.
if nargin < 2, S_max = 15; end
caxis(ax, [1, S_max]);
set(ax, 'ColorScale', 'log');
end

function cmap = build_diverging_bwr(N)
% Diverging blue->white->red colormap of length N (for signed scalars
% like rotation angle or trace).
if nargin<1, N = 256; end
half = floor(N/2);
% blue -> white
b1 = linspace(0.10, 1.00, half).';
g1 = linspace(0.30, 1.00, half).';
r1 = linspace(0.20, 1.00, half).';
% white -> red
r2 = linspace(1.00, 0.85, N-half).';
g2 = linspace(1.00, 0.10, N-half).';
b2 = linspace(1.00, 0.15, N-half).';
cmap = [r1 g1 b1; r2 g2 b2];
end

function save_cycle_figure(fig, plotName, cycle)
    folder = "saved_cycle_figures";

    if ~isfolder(folder)
        mkdir(folder)
    end

    filename = sprintf("%s_cycle_%02d.fig", plotName, cycle);
    savefig(fig, fullfile(folder, filename));
end
