%% ========================================================================
%% SECTION L — POWER SPECTRUM OF THE LOG(S1) FIELD
%%
%% Computes the 2-D power spectrum of the log(s1) field via FFT, then
%% azimuthally averages to get a 1-D power-spectral-density (PSD) as
%% a function of wavenumber k. This reveals the dominant spatial
%% frequencies in the stretch field.
%%
%% FIGURES:
%% Fig 8010 : 2-D log power spectrum of the log(s1) field
%% Fig 8011 : 1-D azimuthally-averaged PSD vs wavenumber
%% ========================================================================
fprintf('\n========================================\n');
fprintf(' Section L: Power spectrum analysis ...\n');
fprintf('========================================\n\n');
% Prepare field for FFT (zero-fill NaN regions)
Sfin_fft = Sfin;
Sfin_fft(~valid_fin) = mean(Sfin(valid_fin)); % fill NaN with mean
Sfin_fft = Sfin_fft - mean(Sfin_fft(:)); % remove DC component
% 2-D FFT and power spectrum
F2d = fft2(Sfin_fft);
P2d = fftshift(abs(F2d).^2 / (H_im * W_im));
logP2d = log10(P2d + 1e-30); % log scale for display
% ---- Fig 8010: 2-D log power spectrum ----
figure(8010); clf;
set(gcf,'Color','w','Position',[100 80 850 780], ...
 'Name','2-D power spectrum of log(s1) field');
kx_axis = (-floor(W_im/2):floor(W_im/2)-1) * (2*pi/W_im);
ky_axis = (-floor(H_im/2):floor(H_im/2)-1) * (2*pi/H_im);
imagesc(kx_axis, ky_axis, logP2d);
axis image; colormap(gca, hot(256)); colorbar;
xlabel('k_x (wavenumber, rad/pixel)','FontSize',12);
ylabel('k_y (wavenumber, rad/pixel)','FontSize',12);
title({'2-D log_{10} power spectrum of the log(s_1) field'; ...
 'Higher values = more energy at that spatial frequency'}, ...
 'FontSize',10,'FontWeight','bold');
drawnow;
fprintf(' Fig 8010: 2-D power spectrum.\n');
% ---- 1-D azimuthally-averaged PSD ----
[kxGrid, kyGrid] = meshgrid(kx_axis, ky_axis);
kR = sqrt(kxGrid.^2 + kyGrid.^2);
max_k = min(pi, max(kR(:)));
n_kbins = 60;
k_edges = linspace(0, max_k, n_kbins+1);
k_ctrs = (k_edges(1:end-1) + k_edges(2:end))/2;
psd_1d = nan(n_kbins,1);
for kb = 1:n_kbins
 in_k = (kR >= k_edges(kb)) & (kR < k_edges(kb+1));
 if any(in_k(:))
 psd_1d(kb) = mean(P2d(in_k));
 end
end
% ---- Fig 8011: 1-D PSD vs wavenumber ----
figure(8011); clf;
set(gcf,'Color','w','Position',[120 80 800 500], ...
 'Name','1-D azimuthally-averaged PSD of log(s1) field');
semilogy(k_ctrs, psd_1d, 'b-','LineWidth',2.0);
hold on;
% Overlay reference slopes
ok_psd = isfinite(psd_1d) & psd_1d > 0;
if sum(ok_psd) > 10
 k_ref = k_ctrs(ok_psd);
 p_ref = psd_1d(ok_psd);
 % -2 power law reference line
 p_minus2 = p_ref(1) * (k_ref / k_ref(1)).^(-2);
 semilogy(k_ref, p_minus2, 'r--','LineWidth',1.2, ...
 'DisplayName','k^{-2} reference');
 % -5/3 power law reference
 p_minus53 = p_ref(1) * (k_ref / k_ref(1)).^(-5/3);
 semilogy(k_ref, p_minus53, 'g--','LineWidth',1.2, ...
 'DisplayName','k^{-5/3} reference');
end
grid on;
xlabel('Wavenumber k (rad/pixel)','FontSize',12);
ylabel('Power spectral density PSD(k)','FontSize',12);
title({'Azimuthally-averaged 1-D PSD of the log(s_1) field'; ...
 'Reference slopes: k^{-2} (red), k^{-5/3} (green)'}, ...
 'FontSize',10,'FontWeight','bold');
legend({'PSD','k^{-2}','k^{-5/3}'},'Location','southwest','FontSize',10);
drawnow;
fprintf(' Fig 8011: 1-D PSD vs wavenumber.\n');
