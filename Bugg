% kick_drift_comprehensive.m
% ========================================================================
% COMPREHENSIVE KICK-DRIFT SYMPLECTIC MAP ANALYSER
% ========================================================================
%
% PURPOSE
% -------
% Simulates a 2-D area-preserving (symplectic) kick-drift map on a
% periodic image domain, then characterises the phase-space structure
% via the finite-time monodromy matrix M and its full singular-value
% decomposition M = U * diag(s1, s2) * V'.
%
% PHYSICS BACKGROUND
% ------------------
% A symplectic kick-drift map alternates two steps each cycle:
% KICK : (x, p) -> (x, p + dp(x)) (vertical impulse)
% DRIFT: (x, p) -> (x + tau*p, p) (horizontal shear)
% The combination is area-preserving (Hamiltonian) in the (x, p) plane.
% After N cycles the monodromy M = prod_{k=1}^{N} dF_k captures how an
% infinitesimal neighbourhood of a phase-space point is deformed.
%
% STRETCH METRIC (LOGARITHMIC — FTLE-LIKE)
% ----------------------------------------
% From M = U * diag(s1, s2) * V' (full SVD):
% s1 >= s2 > 0, s1 * s2 = 1 (area-preserving => det M = 1).
% log(s1) = "logarithmic stretch" analogous to the finite-time
% Lyapunov exponent (FTLE) when divided by N.
% log(s1) = 0 -> no stretching (elliptic / regular region).
% log(s1) > 0 -> stretching (hyperbolic / chaotic region).
% Threshold: S_THR_LIN = 2.0 => S_THR = log(2) ~ 0.693.
% Below threshold (BLUE) : coherent tubes / KAM tori survive.
% Above threshold (YELLOW): filaments / chaotic sea.
%
% ROTATION MATRICES U AND V
% -------------------------
% Both orthogonal factors are extracted and used:
% V : columns are the right singular vectors, giving the INITIAL
% directions of maximum stretch and compression in phase space.
% U : columns are the LEFT singular vectors, giving the FINAL
% directions after N steps.
% R = U * V' is the rotation component from the polar decomposition
% M = R * S_sym (R orthogonal, S_sym symmetric positive-definite).
% theta_R = atan2(R(2,1), R(1,1)) [radians]
% measures the net rigid rotation of the local frame over N steps.
% psi_V = atan2(V(2,1), V(1,1)) [radians]
% gives the orientation of the most-stretched direction IN INITIAL
% CONDITIONS (used as quiver arrows on the stretching-direction map).
%
% COLOUR CODING (DENSITY-AWARE DIVERGING SCHEME)
% -----------------------------------------------
% All S-field heat-maps use a BLUE -> WHITE -> RED diverging colourmap
% centred EXACTLY at log(S_THR_LIN) = log(2).
% Deep blue : log(s1) << log(2) => very stable, far below s=2.
% Light blue : log(s1) just below log(2) => marginally stable.
% White : log(s1) = log(2) => exactly at the threshold.
% Light red : log(s1) just above log(2) => mildly chaotic.
% Deep red : log(s1) >> log(2) => strongly chaotic.
% The colourbar ticks are ALWAYS labelled in the original LINEAR s units
% (e.g. "s=1.5", "s=2", "s=3") so the viewer can instantly read off
% how far above or below the threshold any region lies.
% Contour lines at s = 1.25, 1.5, 2, 3, 4 with text labels are drawn
% on every heatmap so density variations are quantified visually.
%
% PER-CYCLE FIGURES (generated every cycle)
% -----------------------------------------
% Fig 2000+c : 3-panel BEFORE / AFTER KICK / AFTER DRIFT
% Fig 4000+c : Histogram of log(s1) — blue vs yellow distributions,
% with threshold marker, mean/std annotations, and
% labels showing "X% within 0.2 of threshold".
% Fig 4500+c : FTLE field = log(s1) / Nwin (finite-time Lyapunov
% exponent per unit cycle), diverging colourmap, labelled.
% Fig 5000+c : log(s1) heatmap — diverging colormap + multi-level
% contours + corner annotations of mean s per region.
% Fig 5500+c : Rotation angle theta_R = angle(U*V') — HSV cyclic
% colourmap, s=2 boundary overlaid, axis labels in degrees.
% Fig 5800+c : Stretching-direction quiver — arrows show psi_V
% (orientation of V[:,1]) sampled on a coarse grid,
% coloured by log(s1).
% Fig 5900+c : Signed deviation from threshold:
% delta = log(s1) - log(2)
% Blue(<0) = how stable; Red(>0) = how chaotic.
% Labelled contours at delta = ±0.3, ±0.6, ±1.0.
% Fig 3000+c : Voting dots coloured by their log(s1) value —
% navy-to-cyan for low-stretch, orange-to-dark-red for
% high-stretch — with per-dot s-value text annotations.
%
% PER-CYCLE CONSOLE OUTPUT
% ------------------------
% Printed after every cycle:
% * Blue / yellow pixel counts, fractions, blob counts.
% * Mean, median, std, p10, p90 of log(s1) in each region.
% * Mean linear s1 for each region (= exp of log mean).
% * Mean rotation angle theta_R and its std for each region.
% * Y->B flip area and fraction.
% * FTLE = log(s1)/Nwin for each region.
%
% TREND FIGURES (after all cycles)
% ---------------------------------
% Fig 6001 : Blue/yellow area fraction vs cycle.
% Fig 6050 : Mean s1 (linear) per region vs cycle + threshold line.
% Fig 6100 : Area fraction + raw pixel area (2-panel).
% Fig 6150 : Percentile evolution of log(s1) — p10/p25/p50/p75/p90.
% Fig 6200 : Blob count + mean/median/max blob area (2x2 grid).
% Fig 6250 : Mean rotation angle + std per region vs cycle.
% Fig 6300 : Yellow->blue flip area + fraction (2-panel).
% Fig 6350 : FTLE per region vs cycle.
% Fig 6400 : Blob shape evolution — mean compactness + eccentricity.
%
% FINAL BLOB ANALYSIS (after last cycle, full resolution)
% --------------------------------------------------------
% Full-resolution connected-component decomposition of the blue region.
% Per-blob: area, fraction, centroid, bounding box, r_eq, compactness,
% eccentricity, aspect ratio, orientation, mean log(s1),
% min log(s1), mean rotation theta_R.
% Console ranked table + blob_summary.txt.
%
% FINAL FIGURES
% -------------
% Fig 7001 : Final log(s1) heatmap + S_THR contour + numbered blobs
% annotated with area, mean s1, r_eq.
% Fig 7002 : Ranked bar chart of blob areas + cumulative line.
% Fig 7003 : Compactness vs r_eq scatter (colour = mean s1 in blob).
% Fig 7004 : Cumulative low-stretch area vs blob rank.
% Fig 7005 : Final rotation angle field theta_R.
% Fig 7006 : Final FTLE field = log(s1)/Nwin.
% Fig 7007 : Final SIGNED DEVIATION delta = log(s1)-log(2), both
% regions labelled and contoured.
% Fig 7008 : Final stretching-direction quiver field.
% Fig 7009 : Mosaic of log(s1) fields across all cycles (1 per panel).
% Fig 7010 : Blob eccentricity vs r_eq scatter.
% Fig 7011 : Blob orientation rose chart (circular histogram).
% Fig 7012 : Blob mean-s1 vs compactness scatter.
%
% WRITTEN FILES
% -------------
% blob_summary.txt — full ranked table of all final blob statistics.
%
% ========================================================================
% USAGE
% ------
% Run the script directly. All parameters are in Section B.
% Requires: MATLAB base (no toolboxes needed — Image Processing Toolbox
% is used if present but gracefully falls back to built-in BFS otherwise).
% ========================================================================
clear; clc; close all; rng(0);
%% ========================================================================
%% SECTION A — Build the initial dot-grid reference image
%%
%% A regular grid of black dots on white background with three coloured
%% horizontal bands (RGB) near the centre. The bands serve as fiducial
%% markers so that stretching and rotation are visually obvious in the
%% pullback frames. Exported at 160 dpi so pixel size ~ 0.16 mm.
%% ========================================================================
fprintf('======================================================\n');
fprintf(' KICK-DRIFT COMPREHENSIVE ANALYSER\n');
fprintf(' Building reference dot-grid image ...\n');
fprintf('======================================================\n\n');
n = 40; % number of grid intervals in each direction
f_init = figure('Units','inches','Position',[1 1 12 12],'Color','w', ...
 'Name','Reference dot-grid image');
ax_init = axes('Parent', f_init);
[Xp, Yp] = meshgrid(0:n+1, 0:n+1);
plot(ax_init, Xp, Yp, 'ko', 'MarkerSize',4, 'MarkerFaceColor','k', ...
 'LineStyle','none');
hold(ax_init,'on');
axis(ax_init,'equal');
xlim(ax_init,[0 n+1]);
ylim(ax_init,[0 n+1]);
axis(ax_init,'off');
% Three coloured horizontal bands: RED (top), GREEN (middle), BLUE (bottom)
% These help visualise shear and vertical displacement after each cycle.
rectangle(ax_init,'Position',[0, n/2+2.5, n+1, 1], ...
 'FaceColor','r','EdgeColor','none');
rectangle(ax_init,'Position',[0, n/2-0.5, n+1, 1], ...
 'FaceColor','g','EdgeColor','none');
rectangle(ax_init,'Position',[0, n/2-3.5, n+1, 1], ...
 'FaceColor','b','EdgeColor','none');
set(ax_init,'Units','normalized','Position',[0 0 1 1], ...
 'LooseInset',[0 0 0 0]);
exportgraphics(f_init,'init_image.png','Resolution',160);
close(f_init);
fprintf(' Reference image written to init_image.png\n\n');
%% ========================================================================
%% SECTION B — Load image and configure ALL simulation parameters
%%
%% This section is extensively commented so that every parameter's
%% physical meaning is documented alongside its numerical value.
%% ========================================================================
fprintf('Loading image and configuring parameters ...\n');
% ---- load and sanitise the reference image ----
img0 = im2double(imread('init_image.png'));
if max(img0(:)) > 1.5, img0 = img0/255; end
if size(img0,3) == 1, img0 = cat(3,img0,img0,img0); end
if size(img0,3) == 4, img0 = img0(:,:,1:3); end
[rows, cols, ~] = size(img0);
if mod(rows,2), img0 = img0(2:end,:,:); end % ensure even dimensions
if mod(cols,2), img0 = img0(:,2:end,:); end
[rows, cols, ~] = size(img0);
fprintf(' Image loaded: %d rows x %d cols (3 channels)\n', rows, cols);
% ======== DYNAMICS PARAMETERS =========================================
% Number of map cycles to simulate.
% Each cycle = one random kick + one drift step.
cycles = 5;
% Row coordinate of the zero-momentum line (p = 0 reference).
% Pixels above row0 have p < 0 (moving left under drift);
% pixels below row0 have p > 0 (moving right under drift).
row0 = rows / 2;
% Spatial correlation length of the random kick potential (normalised,
% in fraction of the domain width). Smaller lc -> higher spatial
% frequency content in the kick -> more chaotic dynamics.
lc = 0.05;
% Kick amplitude K0 (in normalised units Lp * Lx / (rows * cols)).
% Larger K0 -> stronger kicks -> faster onset of chaos.
K0 = 0.025;
% Drift shear parameter Tau0 (normalised). This controls how quickly
% different momentum levels separate horizontally.
% Large Tau0 -> strong shear -> thin filaments in the chaotic sea.
Tau0 = 0.5;
% Physical domain sizes (normalised so the map is in a unit square).
Lx = 1.0; % horizontal extent (x direction)
Lp = 1.0; % vertical extent (p direction)
% Time direction for the PULLBACK visualisation.
% +1 : visualise forward-time pullback (typical FTLE view).
% -1 : visualise backward-time pullback (reversed arrows).
TIME_DIR = +1;
% Pixel-scale kick amplitude and drift coefficient.
% K and Tau translate the normalised parameters into pixel coordinates.
K = K0 / Lp * rows;
Tau = (Tau0 * Lx * rows) / (cols * Lp);
fprintf(' Dynamics: cycles=%d K=%.4f Tau=%.4f lc=%.3f\n', ...
 cycles, K, Tau, lc);
% ---- random kick potential spectral setup ----
% The kick dp(x) is drawn from a Gaussian random field with power spectrum
% proportional to exp(-k^2 lc^2). The correlation function c(x) is a
% Gaussian with width lc, whose FFT sets the amplitude spectrum.
xgrid = linspace(-0.5, 0.5, cols);
c_x = exp(-(xgrid.^2)/(lc^2));
cf_x = randpot1d_getFFT(c_x);
% ======== DISPLAY TOGGLE FLAGS ==========================================
% (A) Show 3-panel BEFORE / AFTER KICK / AFTER DRIFT each cycle.
SHOW_PANELS_EACH_CYCLE = true;
% (B) Compute and show the log(s1) heatmap each cycle.
SHOW_S_FIELD_FIG = true;
% (B2) Show the rotation-angle field (theta_R) each cycle.
SHOW_ROTATION_FIG = true;
% (B3) Show the histogram of log(s1) values each cycle.
SHOW_HISTOGRAM_FIG = true;
% (B4) Show the FTLE field each cycle.
SHOW_FTLE_FIG = true;
% (B5) Show the stretching-direction quiver each cycle.
SHOW_STRETCH_DIR_FIG = true;
% (B6) Show the signed-deviation field each cycle.
SHOW_DEVIATION_FIG = true;
% (C) Show the voting-dot scatter coloured by log(s1) each cycle.
SHOW_LOW_STRETCH_DOTS = true;
% Overlay the semi-transparent log(s1) field on the dots figure.
OVERLAY_S_FIELD_ON_DOTS = true;
% Show orange overlay where previously stretched pixels became low-stretch.
SHOW_Y2B_ORANGE = true;
% ======== S-MAP (VOTING DOTS) PARAMETERS ================================
% Number of past cycles included in the monodromy computation window.
% Increasing Nwin gives a longer-time average, revealing more persistent
% structures but washing out transient features.
SParams.Nwin = 10;
% Number of distinct time-window starting points to vote over.
% Multiple t0 values give a robustness check: if a region is consistently
% low-stretch across different windows, it is more reliably coherent.
SParams.VOTE_T0 = 5;
% Fraction of votes required for a probe to be classified as low-stretch.
% KEEP_FRAC = 0.50 means the point must be low-stretch in at least 50%
% of the voted time windows.
SParams.KEEP_FRAC = 0.50;
% Grid pitch (rows, cols) in pixels between probe points.
% Denser pitch -> more dots but slower computation.
SParams.PITCH_YX = [12 12];
% Jitter fraction: probe positions are randomly displaced by up to
% JITTER_FR * pitch in each direction. This breaks grid artefacts
% and gives a more natural-looking dot distribution.
SParams.JITTER_FR = 0.8;
% Require the centre probe to individually satisfy the criterion,
% not just the neighbourhood average. Reduces false positives near
% the chaotic boundary.
SParams.CENTER_MUST_BE_GOOD = true;
% Tolerance on |det(M) - 1| for the symplecticity check.
% Monodromies with |det - 1| > DET_TOL are discarded as numerically
% unreliable (e.g. due to large finite-difference errors near folds).
SParams.DET_TOL = 5e-3;
% ======== THRESHOLD (LOG SPACE) =========================================
% Linear stretch threshold. A point with s1 <= S_THR_LIN is considered
% "low-stretch" (coherent). s1 = 2 means the longest axis of an
% infinitesimal ellipse has doubled in N steps.
SParams.S_THR_LIN = 2.0;
% Logarithmic threshold used for all field comparisons.
% S_THR = log(S_THR_LIN) ~ 0.6931.
SParams.S_THR = log(SParams.S_THR_LIN);
% Whether to deposit the dot at the FINAL position (forward map endpoint)
% rather than the initial position. false = show initial phase-space point.
SParams.DEPOSIT_AT_FINAL = false;
% ======== S-FIELD (HEATMAP) PARAMETERS ==================================
% Coarse-grid step for field computation (pixels).
% Every FIELD_STEP-th row and column gets a monodromy computation.
% Increase to speed up; decrease for finer resolution.
SParams.FIELD_STEP = 8;
% Standard deviation (in coarse-grid cells) of the Gaussian smoothing
% kernel applied to the coarse log(s1) field before interpolation.
% Smoothing removes single-cell noise from finite-difference artefacts.
SParams.FIELD_SMOOTH_SIG = 1.2;
% Alpha (opacity) for the semi-transparent S-field overlay on top of
% the warped image in the dots figure.
SParams.FIELD_ALPHA = 0.28;
% Maximum log(s1) value shown in colourmap (=log of 6 ~ 1.79).
% Points with log(s1) > S_CLIP_MAX are clipped to S_CLIP_MAX for display.
SParams.S_CLIP_MAX = log(6.0);
% Minimum log(s1) value (= log(1) = 0 for area-preserving maps).
SParams.S_CLIP_MIN = 0.0;
% ======== ORANGE OVERLAY PARAMETERS =====================================
% Transparency of the orange "yellow -> blue" flip overlay.
SParams.TRANS_ALPHA = 0.45;
% ======== BLOB ANALYSIS PARAMETERS =====================================
% Connectivity for connected-component labelling (4 or 8).
% 4-connected: only N/S/E/W neighbours share a blob.
% 8-connected: diagonal neighbours also connect.
SParams.BLOB_CONN = 4;
% Downsampling factor for the per-cycle (faster) blob statistics.
% The full-resolution blob analysis in Section E uses no downsampling.
SParams.BLOB_STEP = 4;
fprintf(' S_THR_LIN=%.2f S_THR(log)=%.4f S_CLIP_MAX(log)=%.4f\n\n', ...
 SParams.S_THR_LIN, SParams.S_THR, SParams.S_CLIP_MAX);
% ======== PER-CYCLE ACCUMULATOR ARRAYS ==================================
% Preallocate NaN so unfilled entries are obvious in trend plots.
area_blue_px = nan(cycles,1);
area_yellow_px = nan(cycles,1);
area_total_px = nan(cycles,1);
frac_blue = nan(cycles,1);
frac_yellow = nan(cycles,1);
n_blue_blobs = nan(cycles,1);
n_yellow_blobs = nan(cycles,1);
mean_blue_blob_area_px = nan(cycles,1);
mean_yellow_blob_area_px = nan(cycles,1);
med_blue_blob_area_px = nan(cycles,1);
med_yellow_blob_area_px = nan(cycles,1);
max_blue_blob_area_px = nan(cycles,1);
max_yellow_blob_area_px = nan(cycles,1);
y2b_area_px = zeros(cycles,1);
y2b_frac = zeros(cycles,1);
% NEW: log(s1) distribution statistics per region per cycle
mean_logs1_blue = nan(cycles,1);
mean_logs1_yellow = nan(cycles,1);
std_logs1_blue = nan(cycles,1);
std_logs1_yellow = nan(cycles,1);
p10_logs1_blue = nan(cycles,1);
p25_logs1_blue = nan(cycles,1);
p50_logs1_blue = nan(cycles,1);
p75_logs1_blue = nan(cycles,1);
p90_logs1_blue = nan(cycles,1);
p10_logs1_yellow = nan(cycles,1);
p25_logs1_yellow = nan(cycles,1);
p50_logs1_yellow = nan(cycles,1);
p75_logs1_yellow = nan(cycles,1);
p90_logs1_yellow = nan(cycles,1);
% NEW: rotation angle statistics per region per cycle
mean_theta_blue = nan(cycles,1);
mean_theta_yellow = nan(cycles,1);
std_theta_blue = nan(cycles,1);
std_theta_yellow = nan(cycles,1);
% NEW: FTLE = log(s1)/Nwin per region
ftle_mean_blue = nan(cycles,1);
ftle_mean_yellow = nan(cycles,1);
% NEW: mean blob compactness per cycle
mean_compactness_blue = nan(cycles,1);
% Storage for mosaic figure (all cycle S-fields)
all_Sfine = cell(cycles,1);
all_Stheta = cell(cycles,1);
all_maskFine= cell(cycles,1);
% ======== SIMULATION STATE ==============================================
dp_x_hist = {}; % cell array of kick profiles (one per cycle)
img_hist = {}; % cell array of warped images
S_prev = []; % log(s1) field from the previous cycle (for Y->B)
mask_prev = []; % validity mask from the previous cycle
cur = img0; % current image (updated each cycle)
% ======== PRECOMPUTE COLOURMAP AND CONTOUR LEVELS =======================
% Diverging blue-white-red colourmap centred at log(2)/log(6) ~ 0.387.
% This places the white band exactly at the s=2 threshold.
center_frac = SParams.S_THR / SParams.S_CLIP_MAX;
cmap_div = diverging_bwr(256, center_frac);
% Contour log-levels to draw on every heatmap.
% Five levels: two below s=2, one at s=2, two above s=2.
contour_s_lin = [1.25, 1.5, SParams.S_THR_LIN, 3.0, 4.0];
contour_log_lvl = log(contour_s_lin);
% Signed-deviation contour levels: delta = log(s1) - log(2).
% Drawn on the signed-deviation figure to indicate distance from threshold.
deviation_lvls = [-1.0, -0.6, -0.3, 0, 0.3, 0.6, 1.0];
fprintf('Colourmap and contour levels initialised.\n');
fprintf('Centre fraction in colourmap: %.4f (log(2)/log(6))\n\n', center_frac);
%% ========================================================================
%% SECTION C — Main simulation loop
%%
%% Each iteration:
%% 1. Draw a new random band-limited kick dp_x(x).
%% 2. Warp the current image (pullback visualisation).
%% 3. Compute the log(s1) field + rotation field on a coarse grid,
%% interpolate to full resolution, and generate all per-cycle figures.
%% 4. Accumulate statistics into the trend arrays.
%% ========================================================================
fprintf('========================================\n');
fprintf(' Starting simulation (%d cycles)\n', cycles);
fprintf('========================================\n\n');
for it = 1:cycles
 %% ---- Banner ----
 fprintf('------------------------------------------------------------\n');
 fprintf(' CYCLE %d / %d\n', it, cycles);
 fprintf('------------------------------------------------------------\n');
 %% ==================================================================
 %% C1: Draw a new random kick profile dp_x(x)
 %% dp_x is a zero-mean, unit-std Gaussian random field with
 %% Gaussian power spectrum of width lc. Amplitude scaled by K.
 %% ==================================================================
 dp_x = K * randpot1d_four(cf_x);
 dp_x_hist{end+1} = dp_x; %#ok<SAGROW>
 fprintf(' [C1] New kick drawn. dp_x range: [%.3f, %.3f] px\n', ...
 min(dp_x), max(dp_x));
 %% ==================================================================
 %% C2: Warp the current image (pullback visualisation)
 %% stage1_img : image after kick only (shows kick geometry)
 %% stage2_img : image after kick + drift (full step)
 %% ==================================================================
 stage1_img = warp_image(cur, @InverseKick_vert, struct('dp_x',dp_x));
 if TIME_DIR == +1
 stage2_img = warp_image(cur, @InverseFullStep, ...
 struct('dp_x',dp_x,'row0',row0,'Tau',Tau));
 else
 stage2_img = warp_image(cur, @ForwardFullStep, ...
 struct('dp_x',dp_x,'row0',row0,'Tau',Tau));
 end
 img_hist{end+1} = stage2_img; %#ok<SAGROW>
 fprintf(' [C2] Image warped (TIME_DIR=%+d).\n', TIME_DIR);
 %% ==================================================================
 %% (A) Three-panel figure: BEFORE / AFTER KICK / AFTER DRIFT
 %%
 %% Panel 1 (BEFORE) : current image at start of this cycle.
 %% Panel 2 (AFTER KICK): image pulled back through the kick only;
 %% the kick profile dp_x is overlaid in blue.
 %% Panel 3 (AFTER DRIFT): image pulled back through full step;
 %% this is what the viewer sees after drift.
 %% ==================================================================
 if SHOW_PANELS_EACH_CYCLE
 figA = figure(2000 + it);
 set(figA,'Color','w','Position',[60 60 1500 440], ...
 'Name', sprintf('Cycle %d — BEFORE / AFTER KICK / AFTER DRIFT', it));
 tiledlayout(1,3,'TileSpacing','compact','Padding','compact');
 ax_A1 = nexttile;
 imshow(cur,[]); axis image off;
 title(ax_A1, sprintf('BEFORE (cycle %d start)', it), ...
 'FontSize',12,'FontWeight','bold');
 ax_A2 = nexttile;
 imshow(stage1_img,[]); axis image off;
 title(ax_A2, 'AFTER KICK (p += dp_x(x))', ...
 'FontSize',12,'FontWeight','bold');
 hold(ax_A2,'on');
 % Overlay the kick profile as a blue curve at the momentum row.
 % The curve shows how much each column is displaced vertically.
 plot(ax_A2, 1:cols, (row0+1) + dp_x(:).', ...
 '-','Color',[0.1 0.3 0.9],'LineWidth',2.0, ...
 'DisplayName','kick profile dp_x(x)');
 yline(ax_A2, row0+1, '--','Color',[0.5 0.5 0.5],'LineWidth',1.0, ...
 'DisplayName','p = 0 reference line');
 legend(ax_A2,'Location','best','FontSize',7);
 hold(ax_A2,'off');
 ax_A3 = nexttile;
 imshow(stage2_img,[]); axis image off;
 title(ax_A3, 'AFTER DRIFT (x += tau*p)', ...
 'FontSize',12,'FontWeight','bold');
 drawnow;
 fprintf(' [A] 3-panel figure drawn (Fig %d).\n', 2000+it);
 end
 cur = stage2_img;
 %% ==================================================================
 %% C3: Determine the monodromy window [t0, t0+Nwin)
 %% We use the last Nwin kicks, or all kicks if fewer available.
 %% ==================================================================
 Tcur = numel(dp_x_hist);
 Nw = min(SParams.Nwin, Tcur);
 t0_now = max(0, Tcur - Nw);
 FTLE_norm = 1.0 / max(1, Nw); % = 1/Nwin for FTLE
 fprintf(' [C3] Monodromy window: t0=%d, Nwin=%d, FTLE_norm=%.4f\n', ...
 t0_now, Nw, FTLE_norm);
 %% ==================================================================
 %% C4: Compute LOG(s1) field, ROTATION field, FTLE field,
 %% and STRETCHING-DIRECTION field on the coarse grid,
 %% then interpolate to full pixel resolution.
 %%
 %% All four fields are computed in a single pass over the
 %% coarse grid to avoid redundant monodromy evaluations.
 %% This is the main computational cost of each cycle.
 %% ==================================================================
 if SHOW_S_FIELD_FIG || SHOW_ROTATION_FIG || SHOW_FTLE_FIG || ...
 SHOW_STRETCH_DIR_FIG || SHOW_DEVIATION_FIG || SHOW_LOW_STRETCH_DOTS
 fprintf(' [C4] Computing fields on coarse grid (step=%d) ...', ...
 SParams.FIELD_STEP);
 [Sfine, Stheta, Spsiv, maskFine] = compute_all_fields( ...
 dp_x_hist, row0, Tau, rows, cols, t0_now, Nw, SParams);
 % Derived fields computed from Sfine:
 % FTLE field = log(s1) / Nwin (per-cycle average Lyapunov exponent)
 Sftle = Sfine * FTLE_norm;
 % Signed deviation from threshold: delta = log(s1) - log(2)
 Sdelta = Sfine - SParams.S_THR;
 fprintf(' done.\n');
 % Store for mosaic and trend figures
