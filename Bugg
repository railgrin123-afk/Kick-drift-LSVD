%% ========================================================================
%% SECTION R — KICK PROFILE AUTOCORRELATION AND SPECTRAL ANALYSIS
%%
%% PURPOSE
%% -------
%% Each cycle a new random kick profile dp_x(x) is drawn from a Gaussian
%% random field with correlation length lc. This section analyses the
%% statistical properties of the ENSEMBLE of kick profiles accumulated
%% over all cycles, specifically:
%%
%% 1. Individual profiles — each dp_x(x) plotted on one figure.
%% 2. Ensemble-averaged spatial autocorrelation C(Dx) = <dp_x(x) dp_x(x+Dx)>
%% compared to the theoretical Gaussian C(Dx) = K^2 * exp(-Dx^2/lc^2).
%% 3. Power spectral density (PSD) of the kick — ensemble-averaged 1-D FFT.
%% 4. Cumulative kick strength — the sum of |dp_x(x)| over all cycles,
%% showing which x-positions have been consistently kicked hard.
%% 5. Kick-to-kick cross-correlation between adjacent cycles — how much
%% the random kick changes from one cycle to the next.
%%
%% These diagnostics confirm that the random field generator is working
%% as intended, and help link the kick statistics to the observed stretch
%% patterns in the phase-space images.
%%
%% FIGURES
%% -------
%% Fig 9030 : All individual kick profiles dp_x(x) — one curve per cycle.
%% Fig 9031 : Ensemble-averaged spatial autocorrelation vs theoretical.
%% Fig 9032 : Ensemble-averaged PSD of kicks vs analytical spectrum.
%% Fig 9033 : Cumulative |kick| strength map (which columns get kicked most).
%% Fig 9034 : Cycle-to-cycle cross-correlation matrix of kick profiles.
%% ========================================================================
fprintf('\n========================================\n');
fprintf(' Section R: Kick profile analysis ...\n');
fprintf('========================================\n\n');
if isempty(dp_x_hist)
 warning('Section R: dp_x_hist is empty — skipping kick analysis.');
else
Ncyc_k = numel(dp_x_hist); % number of stored kick profiles
Lcols_k = numel(dp_x_hist{1}); % number of columns (= cols)
fprintf(' Analysing %d kick profiles each of length %d.\n', Ncyc_k, Lcols_k);
% Assemble into a matrix: each ROW is one kick profile (one cycle)
K_mat = zeros(Ncyc_k, Lcols_k);
for kc = 1:Ncyc_k
 K_mat(kc,:) = dp_x_hist{kc}(:).';
end
% x-axis in normalised units [0, 1)
x_norm = linspace(0, 1-1/Lcols_k, Lcols_k);
% ---- Fig 9030: Individual kick profiles ----
figure(9030); clf;
set(gcf,'Color','w','Position',[80 80 1000 500], ...
 'Name','Individual kick profiles dp_x(x) for all cycles');
hold on;
cmap_kicks = lines(Ncyc_k);
for kc = 1:Ncyc_k
 plot(x_norm, K_mat(kc,:), '-', ...
 'Color', [cmap_kicks(kc,:), 0.75], 'LineWidth', 0.9, ...
 'DisplayName', sprintf('Cycle %d', kc));
end
% Plot ensemble mean profile
plot(x_norm, mean(K_mat, 1), 'k-', 'LineWidth', 2.2, ...
 'DisplayName', 'Ensemble mean (should be ~0)');
% Theoretical ±1 sigma band
sigma_kick = K0 / sqrt(2*pi*lc) * cols; % approximate pixel-unit std
% Note: exact std depends on how cf_x was computed, this is indicative
yline(sigma_kick, '--', sprintf('+1\\sigma \\approx %.2f px', sigma_kick), ...
 'Color',[0.5 0.5 0.5],'LineWidth',1.2,'FontSize',8);
yline(-sigma_kick, '--', sprintf('-1\\sigma \\approx %.2f px', sigma_kick), ...
 'Color',[0.5 0.5 0.5],'LineWidth',1.2,'FontSize',8);
yline(0, 'k:', 'LineWidth',0.8);
legend('Location','northeast','FontSize',8,'NumColumns',min(3,Ncyc_k));
grid on;
xlabel('x (normalised position, 0 to 1)','FontSize',12);
ylabel('dp_x(x) — kick displacement (pixels)','FontSize',12);
title({sprintf('Random kick profiles for all %d cycles', Ncyc_k); ...
 'Each profile is a realisation of a Gaussian random field with corr. length l_c'}, ...
 'FontSize',10,'FontWeight','bold');
drawnow;
fprintf(' Fig 9030: individual kick profiles drawn.\n');
% ---- Fig 9031: Spatial autocorrelation of kicks ----
figure(9031); clf;
set(gcf,'Color','w','Position',[100 80 860 480], ...
 'Name','Ensemble-averaged spatial autocorrelation of kick profiles');
% Compute autocorrelation for each profile using xcorr, then average
Lhalf = floor(Lcols_k/2);
lags_vec = (-Lhalf:Lhalf);
ac_sum = zeros(1, 2*Lhalf+1);
for kc = 1:Ncyc_k
 [ac_k, ~] = xcorr(K_mat(kc,:), Lhalf, 'biased');
 ac_sum = ac_sum + ac_k;
end
ac_avg = ac_sum / Ncyc_k;
ac_avg = ac_avg / max(abs(ac_avg)); % normalise to peak = 1
% Theoretical: Gaussian autocorrelation with correlation length lc (in pixels)
lc_px = lc * Lcols_k; % convert lc from normalised to pixels
lag_axis_px = lags_vec;
ac_theory = exp(-(lag_axis_px.^2) / (lc_px^2));
hold on;
plot(lag_axis_px, ac_avg, 'b-', 'LineWidth', 2.0, ...
 'DisplayName', 'Empirical ensemble-avg autocorrelation');
plot(lag_axis_px, ac_theory, 'r--', 'LineWidth', 1.8, ...
 'DisplayName', sprintf('Theoretical Gaussian (l_c=%.1f px)', lc_px));
% Mark the e-folding lag (correlation length)
[~, idx_ef] = min(abs(ac_theory - exp(-1)));
xline(lag_axis_px(idx_ef), 'k:', ...
 sprintf('e^{-1} lag \\approx %.1f px (= l_c)', lc_px), ...
 'LineWidth',1.2,'FontSize',8,'LabelVerticalAlignment','bottom');
xline(-lag_axis_px(idx_ef), 'k:', 'LineWidth',1.2);
xline(0, 'k-', 'LineWidth',0.8);
yline(0, 'k:', 'LineWidth',0.8);
yline(exp(-1), '--', 'e^{-1}', 'Color',[0.5 0.5 0.5],'LineWidth',0.8,'FontSize',8);
legend('Location','northeast','FontSize',10);
grid on;
xlabel('Lag \Delta x (pixels)','FontSize',12);
ylabel('Normalised autocorrelation C(\Delta x) / C(0)','FontSize',12);
title({'Spatial autocorrelation of kick profiles'; ...
 'Good agreement with Gaussian theory confirms random field generator is correct'}, ...
 'FontSize',10,'FontWeight','bold');
xlim([-min(5*lc_px,Lhalf), min(5*lc_px,Lhalf)]);
drawnow;
fprintf(' Fig 9031: spatial autocorrelation drawn.\n');
% ---- Fig 9032: Ensemble-averaged PSD ----
figure(9032); clf;
set(gcf,'Color','w','Position',[120 80 860 480], ...
 'Name','Ensemble-averaged PSD of kick profiles vs analytical spectrum');
% Compute FFT-based PSD for each profile, then average
psd_sum = zeros(1, floor(Lcols_k/2)+1);
freq_vec = (0:floor(Lcols_k/2)) / Lcols_k; % normalised frequency [cycles/pixel]
for kc = 1:Ncyc_k
 F_k = fft(K_mat(kc,:), Lcols_k);
 P_k = abs(F_k(1:floor(Lcols_k/2)+1)).^2 / Lcols_k;
 psd_sum = psd_sum + P_k;
end
psd_avg = psd_sum / Ncyc_k;
% Theoretical Gaussian PSD: proportional to exp(-k^2 * lc^2 * Lcols^2)
% (obtained by Fourier-transforming the Gaussian autocorrelation)
k_norm_sq = (freq_vec * lc_px * 2*pi).^2;
psd_theory = exp(-k_norm_sq);
psd_theory = psd_theory * (psd_avg(2) / max(psd_theory(2),1e-30)); % scale to match
hold on;
semilogy(freq_vec, psd_avg+1e-30, 'b-', 'LineWidth',1.8, ...
 'DisplayName','Empirical ensemble-avg PSD');
semilogy(freq_vec, psd_theory, 'r--', 'LineWidth',1.6, ...
 'DisplayName',sprintf('Theoretical Gaussian PSD (l_c=%.1f px)', lc_px));
xline(1/(2*lc_px), 'k:', sprintf('f = 1/(2l_c) = %.3f', 1/(2*lc_px)), ...
 'LineWidth',1.2,'FontSize',8,'LabelVerticalAlignment','bottom');
legend('Location','northeast','FontSize',10);
grid on;
xlabel('Normalised frequency f (cycles/pixel)','FontSize',12);
ylabel('Power spectral density (log scale)','FontSize',12);
title({'Ensemble-averaged PSD of random kick profiles'; ...
 'Exponential roll-off at high frequencies is the spectral signature of l_c'}, ...
 'FontSize',10,'FontWeight','bold');
drawnow;
fprintf(' Fig 9032: kick PSD drawn.\n');
% ---- Fig 9033: Cumulative kick strength ----
figure(9033); clf;
set(gcf,'Color','w','Position',[140 80 900 400], ...
 'Name','Cumulative kick strength: total |dp_x| over all cycles');
cum_kick = sum(abs(K_mat), 1); % sum of |dp_x| over all cycles at each x
hold on;
bar(x_norm, cum_kick, 1.0, 'FaceColor',[0.3 0.5 0.8], ...
 'EdgeColor','none','FaceAlpha',0.8);
plot(x_norm, cum_kick, 'b-', 'LineWidth', 1.5);
% Theoretical expected value: mean(|dp_x|) = sigma_kick*sqrt(2/pi), times Ncyc_k
% This is the expected value for each column
expval = sigma_kick * sqrt(2/pi) * Ncyc_k;
yline(expval, 'r--', sprintf('Theoretical mean: %.2f px', expval), ...
 'LineWidth',1.5,'FontSize',9,'LabelVerticalAlignment','top');
yline(expval+1.5*sigma_kick*sqrt(Ncyc_k), ':', ...
 sprintf('+1.5\\sigma_{ensemble}'), ...
 'Color',[0.7 0.0 0.0],'LineWidth',1.0,'FontSize',7);
grid on;
xlabel('Normalised x-position','FontSize',12);
ylabel('Cumulative |dp_x| over all cycles (pixels)','FontSize',12);
title({sprintf('Total kick strength at each x-position over %d cycles', Ncyc_k); ...
 'Flat profile expected for a stationary random field'}, ...
 'FontSize',10,'FontWeight','bold');
drawnow;
fprintf(' Fig 9033: cumulative kick strength drawn.\n');
% ---- Fig 9034: Cycle-to-cycle cross-correlation matrix ----
figure(9034); clf;
set(gcf,'Color','w','Position',[100 80 700 600], ...
 'Name','Kick-profile cross-correlation matrix (cycles x cycles)');
% Compute the Ncyc x Ncyc normalised cross-correlation coefficient matrix.
% Entry (i,j) = corr(dp_x at cycle i, dp_x at cycle j).
% Since each cycle is an independent draw, this should be near-diagonal.
Xcorr_mat = nan(Ncyc_k, Ncyc_k);
for ki = 1:Ncyc_k
 for kj = ki:Ncyc_k
 rij = corr(K_mat(ki,:)', K_mat(kj,:)');
 Xcorr_mat(ki,kj) = rij;
 Xcorr_mat(kj,ki) = rij;
 end
end
imagesc(Xcorr_mat, [-1 1]);
colormap(gca, diverging_bwr(256, 0.5));
cb_xc = colorbar;
cb_xc.Label.String = 'Normalised cross-correlation coefficient';
cb_xc.Label.FontSize = 10;
axis square;
xlabel('Cycle index j','FontSize',12);
ylabel('Cycle index i','FontSize',12);
title({'Kick-profile cross-correlation matrix (cycles \times cycles)'; ...
 'Near-diagonal structure expected for independent random draws'; ...
 'Off-diagonal values \neq 0 would indicate spatial memory between cycles'}, ...
 'FontSize',10,'FontWeight','bold');
% Print the off-diagonal mean correlation
diag_mask = logical(eye(Ncyc_k));
off_diag_corr = Xcorr_mat(~diag_mask);
fprintf(' Off-diagonal mean correlation: %.4f (expected ~0)\n', ...
 mean(off_diag_corr));
fprintf(' Off-diagonal std correlation: %.4f\n', std(off_diag_corr));
drawnow;
fprintf(' Fig 9034: cross-correlation matrix drawn.\n');
fprintf(' Section R complete.\n\n');
end % end if dp_x_hist not empty
