plot(ax_r1, dist_centers, rad_mean, 'k--','LineWidth',1.5, ...
 'DisplayName','Mean log(s_1)');
yline(ax_r1, SParams.S_THR, 'r-', ...
 sprintf('s=%g threshold', SParams.S_THR_LIN), ...
 'LineWidth',1.5,'FontSize',8,'LabelHorizontalAlignment','right');
grid(ax_r1,'on');
xlabel(ax_r1,'Vertical distance from p=0 line (pixels)','FontSize',11);
ylabel(ax_r1,'log(s_1)','FontSize',11);
title(ax_r1,{'Radial profile of log(s_1) from the p=0 reference line'; ...
 'p10/p25/p50/p75/p90 percentile bands shown'}, ...
 'FontSize',10,'FontWeight','bold');
legend(ax_r1,'Location','best','FontSize',8);
ax_r2 = nexttile;
bar(ax_r2, dist_centers, rad_frac_blue*100, 'FaceColor',[0.2 0.4 0.85], ...
 'EdgeColor','none');
grid(ax_r2,'on'); ylim(ax_r2,[0 100]);
xlabel(ax_r2,'Distance from p=0 (pixels)','FontSize',11);
ylabel(ax_r2,'Blue fraction (%)','FontSize',11);
title(ax_r2,'Fraction of low-stretch pixels vs distance','FontSize',10,'FontWeight','bold');
yline(ax_r2, 50, 'k--', '50%','FontSize',8);
drawnow;
fprintf(' Fig 8001: radial profile of log(s1).\n');
% ---- Fig 8002: 2-D autocorrelation of the blue mask ----
% Autocorrelation via FFT: acf = ifft2(|fft2(BW)|^2) / N.
% Normalised so acf(0,0) = 1. Shows the spatial coherence of
% low-stretch patches: narrow peak = small isolated blobs;
% broad peak = large contiguous coherent regions.
figure(8002); clf;
set(gcf,'Color','w','Position',[120 80 900 800], ...
 'Name','2-D autocorrelation of the low-stretch (blue) mask');
BW_for_acf = double(low_mask_fin) - mean(double(low_mask_fin(:)));
acf_2d_raw = ifft2(abs(fft2(BW_for_acf)).^2);
acf_2d = fftshift(real(acf_2d_raw));
