%% ========================================================================
%% LOCAL HELPER FUNCTIONS
%% ========================================================================
%%
%% All functions are self-contained local functions at the bottom of
%% the script. No external toolboxes required except where noted.
%% Functions are listed alphabetically within each category.
%%
%% CATEGORY 1: Random potential generation
%% randpot1d_getFFT — spectral amplitude from correlation function
%% randpot1d_four — draw one realisation from spectral amplitudes
%%
%% CATEGORY 2: Symplectic map steps (all periodic boundary conditions)
%% InverseKick_vert — inverse of the vertical kick step
%% InverseFullStep — inverse of kick+drift (for pullback)
%% ForwardFullStep — forward kick+drift
%% interp_kick_x — piecewise-linear kick interpolation
%% propagate_N — iterate the map N steps forward
%%
%% CATEGORY 3: Image warping
%% warp_image — bilinear pullback warp (periodic BC)
%%
%% CATEGORY 4: Monodromy and symplectification
%% monodromy_fd_vert — 5-point FD monodromy matrix at one probe
%% symplectify2x2 — enforce det(M)=1 within tolerance
%%
%% CATEGORY 5: Field computation (main analysis)
%% compute_all_fields — log(s1) + rotation theta_R + stretch dir psi_V
%% smooth2_gaussian_nan— NaN-aware separable Gaussian smoother
%%
%% CATEGORY 6: Voting-dot snapshot
%% Smap_dots_snapshot — robust vote-based low/high-stretch dot finder
%%
%% CATEGORY 7: Blob / connected-component utilities
%% blob_stats_any — number of blobs + areas
%% get_CC_full — full pixel-index lists for each component
%% bfs_CC — BFS connected-component labeller (no toolbox)
%% compute_perimeter — 4-connected boundary pixel count
%%
%% CATEGORY 8: Visualisation helpers
%% diverging_bwr — blue->white->red diverging colourmap
%% overlay_mask_rgb — coloured semi-transparent mask overlay
%% set_log_colorbar — colourbar ticks in linear s-units
%% label_contours_linear_s — text labels on log-scale contours
%% clabel_linear_s — place a single contour text label
%% ========================================================================
%% ---- CATEGORY 1: Random potential ------------------------------------ %%
function F = randpot1d_getFFT(c)
%RANDPOT1D_GETFFT Compute spectral amplitude array from correlation c(x).
%
% F = RANDPOT1D_GETFFT(c)
%
% c : 1-D correlation function (real, periodic). Its Fourier transform
% |F(k)|^2 gives the power spectrum of the random field.
% F : Complex array whose magnitude is sqrt(|fft(ifftshift(c))|).
% Used as the fixed spectral amplitude in randpot1d_four.
%
% The ifftshift centres the correlation function before the FFT so that
% the zero-lag value is at index 1 (MATLAB convention).
 f = fft(ifftshift(c(:).'));
 F = complex(sqrt(abs(f)), 0);
end
function u = randpot1d_four(cf)
%RANDPOT1D_FOUR Draw one realisation of the random kick potential.
%
% u = RANDPOT1D_FOUR(cf)
%
% cf : Spectral amplitude array from randpot1d_getFFT.
% u : Real vector of length numel(cf). Zero mean, unit std.
% Random phases are drawn uniformly in [-pi, pi] and applied
% to cf, then the inverse FFT gives the real-space field.
% Hermitian symmetry is enforced so that ifft gives a real result.
%
% The field is normalised to unit standard deviation before return.
 n = numel(cf);
 if n < 4, u = zeros(n,1); return; end
 % Random phases for positive frequencies 2..n/2
 p = (2*rand(1, floor(n/2)-1) - 1) * pi;
 phase = zeros(1,n);
 lo = 2:(n/2); hi = (n/2+2):n;
 if ~isempty(lo), phase(lo) = p; end
 if ~isempty(hi), phase(hi) = fliplr(p); end % Hermitian conjugate
 cff = cf(:).' .* exp(1i * phase);
 cff(1) = 0; % zero mean
 u = sqrt(n) * ifft(cff);
 u = real(u);
 s = std(u);
 if s < 1e-12, s = 1e-12; end
 u = (u / s).';
 u = u(:);
end
%% ---- CATEGORY 2: Symplectic map steps -------------------------------- %%
function Rp = InverseKick_vert(coords, args)
%INVERSEKICK_VERT Inverse of the vertical momentum kick step.
%
% coords : [N x 2] array of (row, col) probe positions.
% args : struct with field dp_x (kick profile, length = cols).
% Rp : coords after undoing the kick (pullback).
%
% The kick is p -> p + dp_x(x), so its inverse is p -> p - dp_x(x).
% The kick amplitude dp_x(x) is interpolated piecewise-linearly.
 dp_x = args.dp_x(:);
 n = numel(dp_x);
 y = coords(:,1);
 x = coords(:,2);
 x0 = floor(x);
 i0 = mod(x0, n);
 i1 = mod(i0+1, n);
 fx = x - x0;
 dpy = dp_x(i0+1) + (dp_x(i1+1) - dp_x(i0+1)) .* fx;
 Rp = coords;
 Rp(:,1) = y - dpy;
end
function Rp = InverseFullStep(coords, args)
%INVERSEFULLSTEP Inverse of one full kick+drift step (for pullback).
%
% coords : [N x 2] array of (row, col) at the FINAL position.
% args : struct with dp_x, row0, Tau.
% Rp : initial (row, col) positions that map to coords after one step.
%
% Forward step: x1 = x + tau*(p+dp_x(x) - row0), p1 = p + dp_x(x).
% Inverse step: x = x1 - tau*(p1 - row0), p = p1 - dp_x(x).
 dp_x = args.dp_x(:);
 n = numel(dp_x);
 row0 = args.row0;
 Tau = args.Tau;
 y1 = coords(:,1);
 x1 = coords(:,2);
 % Undo drift first (x was shifted by Tau*(p1 - row0))
 x = x1 - Tau * (y1 - row0);
 % Undo kick
 x0 = floor(x);
 i0 = mod(x0, n);
 i1 = mod(i0+1, n);
 fx = x - x0;
 dpy = dp_x(i0+1) + (dp_x(i1+1) - dp_x(i0+1)) .* fx;
 y = y1 - dpy;
 Rp = [y, x];
end
function Rp = ForwardFullStep(coords, args)
%FORWARDFULLSTEP One forward kick+drift step.
%
% coords : [N x 2] array of initial (row, col) positions.
% args : struct with dp_x, row0, Tau.
% Rp : positions after one full map step.
 dp_x = args.dp_x(:);
 n = numel(dp_x);
 row0 = args.row0;
 Tau = args.Tau;
 y = coords(:,1);
 x = coords(:,2);
 x0 = floor(x);
 i0 = mod(x0, n);
 i1 = mod(i0+1, n);
 fx = x - x0;
 dpy = dp_x(i0+1) + (dp_x(i1+1) - dp_x(i0+1)) .* fx;
 y1 = y + dpy;
 x1 = x + Tau * (y1 - row0);
 Rp = [y1, x1];
end
function dpy = interp_kick_x(x, dp_x)
%INTERP_KICK_X Piecewise-linear interpolation of the kick profile.
%
% x : scalar or vector of column positions (can be non-integer).
% dp_x : kick profile vector of length n (periodic).
% dpy : interpolated kick values at positions x.
%
% Wraps x periodically so that positions outside [0, n) are handled.
 n = numel(dp_x);
 x0 = floor(x);
 i0 = mod(x0, n);
 i1 = mod(i0+1, n);
 fx = x - x0;
 dpy = dp_x(i0+1) + (dp_x(i1+1) - dp_x(i0+1)) * fx;
end
function [xo, yo] = propagate_N(xi, yi, t0, N, dp_hist, Tau, row0)
%PROPAGATE_N Iterate the kick-drift map N steps starting from (xi, yi).
%
% (xi, yi) : initial (col, row) position (doubles).
% t0 : index of the first kick to use from dp_hist (0-based).
% N : number of steps.
% dp_hist : cell array of kick profiles.
% Tau, row0 : drift parameters.
% (xo, yo) : final (col, row) position after N steps.
%
% Wraps the kick index modulo numel(dp_hist) for periodic reuse.
 T = numel(dp_hist);
 xo = xi;
 yo = yi;
 for k = 0:(floor(N)-1)
 dp = dp_hist{mod(t0+k, T)+1};
 Yc = yo + interp_kick_x(xo, dp); % kick: p -> p + dp_x(x)
 Xc = xo + Tau * (Yc - row0); % drift: x -> x + tau*p
 xo = Xc;
 yo = Yc;
 end
end
%% ---- CATEGORY 3: Image warping --------------------------------------- %%
function out = warp_image(image, map_func, map_args)
%WARP_IMAGE Bilinear pullback warp with periodic boundary conditions.
%
% image : [H x W x C] source image (double or uint8).
% map_func : function handle @(coords, args) -> mapped_coords.
% coords is [H*W x 2], each row = [row, col] (0-based).
% mapped_coords is the corresponding source coordinates.
% map_args : argument struct passed to map_func.
% out : [H x W x C] warped image.
%
% For each output pixel (r,c), map_func gives its source location (rs,cs)
% in the source image. Bilinear interpolation is applied; positions are
% wrapped periodically so there are no edge artefacts.
 [rows, cols, ch] = size(image);
 img = im2double(image);
 [cc, rr] = meshgrid(0:cols-1, 0:rows-1);
 coords = [rr(:), cc(:)];
 mapped = feval(map_func, coords, map_args);
 ys = mod(mapped(:,1), rows);
 xs = mod(mapped(:,2), cols);
 y0 = floor(ys); x0 = floor(xs);
 y1 = mod(y0+1, rows);
 x1 = mod(x0+1, cols);
 fy = ys - y0; fx = xs - x0;
 y0p = y0+1; y1p = y1+1; x0p = x0+1; x1p = x1+1;
 idx00 = sub2ind([rows,cols], y0p, x0p);
 idx01 = sub2ind([rows,cols], y0p, x1p);
 idx10 = sub2ind([rows,cols], y1p, x0p);
 idx11 = sub2ind([rows,cols], y1p, x1p);
 w00 = (1-fy).*(1-fx); w01 = (1-fy).*fx;
 w10 = fy.*(1-fx); w11 = fy.*fx;
 out = zeros(rows, cols, ch);
 for k = 1:ch
 P = img(:,:,k);
 v = w00.*P(idx00) + w01.*P(idx01) + w10.*P(idx10) + w11.*P(idx11);
 out(:,:,k) = reshape(v, rows, cols);
 end
end
%% ---- CATEGORY 4: Monodromy and symplectification --------------------- %%
function [M, xyNw] = monodromy_fd_vert(y0, x0, t0, N, dp_hist, Tau, rows, cols, row0, eps_)
%MONODROMY_FD_VERT Compute 2x2 monodromy matrix via 5-point central FD.
%
% (y0,x0) : probe position in (row,col) 0-based pixel coordinates.
% t0,N : time-window start index and length (number of steps).
% dp_hist : cell array of kick profiles.
% Tau,rows,cols,row0 : map parameters.
% eps_ : finite-difference step size (default 1e-3 pixels).
% M : 2x2 monodromy matrix dF^N/d(x,y) at (x0,y0).
% xyNw : [col,row] final position of the central probe (periodic).
%
% 5-point stencil: M_ij = (f(x+eps_*e_j) - f(x-eps_*e_j)) / (2*eps_)
% using two FD steps per column of M. This gives O(eps_^2) accuracy.
% If det(M) deviates from 1 by more than 5e-3, M is symplectified.
 if nargin < 10, eps_ = 1e-3; end
 [xN0, yN0] = propagate_N(double(x0), double(y0), t0,N,dp_hist,Tau,row0);
 [xNxp, yNxp] = propagate_N(double(x0)+eps_, double(y0), t0,N,dp_hist,Tau,row0);
 [xNxm, yNxm] = propagate_N(double(x0)-eps_, double(y0), t0,N,dp_hist,Tau,row0);
 [xNyp, yNyp] = propagate_N(double(x0), double(y0)+eps_, t0,N,dp_hist,Tau,row0);
 [xNym, yNym] = propagate_N(double(x0), double(y0)-eps_, t0,N,dp_hist,Tau,row0);
 col1 = [(xNxp-xNxm)/(2*eps_); (yNxp-yNxm)/(2*eps_)];
 col2 = [(xNyp-xNym)/(2*eps_); (yNyp-yNym)/(2*eps_)];
 M = [col1, col2];
 detM = det(M);
 if isfinite(detM) && detM > 0 && abs(detM-1) > 5e-3
 M = M / sqrt(detM); % quick symplectification
 end
 xyNw = [mod(xN0, cols), mod(yN0, rows)];
end
function [M_sym, det_raw] = symplectify2x2(M, det_tol)
%SYMPLECTIFY2X2 Enforce det(M)=1 for a 2x2 matrix.
%
% M : 2x2 matrix (should be approximately symplectic).
% det_tol : tolerance; if |det(M)-1| <= det_tol, M is returned as-is.
% M_sym : M / sqrt(det(M)) if correction needed; [] if M is invalid.
% det_raw : raw determinant of M before symplectification.
%
% Returns M_sym=[] if det(M) is non-finite or non-positive, signalling
% that this probe should be discarded.
 if nargin < 2, det_tol = 5e-3; end
 det_raw = det(M);
 if ~isfinite(det_raw) || det_raw <= 0
 M_sym = [];
 return;
 end
 if abs(det_raw - 1) <= det_tol
 M_sym = M;
 else
 M_sym = M / sqrt(det_raw);
 end
end
%% ---- CATEGORY 5: Field computation ----------------------------------- %%
function [Slog, Stheta, Spsiv, maskFine] = compute_all_fields( ...
 dp_x_hist, row0, Tau, H, W, t0, Nwin, P)
%COMPUTE_ALL_FIELDS Compute three scalar fields on a coarse grid and
% interpolate to full pixel resolution.
%
% Returns:
% Slog : log(s1) field [H x W], clipped to [S_CLIP_MIN, S_CLIP_MAX].
% Stheta : rotation angle field [H x W] (radians, range [-pi, pi]).
% theta_R = atan2(R(2,1), R(1,1)) where R = U * V'.
% Spsiv : stretching-direction field [H x W] (radians, range [-pi/2, pi/2]).
% psi_V = atan2(V(2,1), V(1,1)) restricted to [0, pi).
% maskFine: logical [H x W], true where the field is valid.
%
% All four fields are computed in a single double loop over the coarse
% grid (step = P.FIELD_STEP) to avoid recomputing monodromy matrices.
%
% After the coarse computation, NaN-aware Gaussian smoothing is applied
% (sigma = P.FIELD_SMOOTH_SIG coarse cells), then bilinear interpolation
% to the full [H x W] grid.
 step = P.FIELD_STEP;
 ys = 1:step:H;
 xs = 1:step:W;
 Ny = numel(ys);
 Nx = numel(xs);
 % Coarse-grid arrays (NaN = not yet computed or discarded)
 s1C = nan(Ny, Nx);
 thetaC = nan(Ny, Nx);
 psivC = nan(Ny, Nx);
 maskC = false(Ny, Nx);
 for iy = 1:Ny
 for ix = 1:Nx
 y0d = double(ys(iy) - 1); % 0-based row coordinate
 x0d = double(xs(ix) - 1); % 0-based col coordinate
 % 1. Compute the N-step monodromy M at this probe
 [M_raw, ~] = monodromy_fd_vert(y0d, x0d, t0, Nwin, ...
 dp_x_hist, Tau, H, W, row0, 1e-3);
 % 2. Symplectify: enforce det(M)=1
 [M_sym, det_raw] = symplectify2x2(M_raw, P.DET_TOL);
 if isempty(M_sym) || ~isfinite(det_raw) || abs(det_raw-1) > P.DET_TOL
 continue; % discard this probe
 end
 % 3. Full SVD: M = U * diag(s1, s2) * V'
 % U, V are rotation matrices (orthogonal with det=+1).
 % s1 >= s2 > 0, s1*s2 = 1 (area-preserving).
 [U, Sv_mat, V] = svd(M_sym);
 s1 = Sv_mat(1,1);
 if s1 <= 0 || ~isfinite(s1), continue; end
 % 4. LOGARITHMIC STRETCH log(s1)
 s1C(iy,ix) = log(s1);
 % 5. ROTATION from polar decomposition: R = U * V'
 % For a 2x2 rotation matrix R, the angle satisfies
 % R = [cos(theta), -sin(theta); sin(theta), cos(theta)].
 R = U * V';
 thetaC(iy,ix) = atan2(R(2,1), R(1,1));
 % 6. STRETCHING DIRECTION: psi_V = angle of V[:,1]
 % V[:,1] is the direction in initial conditions that
 % gets maximally stretched after N steps.
 % Restricted to [0, pi) since ±psi_V are equivalent.
 psivC(iy,ix) = mod(atan2(V(2,1), V(1,1)), pi);
 maskC(iy,ix) = true;
 end
 end
 % 7. NaN-aware Gaussian smoothing on coarse grid
 s1S = smooth2_gaussian_nan(s1C, maskC, P.FIELD_SMOOTH_SIG);
 thetaS = smooth2_gaussian_nan(thetaC, maskC, P.FIELD_SMOOTH_SIG);
 psivS = smooth2_gaussian_nan(psivC, maskC, P.FIELD_SMOOTH_SIG);
 % 8. Interpolate coarse -> full resolution
 [Xc, Yc] = meshgrid(xs, ys);
 [Xf, Yf] = meshgrid(1:W, 1:H);
 Slog = interp2(Xc, Yc, s1S, Xf, Yf, 'linear', NaN);
 Stheta = interp2(Xc, Yc, thetaS, Xf, Yf, 'linear', NaN);
 Spsiv = interp2(Xc, Yc, psivS, Xf, Yf, 'linear', NaN);
 maskFine = isfinite(Slog);
 % 9. Clip log(s1) to [S_CLIP_MIN, S_CLIP_MAX]
 % (s1 >= 1 always for area-preserving maps => log(s1) >= 0)
 Slog(Slog < P.S_CLIP_MIN) = P.S_CLIP_MIN;
 Slog(Slog > P.S_CLIP_MAX) = P.S_CLIP_MAX;
end
function Sout = smooth2_gaussian_nan(Sin, mask, sigma_cells)
%SMOOTH2_GAUSSIAN_NAN NaN-aware separable 2-D Gaussian smoothing.
%
% Sin : 2-D array with NaNs in invalid cells.
% mask : logical mask; true = valid cell.
% sigma_cells: Gaussian standard deviation in grid cells.
% Sout : smoothed array; cells with insufficient data support
% (weight < 0.15) are set to NaN.
%
% No external toolboxes required. Uses conv2 for speed.
% The weight normalisation handles NaN cells correctly:
% Sout(i,j) = sum(w * Sin) / sum(w)
% where w is the Gaussian kernel and the sum skips NaN entries.
 if sigma_cells <= 0, Sout = Sin; return; end
 rad = max(1, ceil(3 * sigma_cells));
 x = -rad:rad;
 g = exp(-(x.^2) / (2 * sigma_cells^2));
 g = g / sum(g);
 Sin0 = Sin;
 Sin0(~mask) = 0;
 W0 = double(mask);
 num = conv2(conv2(Sin0, g, 'same'), g', 'same');
 den = conv2(conv2(W0, g, 'same'), g', 'same');
 Sout = num ./ max(den, 1e-12);
 Sout(den < 0.15) = NaN; % too little data support
end
%% ---- CATEGORY 6: Voting-dot snapshot --------------------------------- %%
function [xyLow, xyHigh, log_s1_low, log_s1_high, stats] = ...
 Smap_dots_snapshot(dp_x_hist, row0, Tau, P, H, W)
%SMAP_DOTS_SNAPSHOT Voting-based low/high-stretch probe classification.
%
% Probes are placed on a regular grid with pitch P.PITCH_YX, jittered
% randomly by up to P.JITTER_FR * pitch. For each probe, the 5-point
% neighbourhood (centre + 4 half-pitch offsets) is evaluated and a
% consensus vote is taken. A probe needs P.KEEP_FRAC fraction of t0
% time-windows to pass the vote.
%
% Comparisons use LOG(s1) vs P.S_THR = log(S_THR_LIN) throughout.
%
% Returns:
% xyLow : [n_low x 2] (col, row) of surviving low-stretch probes.
% xyHigh : [n_high x 2] (col, row) of surviving high-stretch probes.
% log_s1_low : [n_low x 1] average log(s1) at each low-stretch probe.
% log_s1_high : [n_high x 1] average log(s1) at each high-stretch probe.
% stats : struct with n_low, n_high, passes.
 Nwin = min(P.Nwin, numel(dp_x_hist));
 T = numel(dp_x_hist);
 if T < 1 || Nwin < 1
 xyLow=zeros(0,2); xyHigh=zeros(0,2);
 log_s1_low=zeros(0,1); log_s1_high=zeros(0,1);
 stats=struct('n_low',0,'n_high',0,'passes',0);
 return;
 end
 span = max(0, T - Nwin);
 V = min(P.VOTE_T0, span+1);
 if V <= 1
 t0_list = span;
 else
 t0_list = unique(round(linspace(max(0,span-(V-1)), span, V)));
 end
 pitch_y = P.PITCH_YX(1);
 pitch_x = P.PITCH_YX(2);
 ys_p = floor(pitch_y/2):pitch_y:(H-1);
 xs_p = floor(pitch_x/2):pitch_x:(W-1);
 [Xg, Yg] = meshgrid(xs_p, ys_p);
 probes = [Yg(:), Xg(:)];
 % 5-point neighbourhood offsets (in units of half-pitch)
 OFFS = [0 0; 0 0.5; 0 -0.5; 0.5 0; -0.5 0];
 low_votes = zeros(H,W);
 high_votes = zeros(H,W);
 low_logS = zeros(H,W);
 high_logS = zeros(H,W);
 low_count = zeros(H,W);
 high_count = zeros(H,W);
 total_passes = 0;
 REQUIRE_4_OF_5 = numel(t0_list) > 1;
 agree_needed = 4*REQUIRE_4_OF_5 + 3*(~REQUIRE_4_OF_5);
 for t0 = t0_list
 total_passes = total_passes + 1;
 nP = size(probes,1);
 jy = (2*rand(nP,1)-1) * P.JITTER_FR * pitch_y;
 jx = (2*rand(nP,1)-1) * P.JITTER_FR * pitch_x;
 Pj = probes + [jy, jx];
 Pj(:,1) = mod(Pj(:,1), H);
 Pj(:,2) = mod(Pj(:,2), W);
 pass_low = false(H,W);
 pass_high = false(H,W);
 logS_low_pass = zeros(H,W);
 logS_high_pass = zeros(H,W);
 for j = 1:size(Pj,1)
 y0j = Pj(j,1); x0j = Pj(j,2);
 [M0_raw, xyN0w] = monodromy_fd_vert(y0j, x0j, t0, Nwin, ...
 dp_x_hist, Tau, H, W, row0, 1e-3);
 [M0, det0] = symplectify2x2(M0_raw, P.DET_TOL);
 if isempty(M0) || ~isfinite(det0) || abs(det0-1) > P.DET_TOL
 continue;
 end
 sv0 = svd(M0);
 log_S0 = log(sv0(1)); % LOGARITHMIC: compare with P.S_THR = log(2)
 xN0 = xyN0w(1); yN0 = xyN0w(2);
 center_is_low = (log_S0 <= P.S_THR);
 agree_low = 0; agree_high = 0;
 for ii = 1:size(OFFS,1)
 dy = OFFS(ii,1); dx = OFFS(ii,2);
 yy = mod(y0j + dy*pitch_y, H);
 xx = mod(x0j + dx*pitch_x, W);
 if dy == 0 && dx == 0
 log_Si = log_S0;
 else
 [Mi_raw,~] = monodromy_fd_vert(yy, xx, t0, Nwin, ...
 dp_x_hist, Tau, H, W, row0, 1e-3);
 [Mi, di] = symplectify2x2(Mi_raw, P.DET_TOL);
 if isempty(Mi) || ~isfinite(di) || abs(di-1) > P.DET_TOL
 log_Si = NaN;
 else
 svi = svd(Mi);
 log_Si = log(svi(1));
 end
 end
 if isfinite(log_Si)
 if log_Si <= P.S_THR, agree_low = agree_low + 1;
 else, agree_high = agree_high + 1;
 end
 end
 end % neighbourhood loop
 if P.DEPOSIT_AT_FINAL
 y_dep = yN0; x_dep = xN0;
 else
 y_dep = y0j; x_dep = x0j;
 end
 iy_ = mod(floor(y_dep), H) + 1;
 ix_ = mod(floor(x_dep), W) + 1;
 if (agree_low >= agree_needed) && (~P.CENTER_MUST_BE_GOOD || center_is_low)
 pass_low(iy_,ix_) = true;
 logS_low_pass(iy_,ix_) = log_S0;
 end
 if (agree_high >= agree_needed) && (~P.CENTER_MUST_BE_GOOD || ~center_is_low)
 pass_high(iy_,ix_) = true;
 logS_high_pass(iy_,ix_) = log_S0;
 end
 end % probe loop
 low_votes = low_votes + double(pass_low);
 high_votes = high_votes + double(pass_high);
 low_logS = low_logS + logS_low_pass;
 high_logS = high_logS + logS_high_pass;
 low_count = low_count + double(pass_low);
 high_count = high_count + double(pass_high);
 end % t0 loop
 low_density = low_votes / max(1, total_passes);
 high_density = high_votes / max(1, total_passes);
 keep_low = (low_density >= P.KEEP_FRAC);
 keep_high = (high_density >= P.KEEP_FRAC);
 [iyL, ixL] = find(keep_low);
 [iyH, ixH] = find(keep_high);
 xyLow = [ixL, iyL];
 xyHigh = [ixH, iyH];
 % Average log(s1) per dot for colour coding
 cnt_L = max(low_count(keep_low), 1);
 cnt_H = max(high_count(keep_high), 1);
 log_s1_low = low_logS(keep_low) ./ cnt_L(:);
 log_s1_high = high_logS(keep_high)./ cnt_H(:);
 stats = struct('n_low', size(xyLow,1), 'n_high', size(xyHigh,1), ...
 'passes', total_passes);
end
