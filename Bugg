function [nBlobs, areas] = blob_stats_any(BW, conn)
%BLOB_STATS_ANY Count connected components and return area of each.
%
% BW : 2-D logical array.
% conn : connectivity (4 or 8).
% nBlobs : number of connected components.
% areas : vector of pixel areas (one entry per component).
%
% Uses bwconncomp from Image Processing Toolbox if available; otherwise
% falls back to the built-in BFS implementation bfs_CC.
 BW = logical(BW);
 if nargin < 2, conn = 4; end
 if exist('bwconncomp','file') == 2
 CC = bwconncomp(BW, conn);
 nBlobs = CC.NumObjects;
 areas = cellfun(@numel, CC.PixelIdxList);
 else
 CC = bfs_CC(BW, conn);
 nBlobs = numel(CC);
 areas = cellfun(@numel, CC);
 end
end
function CC = get_CC_full(BW, conn)
%GET_CC_FULL Return full linear-index lists for each connected component.
%
% BW : 2-D logical array.
% conn : connectivity (4 or 8).
% CC : cell array; CC{k} is the vector of linear pixel indices
% belonging to the k-th connected component.
 BW = logical(BW);
 if exist('bwconncomp','file') == 2
 C = bwconncomp(BW, conn);
 CC = C.PixelIdxList;
 else
 CC = bfs_CC(BW, conn);
 end
end
function CC = bfs_CC(BW, conn)
%BFS_CC BFS-based connected-component labeller (no toolbox required).
%
% BW : 2-D logical [H x W].
% conn : 4 or 8.
% CC : cell array of double vectors of linear pixel indices.
%
% Uses a pre-allocated stack for BFS. Stack grows by 4096 entries as
% needed. Handles images up to ~4M pixels without significant overhead.
 [H, W] = size(BW);
 vis = false(H, W);
 CC = {};
 for r = 1:H
 for c = 1:W
 if ~BW(r,c) || vis(r,c), continue; end
 stack = zeros(4096, 1, 'uint32');
 top = 1;
 stack(1) = uint32(r + (c-1)*H);
 vis(r,c) = true;
 members = zeros(0, 1, 'uint32');
 while top > 0
 idx = double(stack(top)); top = top - 1;
 members(end+1,1) = uint32(idx); %#ok<AGROW>
 rr = mod(idx-1, H) + 1;
 cc_ = floor((idx-1)/H) + 1;
 % 4-connected neighbours
 nbrs4 = [rr-1,cc_; rr+1,cc_; rr,cc_-1; rr,cc_+1];
 ok4 = nbrs4(:,1)>=1 & nbrs4(:,1)<=H & ...
 nbrs4(:,2)>=1 & nbrs4(:,2)<=W;
 nbrs = nbrs4(ok4,:);
 if conn == 8
 nbrsd = [rr-1,cc_-1; rr-1,cc_+1; rr+1,cc_-1; rr+1,cc_+1];
 okd = nbrsd(:,1)>=1 & nbrsd(:,1)<=H & ...
 nbrsd(:,2)>=1 & nbrsd(:,2)<=W;
 nbrs = [nbrs; nbrsd(okd,:)]; %#ok<AGROW>
 end
 for ni = 1:size(nbrs,1)
 nr_ = nbrs(ni,1); nc_ = nbrs(ni,2);
 if BW(nr_,nc_) && ~vis(nr_,nc_)
 vis(nr_,nc_) = true;
 top = top + 1;
 if top > numel(stack), stack(end+4096) = 0; end
 stack(top) = uint32(nr_ + (nc_-1)*H);
 end
 end
 end % BFS while
 CC{end+1} = double(members); %#ok<AGROW>
 end
 end
end
function perim = compute_perimeter(BW)
%COMPUTE_PERIMETER Count 4-connected boundary pixels as a perimeter estimate.
%
% BW : 2-D logical array.
% perim : number of foreground pixels that have at least one 4-connected
% background neighbour. This approximates the true perimeter.
%
% Implemented without toolboxes using padding and logical operations.
 BW = logical(BW);
 [H, W] = size(BW);
 Pad = false(H+2, W+2);
 Pad(2:end-1, 2:end-1) = BW;
 % A pixel is interior iff all 4 N/S/E/W neighbours are foreground
 interior = Pad(2:end-1, 2:end-1) & ...
 Pad(1:end-2, 2:end-1) & ...
 Pad(3:end, 2:end-1) & ...
 Pad(2:end-1, 1:end-2) & ...
 Pad(2:end-1, 3:end);
 perim = nnz(BW) - nnz(interior);
end
