function cmap = diverging_bwr(n, center_frac)
%DIVERGING_BWR Create a blue-white-red diverging colourmap.
%
% n : number of colourmap entries (default 256).
% center_frac : fractional position of the white (neutral) colour in [0,1].
% center_frac = 0.5 gives a symmetric colourmap.
% center_frac = log(2)/log(6) ~ 0.387 places white at s=2
% when caxis = [0, log(6)].
% cmap : [n x 3] RGB colourmap array.
%
% The blue half goes from a deep navy-blue (at 0) to white (at center).
% The red half goes from white (at center) to a deep red (at 1).
 if nargin < 1, n = 256; end
 if nargin < 2, center_frac = 0.5; end
 n_lo = max(2, round(center_frac * n));
 n_hi = max(2, n - n_lo);
 % Blue half: deep navy -> white
 t_lo = linspace(0, 1, n_lo)';
 r_lo = t_lo * 1.00 + (1-t_lo) * 0.05;
 g_lo = t_lo * 1.00 + (1-t_lo) * 0.10;
 b_lo = t_lo * 1.00 + (1-t_lo) * 0.75;
 % Red half: white -> deep red
 t_hi = linspace(0, 1, n_hi)';
 r_hi = t_hi * 0.75 + (1-t_hi) * 1.00;
 g_hi = t_hi * 0.02 + (1-t_hi) * 1.00;
 b_hi = t_hi * 0.02 + (1-t_hi) * 1.00;
 cmap = [r_lo, g_lo, b_lo; r_hi, g_hi, b_hi];
end
