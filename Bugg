%% SECTION K — EXTENDED BLOB SHAPE ANALYSIS AND MORPHOLOGY
%%
%% This section performs deeper morphological analysis on each blob:
%% - Distance-transform based analysis (max inscribed radius)
%% - Skeleton approximation via iterative erosion
%% - Boundary roughness / tortuosity
%% - Per-blob log(s1) radial profile from blob centroid
%% - Comparison: blob shape vs its internal stretch distribution
%%
%% FIGURES:
%% Fig 7020 : Blob distance transform — max inscribed circle overlay
%% Fig 7021 : Per-blob internal log(s1) histograms (sub-panels)
%% Fig 7022 : Blob boundary roughness vs area scatter
%% Fig 7023 : Internal log(s1) std vs compactness scatter
%% Fig 7024 : Per-blob mean signed deviation ranked bar chart
%% Fig 7025 : Blob internal radial profile (from centroid) of log(s1)
%% ========================================================================
fprintf('\n========================================\n');
fprintf(' Section K: Extended blob morphology ...\n');
fprintf('========================================\n\n');
% ---- Compute distance transform for each blob ----
% The distance transform assigns each interior pixel the distance to
% the nearest boundary pixel. The maximum of this gives the radius
% of the largest inscribed circle — a measure of blob "thickness".
blob_max_insc_r = zeros(nF,1);
blob_mean_dist = zeros(nF,1);
blob_perim_len = zeros(nF,1);
blob_tortuosity = zeros(nF,1); % perimeter / (2*pi*r_eq)
fprintf(' Computing distance transforms and morphological metrics ...\n');
for k = 1:nF
 BW_k = false(H_im, W_im);
 BW_k(CC_sorted{k}) = true;
 % Simple distance transform: for each pixel, find min distance
 % to any boundary pixel (4-connected boundary).
 % Efficient approach: use erosion layers.
 dist_k = zeros(H_im, W_im);
 eroded = BW_k;
 layer = 0;
 while any(eroded(:))
 layer = layer + 1;
 % Erode by 1 pixel (4-connected)
 eroded_new = eroded;
 eroded_new(1:end-1,:) = eroded_new(1:end-1,:) & eroded(2:end,:);
 eroded_new(2:end,:) = eroded_new(2:end,:) & eroded(1:end-1,:);
 eroded_new(:,1:end-1) = eroded_new(:,1:end-1) & eroded(:,2:end);
 eroded_new(:,2:end) = eroded_new(:,2:end) & eroded(:,1:end-1);
 newly_removed = eroded & ~eroded_new;
 dist_k(newly_removed) = layer;
 eroded = eroded_new;
 if layer > 500, break; end % safety limit
 end
 % Remaining core pixels
 if any(eroded(:))
 dist_k(eroded) = layer + 1;
 end
 dist_vals = dist_k(BW_k);
 blob_max_insc_r(k) = max(dist_vals);
 blob_mean_dist(k) = mean(dist_vals);
 blob_perim_len(k) = compute_perimeter(BW_k);
 if blob_r_eq(k) > 0
 blob_tortuosity(k) = blob_perim_len(k) / (2*pi*blob_r_eq(k));
 else
 blob_tortuosity(k) = NaN;
 end
end
