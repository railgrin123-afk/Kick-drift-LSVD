blob_xmin = zeros(nF,1); blob_xmax = zeros(nF,1);
blob_ymin = zeros(nF,1); blob_ymax = zeros(nF,1);
blob_r_eq = zeros(nF,1);
blob_compact = zeros(nF,1);
blob_eccen = zeros(nF,1); % eccentricity from inertia tensor
blob_orient = zeros(nF,1); % major-axis orientation (degrees)
blob_aspect = zeros(nF,1); % aspect ratio major/minor
blob_solidity = zeros(nF,1); % area / convex-hull area
blob_mean_logs1 = zeros(nF,1);
blob_min_logs1 = zeros(nF,1);
blob_max_logs1 = zeros(nF,1);
blob_std_logs1 = zeros(nF,1);
blob_mean_ftle = zeros(nF,1);
blob_mean_theta = zeros(nF,1);
blob_std_theta = zeros(nF,1);
blob_mean_delta = zeros(nF,1); % mean signed deviation from threshold
fprintf(' Computing per-blob statistics ...\n');
for k = 1:nF
 idx_lin = CC_final{k};
 [ry, rx] = ind2sub([H_im, W_im], idx_lin);
 A = numel(idx_lin);
 % Basic geometry
 blob_area(k) = A;
 blob_frac(k) = A / max(1, tot_valid);
 blob_cx(k) = mean(rx);
 blob_cy(k) = mean(ry);
 blob_xmin(k) = min(rx); blob_xmax(k) = max(rx);
 blob_ymin(k) = min(ry); blob_ymax(k) = max(ry);
 blob_r_eq(k) = sqrt(A / pi);
 % Perimeter-based compactness C = 4*pi*A / P^2
 BW_blob = false(H_im, W_im);
 BW_blob(idx_lin) = true;
 P_peri = compute_perimeter(BW_blob);
 if P_peri > 0
 blob_compact(k) = 4*pi*A / P_peri^2;
 else
 blob_compact(k) = NaN;
 end
 % Inertia tensor -> eccentricity, orientation, aspect ratio
 % I = sum (r - centroid) * (r - centroid)'
 dxv = double(rx) - blob_cx(k);
 dyv = double(ry) - blob_cy(k);
 Ixx = sum(dyv.^2); % moment around x-axis
 Iyy = sum(dxv.^2); % moment around y-axis
 Ixy = -sum(dxv.*dyv);
 % Eigenvalues of inertia matrix
 trace_I = Ixx + Iyy;
 det_I = Ixx*Iyy - Ixy^2;
 disc = max(0, (trace_I/2)^2 - det_I);
 lam1 = trace_I/2 + sqrt(disc); % larger eigenvalue
 lam2 = trace_I/2 - sqrt(disc); % smaller eigenvalue
 lam2 = max(0, lam2);
 % Eccentricity: 0 = circle, 1 = line segment
 if lam1 > 0
 blob_eccen(k) = sqrt(1 - lam2/lam1);
 else
 blob_eccen(k) = 0;
 end
 % Orientation: angle of major axis from horizontal
 blob_orient(k) = 0.5 * atan2d(2*Ixy, Iyy - Ixx);
 % Aspect ratio: ratio of principal moments -> semi-axis ratio = sqrt(lam1/lam2)
 if lam2 > 1e-10
 blob_aspect(k) = sqrt(lam1 / lam2);
 else
 blob_aspect(k) = Inf;
 end
 % Solidity (convex hull area estimate via bounding-box proxy)
 % True convex hull requires toolbox; use simple bounding-box proxy.
 bbox_area = (blob_xmax(k)-blob_xmin(k)+1) * (blob_ymax(k)-blob_ymin(k)+1);
 if bbox_area > 0
 blob_solidity(k) = A / bbox_area;
 else
 blob_solidity(k) = NaN;
 end
 % log(s1) stats within blob
 sv = Sfin(idx_lin);
 blob_mean_logs1(k) = mean(sv);
 blob_min_logs1(k) = min(sv);
 blob_max_logs1(k) = max(sv);
 blob_std_logs1(k) = std(sv);
 blob_mean_ftle(k) = mean(sv) * FTLE_norm_fin;
 blob_mean_delta(k) = mean(sv) - SParams.S_THR; % signed deviation
 % Rotation angle stats (circular statistics)
 if ~isempty(Stheta_fin)
 th = Stheta_fin(idx_lin);
 blob_mean_theta(k) = atan2d(mean(sind(th*180/pi)), mean(cosd(th*180/pi)));
 blob_std_theta(k) = std(th) * 180/pi;
 end
 if mod(k,10)==0 || k==nF
 fprintf(' Processed %d / %d blobs ...\n', k, nF);
 end
end
