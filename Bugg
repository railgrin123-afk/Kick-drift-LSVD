%% ========================================================================
%% SECTION E — FINAL FULL-RESOLUTION BLOB ANALYSIS
%%
%% After all cycles, run connected-component analysis at FULL image
%% resolution on the final log(s1) field. Compute comprehensive shape
%% descriptors for each blob.
%%
%% Per-blob statistics:
%% blob_area : pixel count
%% blob_frac : fraction of total valid S-field pixels
%% blob_cx/cy : centroid in (col, row) image coordinates
%% blob_xmin/xmax/ymin/ymax : bounding box
%% blob_r_eq : equivalent radius r_eq = sqrt(A / pi)
%% blob_compact : compactness C = 4*pi*A / P^2 (C=1 for circle)
%% blob_eccen : eccentricity from inertia tensor (0=circle, 1=line)
%% blob_orient : orientation angle of major axis (degrees)
%% blob_aspect : aspect ratio = major_axis / minor_axis
%% blob_solidity : convex hull solidity = A / A_convex
%% blob_mean_logs1: mean log(s1) within blob
%% blob_min_logs1 : minimum log(s1) within blob (most stable point)
%% blob_mean_theta: mean rotation angle theta_R within blob
