%% ========================================================================
%% SECTION O — LYAPUNOV EXPONENT CONVERGENCE ANALYSIS
%%
%% PURPOSE
%% -------
%% For a selection of individual probe points drawn from both the
%% low-stretch (blue) and high-stretch (yellow) regions, this section
%% tracks how the finite-time Lyapunov exponent estimate
%%
%% FTLE(N) = log(s1) / N
%%
%% converges as the number of map cycles N increases from 1 to Nwin.
%% Points in regular (KAM) regions should show FTLE -> 0 slowly,
%% while points in the chaotic sea should saturate quickly at a positive
%% Lyapunov exponent.
%%
%% The monodromy is accumulated cycle-by-cycle at each probe:
%% M_total = M_N * M_{N-1} * ... * M_1
%% and SVD is applied to extract s1 at each step.
%%
%% COLOUR CODING
%% -------------
%% Blue probes : drawn from the final blue (low-stretch) region.
%% Orange probes : drawn from the final yellow (high-stretch) region.
%% Each probe has its own curve on the convergence plot.
%% The s=2 threshold line is shown as a dashed grey horizontal.
%%
%% FIGURES
%% -------
%% Fig 9001 : FTLE(N) vs N for all sampled probes — semi-log y-axis.
%% Fig 9002 : FTLE at final N — histogram for blue vs orange probes.
%% Fig 9003 : Convergence rate — how quickly FTLE stabilises.
%% Defined as 1/(N* such that |FTLE(N*) - FTLE(Nwin)| < 0.05).
%% ========================================================================
fprintf('\n========================================\n');
fprintf(' Section O: Lyapunov exponent convergence ...\n');
fprintf('========================================\n\n');
% ---- Recover geometry from the final S-field ----
% Sfin, valid_fin, low_mask_fin, high_mask_fin must exist from earlier sections.
% If they don't (e.g. section G was skipped), recompute from all_Sfine.
if ~exist('Sfin','var') || ~exist('valid_fin','var')
 warning('Section O: Sfin not found — skipping convergence analysis.');
else
% ---- 1. Sample probe locations from blue and orange regions ----
n_probes_each = 6; % number of probes from each region
[low_rows, low_cols] = find(low_mask_fin & valid_fin);
[hi_rows, hi_cols] = find(high_mask_fin & valid_fin);
% Subsample uniformly with jitter to avoid grid clustering
rng(42); % fixed seed for reproducibility
if numel(low_rows) >= n_probes_each
 idx_lo = round(linspace(1, numel(low_rows), n_probes_each*4));
 idx_lo = idx_lo(randperm(numel(idx_lo), min(n_probes_each, numel(idx_lo))));
 probe_rows_lo = low_rows(idx_lo);
 probe_cols_lo = low_cols(idx_lo);
else
 probe_rows_lo = low_rows;
 probe_cols_lo = low_cols;
end
if numel(hi_rows) >= n_probes_each
 idx_hi = round(linspace(1, numel(hi_rows), n_probes_each*4));
 idx_hi = idx_hi(randperm(numel(idx_hi), min(n_probes_each, numel(idx_hi))));
 probe_rows_hi = hi_rows(idx_hi);
 probe_cols_hi = hi_cols(idx_hi);
else
 probe_rows_hi = hi_rows;
 probe_cols_hi = hi_cols;
end
fprintf(' Probe counts: %d blue, %d yellow\n', ...
 numel(probe_rows_lo), numel(probe_rows_hi));
% ---- 2. For each probe, accumulate monodromy cycle-by-cycle ----
% We iterate from t0=1 forward, multiplying monodromy matrices.
% dp_x_hist stores the kick profile for each cycle.
Nmax = min(cycles, numel(dp_x_hist)); % safety cap
n_lo = numel(probe_rows_lo);
n_hi = numel(probe_rows_hi);
ftle_lo = nan(n_lo, Nmax); % FTLE(N) for blue probes
ftle_hi = nan(n_hi, Nmax); % FTLE(N) for orange probes
eps_fd = 1.0; % finite-difference step for monodromy (pixels)
% ---- Blue probes ----
for ip = 1:n_lo
 y0_ip = probe_rows_lo(ip);
 x0_ip = probe_cols_lo(ip);
 M_acc = eye(2); % accumulated monodromy (product from left)
 for nc = 1:Nmax
 [M_nc, ~] = monodromy_fd_vert(y0_ip, x0_ip, nc, 1, dp_x_hist, ...
 Tau, rows, cols, row0, eps_fd);
 M_acc = M_nc * M_acc; % accumulate: M_total = M_N * ... * M_1
 sv_nc = svd(M_acc);
 s1_nc = max(sv_nc);
 ftle_lo(ip, nc) = log(max(s1_nc, 1)) / nc;
 end
end
% ---- Yellow probes ----
for ip = 1:n_hi
 y0_ip = probe_rows_hi(ip);
 x0_ip = probe_cols_hi(ip);
 M_acc = eye(2);
 for nc = 1:Nmax
 [M_nc, ~] = monodromy_fd_vert(y0_ip, x0_ip, nc, 1, dp_x_hist, ...
 Tau, rows, cols, row0, eps_fd);
 M_acc = M_nc * M_acc;
 sv_nc = svd(M_acc);
 s1_nc = max(sv_nc);
 ftle_hi(ip, nc) = log(max(s1_nc, 1)) / nc;
 end
end
fprintf(' Monodromy accumulation complete.\n');
% ---- Fig 9001: FTLE(N) convergence curves ----
figure(9001); clf;
set(gcf,'Color','w','Position',[80 80 920 540], ...
 'Name','FTLE convergence: log(s_1)/N vs number of cycles N');
hold on;
Nvec = 1:Nmax;
% Plot blue probe curves
for ip = 1:n_lo
 plot(Nvec, ftle_lo(ip,:), '-o', ...
 'Color', [0.15 0.35 0.85], 'LineWidth', 1.4, ...
 'MarkerSize', 4, 'MarkerFaceColor', [0.15 0.35 0.85], ...
 'HandleVisibility', 'off');
end
% Plot yellow probe curves
for ip = 1:n_hi
 plot(Nvec, ftle_hi(ip,:), '-s', ...
 'Color', [0.9 0.45 0.05], 'LineWidth', 1.4, ...
 'MarkerSize', 4, 'MarkerFaceColor', [0.9 0.45 0.05], ...
 'HandleVisibility', 'off');
end
% Threshold line at log(2)/Nmax (FTLE = log(s=2)/N_total)
yline(log(SParams.S_THR_LIN)/Nmax, '--', ...
 sprintf('FTLE threshold (s=%g over %d cycles)', ...
 SParams.S_THR_LIN, Nmax), ...
 'Color',[0.4 0.4 0.4],'LineWidth',1.8,'FontSize',9, ...
 'LabelHorizontalAlignment','right');
% Dummy handles for legend
hLo = plot(nan, nan, 'b-o', 'LineWidth', 1.4, 'MarkerSize', 5, ...
 'MarkerFaceColor', [0.15 0.35 0.85], ...
 'DisplayName', sprintf('Blue probes (n=%d)', n_lo));
hHi = plot(nan, nan, '-s', 'Color',[0.9 0.45 0.05], 'LineWidth', 1.4, ...
 'MarkerSize', 5, 'MarkerFaceColor', [0.9 0.45 0.05], ...
 'DisplayName', sprintf('Yellow probes (n=%d)', n_hi));
legend([hLo, hHi], 'Location','northeast','FontSize',10);
grid on;
xlabel('Number of map cycles N','FontSize',12);
ylabel('FTLE(N) = log(s_1) / N (per cycle)','FontSize',12);
title({'Finite-Time Lyapunov Exponent convergence: FTLE(N) vs N'; ...
 'Blue curves flatten towards 0 (regular); Orange saturate quickly (chaotic)'}, ...
 'FontSize',10,'FontWeight','bold');
xlim([1 Nmax]);
% Annotate final FTLE values on right margin
for ip = 1:n_lo
 text(Nmax + 0.05, ftle_lo(ip,Nmax), ...
 sprintf('b%.0f: %.3f', ip, ftle_lo(ip,Nmax)), ...
 'FontSize',6,'Color',[0.1 0.3 0.8], ...
 'HorizontalAlignment','left','VerticalAlignment','middle');
end
for ip = 1:n_hi
 text(Nmax + 0.05, ftle_hi(ip,Nmax), ...
 sprintf('y%.0f: %.3f', ip, ftle_hi(ip,Nmax)), ...
 'FontSize',6,'Color',[0.8 0.35 0.0], ...
 'HorizontalAlignment','left','VerticalAlignment','middle');
end
drawnow;
fprintf(' Fig 9001: FTLE convergence curves drawn.\n');
% ---- Fig 9002: Histogram of final FTLE for blue vs orange ----
figure(9002); clf;
set(gcf,'Color','w','Position',[100 80 780 460], ...
 'Name','Distribution of final FTLE: blue vs yellow probes');
hold on;
ftle_lo_fin = ftle_lo(:, Nmax); % FTLE at maximum cycles — blue
ftle_hi_fin = ftle_hi(:, Nmax); % FTLE at maximum cycles — yellow
all_ftle = [ftle_lo_fin; ftle_hi_fin];
bin_edges_ftle = linspace(min(all_ftle)-0.02, max(all_ftle)+0.02, 12);
histogram(ftle_lo_fin, bin_edges_ftle, ...
 'FaceColor',[0.2 0.4 0.9],'FaceAlpha',0.7,'EdgeColor','w', ...
 'DisplayName',sprintf('Blue probes (mean=%.3f)', mean(ftle_lo_fin)));
histogram(ftle_hi_fin, bin_edges_ftle, ...
 'FaceColor',[0.9 0.45 0.05],'FaceAlpha',0.7,'EdgeColor','w', ...
 'DisplayName',sprintf('Yellow probes (mean=%.3f)', mean(ftle_hi_fin)));
xline(log(SParams.S_THR_LIN)/Nmax, 'k--', ...
 sprintf('s=%g threshold', SParams.S_THR_LIN), ...
 'LineWidth',1.5,'FontSize',9,'LabelVerticalAlignment','top');
legend('Location','northwest','FontSize',10);
grid on;
xlabel('Final FTLE = log(s_1) / N_{max} (per cycle)','FontSize',12);
ylabel('Probe count','FontSize',12);
title({'Final FTLE distribution: blue (stable) vs yellow (chaotic) probes'; ...
 'Clear separation indicates strong phase-space structure'}, ...
 'FontSize',10,'FontWeight','bold');
% Print mean ± std for each group
fprintf(' Blue probes — final FTLE: mean=%.4f std=%.4f\n', ...
 mean(ftle_lo_fin), std(ftle_lo_fin));
fprintf(' Yellow probes — final FTLE: mean=%.4f std=%.4f\n', ...
 mean(ftle_hi_fin), std(ftle_hi_fin));
drawnow;
fprintf(' Fig 9002: FTLE final-value histogram drawn.\n');
% ---- Fig 9003: Convergence rate ----
% Convergence rate defined as the first N* such that
% |FTLE(N*) - FTLE(Nmax)| / FTLE(Nmax) < 5%
% (i.e. the FTLE is within 5% of its final value).
% For probes with FTLE_final < 0.01, convergence is trivial.
figure(9003); clf;
set(gcf,'Color','w','Position',[120 80 800 440], ...
 'Name','FTLE convergence speed: cycles to reach 5% of final value');
conv_N_lo = nan(n_lo,1);
conv_N_hi = nan(n_hi,1);
for ip = 1:n_lo
 fv = ftle_lo_fin(ip);
 if abs(fv) < 0.005, conv_N_lo(ip) = 1; continue; end
 for nc = 1:Nmax
 if abs(ftle_lo(ip,nc) - fv) / (abs(fv)+1e-9) < 0.05
 conv_N_lo(ip) = nc;
 break;
 end
 end
 if isnan(conv_N_lo(ip)), conv_N_lo(ip) = Nmax; end
end
for ip = 1:n_hi
 fv = ftle_hi_fin(ip);
 if abs(fv) < 0.005, conv_N_hi(ip) = 1; continue; end
 for nc = 1:Nmax
 if abs(ftle_hi(ip,nc) - fv) / (abs(fv)+1e-9) < 0.05
 conv_N_hi(ip) = nc;
 break;
 end
 end
 if isnan(conv_N_hi(ip)), conv_N_hi(ip) = Nmax; end
end
hold on;
scatter(1:n_lo, conv_N_lo, 80, ftle_lo_fin, 'o', 'LineWidth', 1.5, ...
 'MarkerEdgeColor','none');
scatter((1:n_hi)+n_lo+1, conv_N_hi, 80, ftle_hi_fin, 's', 'LineWidth', 1.5, ...
 'MarkerEdgeColor','none');
colormap(gca, diverging_bwr(256, center_frac));
cb_9003 = colorbar;
cb_9003.Label.String = 'Final FTLE value (per cycle)';
cb_9003.Label.FontSize = 10;
% Annotate group separators
xline(n_lo + 0.5, 'k:', 'LineWidth', 1.0);
text(n_lo/2, Nmax*0.95, 'BLUE probes', 'FontSize',9, ...
 'Color',[0.1 0.3 0.8],'HorizontalAlignment','center');
text(n_lo+1+(n_hi)/2, Nmax*0.95, 'YELLOW probes', 'FontSize',9, ...
 'Color',[0.8 0.35 0],'HorizontalAlignment','center');
grid on;
xlabel('Probe index (blue first, then yellow)','FontSize',12);
ylabel('N* = cycles to reach 5% of final FTLE','FontSize',12);
title({'FTLE convergence speed per probe'; ...
 'Small N* = rapid saturation (chaotic); Large N* = slow convergence (regular)'}, ...
 'FontSize',10,'FontWeight','bold');
ylim([0 Nmax+1]);
drawnow;
fprintf(' Fig 9003: convergence-speed scatter.\n');
fprintf('\n Section O complete.\n\n');
