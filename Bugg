%% ========================================================================
%% HELPER FUNCTION: ternary_str
%% Returns str_true if condition is true, str_false otherwise.
%% Used for concise conditional string formatting in the report.
%% ========================================================================
function s = ternary_str(cond, str_true, str_false)
 if cond
 s = str_true;
 else
 s = str_false;
 end
end
