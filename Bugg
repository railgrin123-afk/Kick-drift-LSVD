p_edges = linspace(SParams.S_CLIP_MIN, SParams.S_CLIP_MAX, n_pbins+1);
p_ctrs = (p_edges(1:end-1)+p_edges(2:end))/2;
cond_mean = nan(n_pbins,1);
cond_std = nan(n_pbins,1);
cond_cnt = zeros(n_pbins,1);
for pb = 1:n_pbins
 in_pb = (Slog_flat >= p_edges(pb)) & (Slog_flat < p_edges(pb+1));
 if nnz(in_pb) > 5
 vals_pb = Stheta_deg(in_pb);
 cond_cnt(pb) = nnz(in_pb);
 cond_mean(pb) = mean(vals_pb);
 cond_std(pb) = std(vals_pb);
 end
end
ok_p = isfinite(cond_mean);
hold on;
% ±1 std band
fill([p_ctrs(ok_p)', fliplr(p_ctrs(ok_p)')], ...
 [(cond_mean(ok_p)-cond_std(ok_p))', fliplr((cond_mean(ok_p)+cond_std(ok_p))')], ...
 [0.7 0.7 0.9],'EdgeColor','none','FaceAlpha',0.5, ...
 'DisplayName','±1 std of \theta_R');
plot(p_ctrs(ok_p), cond_mean(ok_p), 'b-o', 'LineWidth', 1.8, ...
 'MarkerSize',5, 'MarkerFaceColor','b', ...
 'DisplayName','Conditional mean \langle\theta_R | log s_1\rangle');
xline(SParams.S_THR, 'k--', sprintf('s=%g', SParams.S_THR_LIN), ...
 'LineWidth',1.8,'FontSize',9,'LabelVerticalAlignment','top');
yline(0, 'k-', '\theta_R=0', 'LineWidth',0.8,'FontSize',8);
% Annotate pixel counts above each point
for pb = 1:n_pbins
 if cond_cnt(pb) > 30 && ok_p(pb)
 text(p_ctrs(pb), cond_mean(pb)+cond_std(pb)+2, ...
 sprintf('n=%d', cond_cnt(pb)), 'FontSize',5, ...
 'HorizontalAlignment','center','Color',[0.4 0.4 0.4]);
 end
end
grid on;
legend('Location','northwest','FontSize',10);
xlabel('log(s_1) — binned stretch','FontSize',12);
ylabel('Conditional mean \langle\theta_R | log s_1\rangle (degrees)','FontSize',12);
title({'Conditional mean rotation angle vs logarithmic stretch'; ...
 'If rotation is independent of stretch, curve should be flat near 0'}, ...
 'FontSize',10,'FontWeight','bold');
