function set_log_colorbar(cb, log_min, log_max, s_ticks_lin)
%SET_LOG_COLORBAR Label a colourbar in linear s-units when field is log(s1).
%
% cb : colorbar handle.
% log_min : minimum log(s1) value (= caxis lower bound).
% log_max : maximum log(s1) value (= caxis upper bound).
% s_ticks_lin : vector of linear s values at which to place ticks.
% Ticks outside [log_min, log_max] are silently dropped.
%
% The colourbar tick positions are set to log(s_ticks_lin) and the labels
% show the original linear s values, so the colourbar is intuitive even
% though the field is in log space.
 valid_mask = (log(s_ticks_lin) >= log_min) & ...
 (log(s_ticks_lin) <= log_max);
 s_valid = s_ticks_lin(valid_mask);
 tick_pos = log(s_valid);
 tick_lbls = arrayfun(@(v) sprintf('s=%.2g', v), s_valid, ...
 'UniformOutput', false);
 cb.Ticks = tick_pos;
 cb.TickLabels = tick_lbls;
end
function label_contours_linear_s(Slog, log_levels, s_lin_vals, font_size)
%LABEL_CONTOURS_LINEAR_S Place text labels at each contour level.
%
% Slog : 2-D log(s1) field.
% log_levels : vector of log(s1) values at which contours were drawn.
% s_lin_vals : corresponding linear s values (for display in labels).
% font_size : label font size (default 7).
%
% For each contour level, finds pixels within 0.03 log-units of the
% level and places the label at the median (x,y) position, avoiding
% the image border.
 if nargin < 4, font_size = 7; end
 [H_, W_] = size(Slog);
 for k = 1:numel(log_levels)
 lv = log_levels(k);
 slv = s_lin_vals(k);
 near = abs(Slog - lv) < 0.04;
 [rr, cc_] = find(near);
 if isempty(rr), continue; end
 mx = median(cc_);
 my = median(rr);
 % Avoid placing labels within 20 px of the image border
 if mx < 20 || mx > W_-20 || my < 20 || my > H_-20, continue; end
 is_thr = abs(slv - 2.0) < 0.01;
 fw_ = 'normal'; fc_ = [0.2 0.2 0.2];
 if is_thr, fw_ = 'bold'; fc_ = [0 0 0]; end
 text(mx, my, sprintf('s=%.2g', slv), ...
 'Color', fc_, 'FontSize', font_size, 'FontWeight', fw_, ...
 'HorizontalAlignment','center','VerticalAlignment','middle', ...
 'BackgroundColor',[1 1 1 0.60],'Margin',1.5);
 end
end
function clabel_linear_s(Slog, delta_val, S_THR, label_str)
%CLABEL_LINEAR_S Place a single text label for a signed-deviation contour.
%
% Slog : 2-D signed-deviation field (= log(s1) - log(2)).
% delta_val : the specific delta value whose contour to label.
% S_THR : log threshold (used to convert delta -> s).
% label_str : label text string.
 near = abs(Slog - delta_val) < 0.04;
 [rr, cc_] = find(near);
 if isempty(rr), return; end
 [H_, W_] = size(Slog);
 mx = median(cc_); my = median(rr);
 if mx<20||mx>W_-20||my<20||my>H_-20, return; end
 text(mx, my, label_str, 'FontSize',6,'Color',[0.2 0.2 0.2], ...
 'HorizontalAlignment','center','VerticalAlignment','middle', ...
 'BackgroundColor',[1 1 1 0.55],'Margin',1);
end
%% ========================================================================
%% SECTION G — SPATIAL STATISTICS AND RADIAL ANALYSIS
%%
%% Analyses how the log(s1) field varies with distance from the centre
%% of the image (the p=0 reference line). Useful for understanding
%% whether coherent structures prefer the centre or edges.
%%
%% Also computes the 2-D spatial autocorrelation of the binary blue mask
%% to quantify the typical size scale and spatial extent of low-stretch
%% patches.
%%
%% FIGURES:
%% Fig 8001 : Radial profile of log(s1) — mean + percentile bands
%% Fig 8002 : 2-D autocorrelation of the blue (low-stretch) mask
%% Fig 8003 : 1-D azimuthally-averaged autocorrelation + e-folding radius
%% Fig 8004 : Band-by-band (horizontal strips) mean log(s1) profile
%% Fig 8005 : Joint histogram of log(s1) vs distance from row0
%% ========================================================================
fprintf('========================================\n');
fprintf(' Section G: Spatial statistics ...\n');
fprintf('========================================\n\n');
% ---- Radial distance field (distance from row0 in pixel units) ----
[rGrid, cGrid] = meshgrid(1:W_im, 1:H_im);
dist_from_row0 = abs(cGrid - row0); % vertical distance from p=0 line
dist_from_ctr = sqrt((cGrid - H_im/2).^2 + (rGrid - W_im/2).^2);
% ---- Fig 8001: Radial profile of log(s1) from the p=0 line ----
% Bin pixels by their vertical distance from row0, then plot mean and
% percentile bands of log(s1) in each distance bin.
figure(8001); clf;
set(gcf,'Color','w','Position',[100 80 900 560], ...
 'Name','Radial profile of log(s1) from p=0 line');
n_dist_bins = 40;
dist_edges = linspace(0, max(dist_from_row0(:)), n_dist_bins+1);
dist_centers = (dist_edges(1:end-1) + dist_edges(2:end)) / 2;
rad_mean = nan(n_dist_bins,1);
rad_p10 = nan(n_dist_bins,1);
rad_p25 = nan(n_dist_bins,1);
rad_p50 = nan(n_dist_bins,1);
rad_p75 = nan(n_dist_bins,1);
rad_p90 = nan(n_dist_bins,1);
rad_frac_blue= nan(n_dist_bins,1);
for kb = 1:n_dist_bins
 in_bin = valid_fin & (dist_from_row0 >= dist_edges(kb)) & ...
 (dist_from_row0 < dist_edges(kb+1));
 vals = Sfin(in_bin);
 if numel(vals) > 5
 rad_mean(kb) = mean(vals);
 pr = prctile(vals, [10 25 50 75 90]);
 rad_p10(kb) = pr(1); rad_p25(kb) = pr(2);
 rad_p50(kb) = pr(3); rad_p75(kb) = pr(4);
 rad_p90(kb) = pr(5);
 rad_frac_blue(kb) = nnz(vals <= SParams.S_THR) / numel(vals);
 end
end
tiledlayout(1,2,'TileSpacing','compact','Padding','compact');
ax_r1 = nexttile;
hold(ax_r1,'on');
fill([dist_centers', fliplr(dist_centers')], ...
 [rad_p10', fliplr(rad_p90')], ...
 [0.7 0.7 0.95],'EdgeColor','none','FaceAlpha',0.5, ...
 'DisplayName','p10-p90 band');
fill([dist_centers', fliplr(dist_centers')], ...
 [rad_p25', fliplr(rad_p75')], ...
